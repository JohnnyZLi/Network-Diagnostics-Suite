<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>NetworkDiagnostics.Core</AssemblyName>
    <RootNamespace>NetworkDeepProbe</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../DeepProbe/Diagnostics/**/*.cs" LinkBase="Diagnostics" />
    <Compile Include="../DeepProbe/Models/**/*.cs" LinkBase="Models" />
    <Compile Include="../DeepProbe/Planning/**/*.cs" LinkBase="Planning" />
    <EmbeddedResource Include="../../contracts/test-profiles.v1.json" LogicalName="NetworkDiagnostics.Contracts.test-profiles.v1.json" />
    <EmbeddedResource Include="../../contracts/diagnostic-rules.v1.json" LogicalName="NetworkDiagnostics.Contracts.diagnostic-rules.v1.json" />
    <InternalsVisibleTo Include="NetworkDeepProbe" />
    <InternalsVisibleTo Include="NetworkDeepProbe.Tests" />
  </ItemGroup>
</Project>
