<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS8600;CS8604</WarningsNotAsErrors>
    <AssemblyName>NetworkDiagnosticsDesktop</AssemblyName>
    <RootNamespace>NetworkDiagnostics.Desktop</RootNamespace>
    <RuntimeIdentifiers>win-x64;osx-arm64;osx-x64;linux-x64;linux-arm64</RuntimeIdentifiers>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <InvariantGlobalization>false</InvariantGlobalization>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Photino/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Photino.NET" Version="4.0.16" />
    <PackageReference Include="Photino.NET.Server" Version="4.0.12" />
    <ProjectReference Include="../NetworkDiagnostics.Core/NetworkDiagnostics.Core.csproj" />
  </ItemGroup>

  <Target Name="BuildDesktopFrontend" BeforeTargets="BeforeBuild">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/../.." Command="npm run desktop:web:build" />
  </Target>

  <Target Name="CopyDesktopFrontendToOutput" AfterTargets="Build">
    <ItemGroup>
      <_DesktopFrontendFiles Include="$(MSBuildProjectDirectory)/frontend/dist/**/*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_DesktopFrontendFiles)"
      DestinationFiles="@(_DesktopFrontendFiles->'$(OutDir)wwwroot/%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyDesktopFrontendToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_DesktopPublishFrontendFiles Include="$(MSBuildProjectDirectory)/frontend/dist/**/*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_DesktopPublishFrontendFiles)"
      DestinationFiles="@(_DesktopPublishFrontendFiles->'$(PublishDir)wwwroot/%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
