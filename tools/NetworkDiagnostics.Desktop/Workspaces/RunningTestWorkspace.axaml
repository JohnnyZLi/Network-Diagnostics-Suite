<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NetworkDiagnostics.Desktop.Workspaces.RunningTestWorkspace"
             Background="{DynamicResource AppCanvasBrush}"
             Foreground="{DynamicResource AppTextBrush}"
             FontFamily="Inter">
  <Grid RowDefinitions="Auto,*" Margin="30,26,30,30">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="20">
      <StackPanel Spacing="5">
        <TextBlock Classes="eyebrow" Text="ACTIVE DIAGNOSTIC" />
        <TextBlock Name="TitleText" FontSize="29" FontWeight="SemiBold" Text="Running test" />
        <TextBlock Name="SubtitleText" Classes="muted" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>
      <Button Name="StopButton"
              Grid.Column="1"
              Classes="danger"
              Content="Stop test"
              Click="StopClicked"
              VerticalAlignment="Top" />
    </Grid>

    <Grid Grid.Row="1" Margin="0,22,0,0" ColumnDefinitions="1.45*,0.85*" ColumnSpacing="16">
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14">
          <Border Classes="accentSurface" Padding="20">
            <StackPanel Spacing="14">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                <StackPanel Spacing="4">
                  <TextBlock Classes="eyebrow" Text="CURRENT PHASE" />
                  <TextBlock Name="PhaseText" FontSize="22" FontWeight="SemiBold" />
                  <TextBlock Name="DetailText" Classes="secondary" FontSize="12" LineHeight="18" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Name="ProgressText"
                           Grid.Column="1"
                           FontSize="30"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
              </Grid>
              <ProgressBar Name="ProgressBar" Minimum="0" Maximum="100" Height="7" />
            </StackPanel>
          </Border>

          <Border Classes="surface" Padding="0">
            <Grid ColumnDefinitions="*,1,*,1,*">
              <StackPanel Grid.Column="0" Margin="18,16" Spacing="5">
                <TextBlock Classes="eyebrow" Text="LIVE RATE" />
                <TextBlock Name="RateText" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Classes="muted" FontSize="10" Text="Current transfer sample" />
              </StackPanel>
              <Border Grid.Column="1" Width="1" Background="{DynamicResource AppBorderBrush}" />
              <StackPanel Grid.Column="2" Margin="18,16" Spacing="5">
                <TextBlock Classes="eyebrow" Text="LIVE LATENCY" />
                <TextBlock Name="LatencyText" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Classes="muted" FontSize="10" Text="Current responsiveness" />
              </StackPanel>
              <Border Grid.Column="3" Width="1" Background="{DynamicResource AppBorderBrush}" />
              <StackPanel Grid.Column="4" Margin="18,16" Spacing="5">
                <TextBlock Classes="eyebrow" Text="MEASURED" />
                <TextBlock Name="BytesText" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Classes="muted" FontSize="10" Text="Reported payload" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Classes="surface" Padding="18">
            <StackPanel Spacing="12">
              <StackPanel Spacing="3">
                <TextBlock Classes="eyebrow" Text="PHASE TIMELINE" />
                <TextBlock Classes="muted" FontSize="11" Text="Progress through the diagnostic measurement plan." />
              </StackPanel>
              <ItemsControl Name="PhaseItems" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Column="1" Classes="surface" Padding="18">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Classes="eyebrow" Text="LIVE EVIDENCE" />
            <TextBlock FontSize="17" FontWeight="SemiBold" Text="Engine observations" />
            <TextBlock Classes="muted"
                       FontSize="11"
                       LineHeight="17"
                       Text="Newest updates appear first and remain available for this run."
                       TextWrapping="Wrap" />
          </StackPanel>
          <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Name="EventPanel" />
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
