<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NetworkDiagnostics.Desktop.Workspaces.RunningTestWorkspace"
             Background="{DynamicResource AppCanvasBrush}"
             Foreground="{DynamicResource AppTextBrush}"
             FontFamily="Inter">
  <Grid RowDefinitions="Auto,*"
        Margin="34,30,34,34"
        MaxWidth="1380"
        HorizontalAlignment="Stretch">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="22">
      <StackPanel Spacing="5">
        <TextBlock Classes="eyebrow" Text="LIVE DIAGNOSTIC" />
        <TextBlock Name="TitleText" FontSize="30" FontWeight="SemiBold" Text="Running test" />
        <TextBlock Name="SubtitleText" Classes="muted" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>
      <Button Name="StopButton"
              Grid.Column="1"
              Classes="danger"
              Content="Stop diagnostic"
              Click="StopClicked"
              VerticalAlignment="Center" />
    </Grid>

    <Grid Grid.Row="1" Margin="0,22,0,0" ColumnDefinitions="0.92*,1.08*" ColumnSpacing="18">
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16">
          <Border Background="{DynamicResource AppRaisedBrush}"
                  CornerRadius="16"
                  Padding="24">
            <StackPanel Spacing="20" HorizontalAlignment="Stretch">
              <StackPanel HorizontalAlignment="Center" Spacing="6">
                <TextBlock Classes="eyebrow" Text="CURRENT PHASE" HorizontalAlignment="Center" />
                <Border Width="230"
                        Height="230"
                        CornerRadius="115"
                        Background="{DynamicResource AppSelectedBrush}"
                        BorderBrush="{DynamicResource AppAccentBorderBrush}"
                        BorderThickness="1">
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                    <TextBlock Name="ProgressText"
                               FontSize="48"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Name="PhaseText"
                               FontSize="17"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="160" />
                  </StackPanel>
                </Border>
                <TextBlock Name="DetailText"
                           Classes="secondary"
                           FontSize="11"
                           LineHeight="17"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="420" />
              </StackPanel>

              <ProgressBar Name="ProgressBar" Minimum="0" Maximum="100" Height="6" />

              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
                <StackPanel Grid.Column="0" Spacing="4">
                  <TextBlock Classes="eyebrow" Text="RATE" />
                  <TextBlock Name="RateText" FontSize="21" FontWeight="SemiBold" />
                  <TextBlock Classes="muted" FontSize="9" Text="Current transfer" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Classes="eyebrow" Text="LATENCY" />
                  <TextBlock Name="LatencyText" FontSize="21" FontWeight="SemiBold" />
                  <TextBlock Classes="muted" FontSize="9" Text="Current response" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                  <TextBlock Classes="eyebrow" Text="MEASURED" />
                  <TextBlock Name="BytesText" FontSize="21" FontWeight="SemiBold" />
                  <TextBlock Classes="muted" FontSize="9" Text="Reported payload" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <Border Background="{DynamicResource AppRaisedBrush}"
                  CornerRadius="14"
                  Padding="19">
            <StackPanel Spacing="13">
              <StackPanel Spacing="4">
                <TextBlock Classes="eyebrow" Text="MEASUREMENT PLAN" />
                <TextBlock Classes="muted" FontSize="10" Text="Completed, current, and upcoming phases." />
              </StackPanel>
              <ItemsControl Name="PhaseItems" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Column="1"
              Background="{DynamicResource AppRaisedBrush}"
              CornerRadius="16"
              Padding="20">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Classes="eyebrow" Text="LIVE EVIDENCE" />
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Engine observations" />
            <TextBlock Classes="muted"
                       FontSize="10"
                       LineHeight="15"
                       Text="Newest measurements appear first and remain attached to this run."
                       TextWrapping="Wrap" />
          </StackPanel>
          <ScrollViewer Grid.Row="1"
                        Margin="0,15,0,0"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel Name="EventPanel" />
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
