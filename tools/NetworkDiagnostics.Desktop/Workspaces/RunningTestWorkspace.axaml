<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NetworkDiagnostics.Desktop.Workspaces.RunningTestWorkspace"
             Background="{DynamicResource AppCanvasBrush}"
             Foreground="{DynamicResource AppTextBrush}"
             FontFamily="Inter">
  <Grid RowDefinitions="Auto,*"
        Margin="30,24,30,30"
        MaxWidth="1380"
        HorizontalAlignment="Stretch">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="22">
      <StackPanel Spacing="4">
        <TextBlock Classes="eyebrow" Text="LIVE DIAGNOSTIC" />
        <TextBlock Name="TitleText" FontSize="28" FontWeight="SemiBold" Text="Running test" />
        <TextBlock Name="SubtitleText" Classes="muted" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>
      <Button Name="StopButton"
              Grid.Column="1"
              Classes="danger"
              Content="Stop diagnostic"
              Click="StopClicked"
              VerticalAlignment="Center" />
    </Grid>

    <Grid Grid.Row="1" Margin="0,18,0,0" ColumnDefinitions="0.9*,1.1*" ColumnSpacing="18">
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14">
          <Border Background="{DynamicResource AppRaisedBrush}"
                  CornerRadius="14"
                  Padding="20">
            <StackPanel Spacing="16" HorizontalAlignment="Stretch">
              <StackPanel HorizontalAlignment="Center" Spacing="5">
                <TextBlock Classes="eyebrow" Text="CURRENT PHASE" HorizontalAlignment="Center" />
                <Border Width="196"
                        Height="196"
                        CornerRadius="98"
                        Background="{DynamicResource AppSelectedBrush}"
                        BorderBrush="{DynamicResource AppAccentBorderBrush}"
                        BorderThickness="1">
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Name="ProgressText"
                               FontSize="42"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Name="PhaseText"
                               FontSize="15"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="140" />
                  </StackPanel>
                </Border>
                <TextBlock Name="DetailText"
                           Classes="secondary"
                           FontSize="11"
                           LineHeight="16"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="380" />
              </StackPanel>

              <ProgressBar Name="ProgressBar" Minimum="0" Maximum="100" Height="5" />

              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <StackPanel Grid.Column="0" Spacing="3">
                  <TextBlock Classes="eyebrow" Text="RATE" />
                  <TextBlock Name="RateText" FontSize="19" FontWeight="SemiBold" />
                  <TextBlock Classes="muted" FontSize="9" Text="Current transfer" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock Classes="eyebrow" Text="LATENCY" />
                  <TextBlock Name="LatencyText" FontSize="19" FontWeight="SemiBold" />
                  <TextBlock Classes="muted" FontSize="9" Text="Current response" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="3">
                  <TextBlock Classes="eyebrow" Text="MEASURED" />
                  <TextBlock Name="BytesText" FontSize="19" FontWeight="SemiBold" />
                  <TextBlock Classes="muted" FontSize="9" Text="Reported payload" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <Border Background="{DynamicResource AppRaisedBrush}"
                  CornerRadius="14"
                  Padding="17">
            <StackPanel Spacing="11">
              <StackPanel Spacing="3">
                <TextBlock Classes="eyebrow" Text="MEASUREMENT PLAN" />
                <TextBlock Classes="muted" FontSize="10" Text="Completed, current, and upcoming phases." />
              </StackPanel>
              <ItemsControl Name="PhaseItems" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Column="1"
              Background="{DynamicResource AppRaisedBrush}"
              CornerRadius="14"
              Padding="18">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Grid.Row="0" Spacing="3">
            <TextBlock Classes="eyebrow" Text="LIVE EVIDENCE" />
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Engine observations" />
            <TextBlock Classes="muted"
                       FontSize="10"
                       LineHeight="15"
                       Text="Newest measurements appear first and remain attached to this run."
                       TextWrapping="Wrap" />
          </StackPanel>
          <ScrollViewer Grid.Row="1"
                        Margin="0,13,0,0"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel Name="EventPanel" />
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
