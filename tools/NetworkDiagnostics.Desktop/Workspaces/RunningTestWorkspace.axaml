<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NetworkDiagnostics.Desktop.Workspaces.RunningTestWorkspace"
             Background="#111415"
             Foreground="#E9E6E0"
             FontFamily="Inter">
  <UserControl.Styles>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#969C9D" /></Style>
    <Style Selector="TextBlock.eyebrow"><Setter Property="Foreground" Value="#C77E68" /><Setter Property="FontSize" Value="10" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="LetterSpacing" Value="1.5" /></Style>
    <Style Selector="Border.panel"><Setter Property="Background" Value="#171B1C" /><Setter Property="BorderBrush" Value="#303536" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="18" /></Style>
    <Style Selector="Border.phase"><Setter Property="Background" Value="#15191A" /><Setter Property="BorderBrush" Value="#303536" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="12" /></Style>
    <Style Selector="Button.stop"><Setter Property="Background" Value="#2A1D1A" /><Setter Property="Foreground" Value="#F3D8D0" /><Setter Property="BorderBrush" Value="#714235" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="14,9" /></Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*" Margin="28,24,28,28">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="20">
      <StackPanel Spacing="5">
        <TextBlock Classes="eyebrow" Text="ACTIVE DIAGNOSTIC" />
        <TextBlock Name="TitleText" FontSize="28" FontWeight="SemiBold" Text="Running test" />
        <TextBlock Name="SubtitleText" Classes="muted" FontSize="13" TextWrapping="Wrap" />
      </StackPanel>
      <Button Name="StopButton" Grid.Column="1" Classes="stop" Content="Stop test" Click="StopClicked" VerticalAlignment="Top" />
    </Grid>

    <Grid Grid.Row="1" Margin="0,22,0,0" ColumnDefinitions="1.4*,0.9*" ColumnSpacing="18">
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">
          <Border Classes="panel">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3">
                  <TextBlock Name="PhaseText" FontSize="20" FontWeight="SemiBold" />
                  <TextBlock Name="DetailText" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Name="ProgressText" Grid.Column="1" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" />
              </Grid>
              <ProgressBar Name="ProgressBar" Minimum="0" Maximum="100" Height="7" />
            </StackPanel>
          </Border>

          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
            <Border Grid.Column="0" Classes="panel" Padding="14">
              <StackPanel Spacing="5"><TextBlock Classes="eyebrow" Text="LIVE RATE" /><TextBlock Name="RateText" FontSize="22" FontWeight="SemiBold" /><TextBlock Classes="muted" FontSize="11" Text="Current transfer sample" /></StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="panel" Padding="14">
              <StackPanel Spacing="5"><TextBlock Classes="eyebrow" Text="LIVE LATENCY" /><TextBlock Name="LatencyText" FontSize="22" FontWeight="SemiBold" /><TextBlock Classes="muted" FontSize="11" Text="Current responsiveness" /></StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="panel" Padding="14">
              <StackPanel Spacing="5"><TextBlock Classes="eyebrow" Text="MEASURED" /><TextBlock Name="BytesText" FontSize="22" FontWeight="SemiBold" /><TextBlock Classes="muted" FontSize="11" Text="Reported payload" /></StackPanel>
            </Border>
          </Grid>

          <Border Classes="panel">
            <StackPanel Spacing="12">
              <TextBlock Classes="eyebrow" Text="PHASE TIMELINE" />
              <ItemsControl Name="PhaseItems" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Column="1" Classes="panel">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Classes="eyebrow" Text="LIVE EVIDENCE" />
            <TextBlock FontSize="17" FontWeight="SemiBold" Text="What the engine is observing" />
            <TextBlock Classes="muted" FontSize="12" Text="Updates are retained for the duration of this run." TextWrapping="Wrap" />
          </StackPanel>
          <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Name="EventPanel" Spacing="10" />
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>