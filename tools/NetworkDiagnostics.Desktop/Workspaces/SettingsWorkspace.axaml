<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NetworkDiagnostics.Desktop.Workspaces.SettingsWorkspace"
             Background="{DynamicResource AppCanvasBrush}"
             Foreground="{DynamicResource AppTextBrush}"
             FontFamily="Inter">
  <UserControl.Styles>
    <Style Selector="Button.sectionNav">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="13,7" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="10" />
    </Style>
    <Style Selector="Button.sectionNav:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <Style Selector="Button.sectionNav.selected">
      <Setter Property="Background" Value="{DynamicResource AppSelectedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
      <Setter Property="FontSize" Value="10" />
    </Style>
    <Style Selector="Border.settingsCard">
      <Setter Property="Background" Value="{DynamicResource AppRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="18" />
    </Style>
    <Style Selector="Border.settingsStatus">
      <Setter Property="Background" Value="{DynamicResource AppInsetBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="11,8" />
      <Setter Property="Background" Value="{DynamicResource AppInsetBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="11,0" />
      <Setter Property="Background" Value="{DynamicResource AppInsetBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Grid Name="SettingsRootGrid" RowDefinitions="Auto,*">
    <Border Grid.Row="0"
            Background="{DynamicResource AppSidebarBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="22,10">
      <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button Name="GeneralButton" Classes="sectionNav selected" Tag="General" Content="General" Click="SectionClicked" />
          <Button Name="MonitoringButton" Classes="sectionNav" Tag="Monitoring" Content="Monitoring" Click="SectionClicked" />
          <Button Name="MeasurementButton" Classes="sectionNav" Tag="Measurement" Content="Diagnostics" Click="SectionClicked" />
          <Button Name="PrivacyButton" Classes="sectionNav" Tag="Privacy &amp; data" Content="Privacy" Click="SectionClicked" />
          <Button Name="StorageButton" Classes="sectionNav" Tag="Storage" Content="Storage" Click="SectionClicked" />
          <Button Name="DeveloperButton" Classes="sectionNav" Tag="Developer" Content="Developer" Click="SectionClicked" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <Grid Name="SettingsContentContainer"
            Margin="34,28,34,42"
            MaxWidth="1240"
            HorizontalAlignment="Stretch">
        <StackPanel Spacing="20">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
            <StackPanel Spacing="5">
              <TextBlock Name="SectionEyebrowText" Classes="eyebrow" Text="GENERAL" />
              <TextBlock Name="SectionTitleText" FontSize="30" FontWeight="SemiBold" Text="Application behavior" TextWrapping="Wrap" />
              <TextBlock Name="SectionDetailText" Classes="muted" FontSize="12" LineHeight="18" TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Column="1"
                    Background="{DynamicResource AppAccentSoftBrush}"
                    BorderBrush="{DynamicResource AppAccentBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14,10"
                    VerticalAlignment="Bottom">
              <StackPanel Spacing="2">
                <TextBlock Classes="eyebrow" Text="LOCAL FIRST" />
                <TextBlock FontSize="10" Text="Settings and diagnostics remain on this device." />
              </StackPanel>
            </Border>
          </Grid>

          <StackPanel Name="GeneralPanel" Spacing="12">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
              <Border Grid.Column="0" Classes="settingsCard">
                <StackPanel Spacing="11">
                  <TextBlock Classes="eyebrow" Text="APPEARANCE" />
                  <TextBlock FontSize="15" FontWeight="SemiBold" Text="Interface theme" />
                  <TextBlock Classes="muted" FontSize="10" LineHeight="15" Text="Follow the operating system or force a consistent Light or Dark presentation." TextWrapping="Wrap" />
                  <ComboBox Name="AppearanceComboBox" SelectionChanged="AppearanceSelectionChanged">
                    <ComboBoxItem Content="System" />
                    <ComboBoxItem Content="Light" />
                    <ComboBoxItem Content="Dark" />
                  </ComboBox>
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Classes="settingsCard">
                <StackPanel Spacing="11">
                  <TextBlock Classes="eyebrow" Text="NETWORK INTERFACE" />
                  <TextBlock FontSize="15" FontWeight="SemiBold" Text="Active measurement path" />
                  <TextBlock Classes="muted" FontSize="10" LineHeight="15" Text="Automatic follows the active route. Choose an adapter only when reproducing interface-specific behavior." TextWrapping="Wrap" />
                  <ComboBox Name="InterfaceComboBox" SelectionChanged="InterfaceSelectionChanged" />
                  <Button Name="RefreshPreflightButton" Classes="ghost" Content="Refresh connection context" Click="RefreshPreflightClicked" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Classes="settingsCard">
                <StackPanel Spacing="11">
                  <TextBlock Classes="eyebrow" Text="PLATFORM STATUS" />
                  <TextBlock FontSize="15" FontWeight="SemiBold" Text="Desktop integration" />
                  <TextBlock Name="PlatformFeatureStatusText" Classes="secondary" FontSize="10" LineHeight="16" TextWrapping="Wrap" />
                  <Border Classes="settingsStatus">
                    <TextBlock Classes="muted" FontSize="9" LineHeight="14" Text="The live score can remain available after the main window closes when tray mode is enabled." TextWrapping="Wrap" />
                  </Border>
                </StackPanel>
              </Border>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <Border Grid.Column="0" Classes="settingsCard">
                <StackPanel Spacing="10">
                  <TextBlock Classes="eyebrow" Text="STARTUP &amp; STATUS" />
                  <CheckBox Name="StartInBackgroundCheckBox" Content="Open without activating the main window" />
                  <CheckBox Name="LiveTrayCheckBox" Content="Keep live status in the menu bar or system tray" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="settingsCard">
                <StackPanel Spacing="10">
                  <TextBlock Classes="eyebrow" Text="ACCESSIBILITY" />
                  <CheckBox Name="ReduceMotionCheckBox" Content="Reduce interface motion" />
                  <CheckBox Name="IncreaseContrastCheckBox" Content="Increase interface contrast" />
                </StackPanel>
              </Border>
            </Grid>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
              <TextBlock Classes="muted" FontSize="10" VerticalAlignment="Center" Text="Changes apply immediately where possible. Existing diagnostic reports remain unchanged." TextWrapping="Wrap" />
              <Button Grid.Column="1" Classes="primary" Content="Save application settings" Click="SaveGeneralClicked" />
            </Grid>
          </StackPanel>

          <StackPanel Name="MonitoringPanel" Spacing="12" IsVisible="False">
            <Border Classes="settingsCard">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                <StackPanel Spacing="7">
                  <TextBlock Classes="eyebrow" Text="CONTINUOUS HEALTH" />
                  <TextBlock FontSize="17" FontWeight="SemiBold" Text="Background connection sampling" />
                  <TextBlock Classes="muted" FontSize="10" LineHeight="15" Text="Lightweight checks populate the live score, response timeline, availability history, and local alerts." TextWrapping="Wrap" />
                  <TextBlock Name="MonitoringStatusText" Classes="secondary" FontSize="10" LineHeight="15" TextWrapping="Wrap" />
                </StackPanel>
                <CheckBox Name="MonitoringEnabledCheckBox" Grid.Column="1" Content="Monitoring enabled" VerticalAlignment="Center" />
              </Grid>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <Border Grid.Column="0" Classes="settingsCard">
                <StackPanel Spacing="12">
                  <TextBlock Classes="eyebrow" Text="CADENCE" />
                  <TextBlock FontSize="15" FontWeight="SemiBold" Text="Measurement frequency" />
                  <StackPanel Spacing="5">
                    <TextBlock Classes="fieldLabel" Text="Sampling interval" />
                    <ComboBox Name="MonitoringIntervalComboBox">
                      <ComboBoxItem Content="Every 2 seconds" />
                      <ComboBoxItem Content="Every 5 seconds" />
                      <ComboBoxItem Content="Every 10 seconds" />
                      <ComboBoxItem Content="Every 30 seconds" />
                      <ComboBoxItem Content="Every 60 seconds" />
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Spacing="5">
                    <TextBlock Classes="fieldLabel" Text="Content-speed cadence" />
                    <ComboBox Name="ContentCadenceComboBox">
                      <ComboBoxItem Content="Every hour" />
                      <ComboBoxItem Content="Every 4 hours" />
                      <ComboBoxItem Content="Every 6 hours" />
                      <ComboBoxItem Content="Every 24 hours" />
                      <ComboBoxItem Content="On demand only" />
                    </ComboBox>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Classes="settingsCard">
                <StackPanel Spacing="12">
                  <TextBlock Classes="eyebrow" Text="SCORING EXPECTATIONS" />
                  <TextBlock FontSize="15" FontWeight="SemiBold" Text="Expected connection capacity" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <StackPanel Grid.Column="0" Spacing="5">
                      <TextBlock Classes="fieldLabel" Text="Download (Mbps)" />
                      <TextBox Name="ExpectedDownloadTextBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="5">
                      <TextBlock Classes="fieldLabel" Text="Upload (Mbps)" />
                      <TextBox Name="ExpectedUploadTextBox" />
                    </StackPanel>
                  </Grid>
                  <StackPanel Spacing="5">
                    <TextBlock Classes="fieldLabel" Text="Alert when score falls below" />
                    <TextBox Name="AlertThresholdTextBox" />
                  </StackPanel>
                  <TextBlock Classes="muted" FontSize="9" LineHeight="14" Text="Speed scoring compares content-test results with these expectations. Responsiveness and reliability remain independently measured." TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </Grid>

            <Button Classes="primary" Content="Save monitoring settings" Click="SaveMonitoringClicked" HorizontalAlignment="Right" />
          </StackPanel>

          <StackPanel Name="MeasurementPanel" Spacing="12" IsVisible="False">
            <Border Classes="settingsCard">
              <StackPanel Spacing="9">
                <TextBlock Classes="eyebrow" Text="ENDPOINT CANDIDATES" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                  <StackPanel Spacing="5">
                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="Compatible measurement origins" />
                    <TextBlock Classes="muted" FontSize="10" LineHeight="15" Text="Enter up to eight HTTP or HTTPS origins, one per line. The app probes candidates and chooses the lowest-latency available endpoint." TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="ghost" Content="Refresh preflight" Click="RefreshPreflightClicked" VerticalAlignment="Center" />
                </Grid>
                <TextBox Name="OriginsTextBox" AcceptsReturn="True" MinHeight="92" PlaceholderText="https://network.johnnyli.dev/" />
              </StackPanel>
            </Border>

            <Grid ColumnDefinitions="0.8*,1.2*" ColumnSpacing="12">
              <Border Grid.Column="0" Classes="settingsCard">
                <StackPanel Spacing="12">
                  <TextBlock Classes="eyebrow" Text="DEFAULT DIAGNOSTIC" />
                  <TextBlock FontSize="15" FontWeight="SemiBold" Text="Starting profile" />
                  <StackPanel Spacing="5">
                    <TextBlock Classes="fieldLabel" Text="Profile" />
                    <ComboBox Name="ProfileComboBox" SelectionChanged="ProfileSelectionChanged">
                      <ComboBoxItem Content="Connection Check" />
                      <ComboBoxItem Content="Quick" />
                      <ComboBoxItem Content="Full" />
                      <ComboBoxItem Content="Stress" />
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Spacing="5">
                    <TextBlock Classes="fieldLabel" Text="Transfer method" />
                    <ComboBox Name="MethodComboBox" SelectionChanged="MethodSelectionChanged">
                      <ComboBoxItem Content="Compare" />
                      <ComboBoxItem Content="Single" />
                      <ComboBoxItem Content="Aggregate" />
                    </ComboBox>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Classes="settingsCard">
                <StackPanel Spacing="11">
                  <TextBlock Classes="eyebrow" Text="TRUSTED LAN ISOLATION" />
                  <TextBlock FontSize="15" FontWeight="SemiBold" Text="Separate local-network performance from Internet performance" TextWrapping="Wrap" />
                  <TextBox Name="LanTargetTextBox" PlaceholderText="Hostname or address" />
                  <Grid ColumnDefinitions="*,*,*" ColumnSpacing="9">
                    <StackPanel Grid.Column="0" Spacing="5">
                      <TextBlock Classes="fieldLabel" Text="Port" />
                      <TextBox Name="LanPortTextBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="5">
                      <TextBlock Classes="fieldLabel" Text="Seconds" />
                      <TextBox Name="LanDurationTextBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="5">
                      <TextBlock Classes="fieldLabel" Text="Connections" />
                      <TextBox Name="LanConnectionsTextBox" />
                    </StackPanel>
                  </Grid>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="secondary" Content="Start LAN server" Click="StartLanServerClicked" />
                    <Button Name="StopLanServerButton" Classes="ghost" Content="Stop" Click="StopLanServerClicked" />
                  </StackPanel>
                  <TextBlock Name="LanServerStatusText" Classes="muted" FontSize="10" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </Grid>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
              <TextBlock Name="MeasurementStatusText" Classes="muted" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap" />
              <Button Grid.Column="1" Classes="primary" Content="Save diagnostic settings" Click="SaveMeasurementClicked" />
            </Grid>
          </StackPanel>

          <StackPanel Name="PrivacyPanel" Spacing="12" IsVisible="False">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <Border Grid.Column="0" Classes="settingsCard">
                <StackPanel Spacing="11">
                  <TextBlock Classes="eyebrow" Text="REPORT IDENTIFIERS" />
                  <TextBlock FontSize="15" FontWeight="SemiBold" Text="Local context in saved reports" />
                  <CheckBox Name="IdentifiersCheckBox" Content="Include local addresses and Wi-Fi network name" Click="IdentifiersClicked" />
                  <TextBlock Classes="muted" FontSize="10" LineHeight="15" Text="Off by default. Diagnostic measurements remain available while supported local identifiers are omitted from saved reports and monitoring exports." TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Classes="settingsCard">
                <StackPanel Spacing="11">
                  <TextBlock Classes="eyebrow" Text="HIGH-DATA APPROVALS" />
                  <TextBlock FontSize="15" FontWeight="SemiBold" Text="Remembered transfer consent" />
                  <TextBlock Name="ApprovalSummaryText" Classes="secondary" FontSize="11" FontWeight="SemiBold" LineHeight="17" TextWrapping="Wrap" />
                  <TextBlock Classes="muted" FontSize="10" LineHeight="15" Text="Full and Stress remember approval only for the current transfer ceiling. A higher ceiling asks again." TextWrapping="Wrap" />
                  <Button Classes="secondary" Content="Reset remembered approvals" Click="ResetApprovalsClicked" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
            </Grid>
            <Border Classes="settingsStatus">
              <TextBlock Name="PrivacyStatusText" Classes="muted" FontSize="10" TextWrapping="Wrap" />
            </Border>
          </StackPanel>

          <StackPanel Name="StoragePanel" Spacing="12" IsVisible="False">
            <Grid ColumnDefinitions="1.25*,0.75*" ColumnSpacing="12">
              <Border Grid.Column="0" Classes="settingsCard">
                <StackPanel Spacing="10">
                  <TextBlock Classes="eyebrow" Text="LOCAL APPLICATION DATA" />
                  <TextBlock FontSize="16" FontWeight="SemiBold" Text="Reports, monitoring history, and alerts" />
                  <Border Classes="settingsStatus">
                    <TextBlock Name="ReportsDirectoryText" FontSize="10" LineHeight="15" TextWrapping="Wrap" />
                  </Border>
                  <Button Classes="primary" Content="Open data folder" Click="OpenReportsFolderClicked" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="settingsCard">
                <StackPanel Spacing="10">
                  <TextBlock Classes="eyebrow" Text="DATA BOUNDARY" />
                  <TextBlock FontSize="15" FontWeight="SemiBold" Text="Local unless exported" />
                  <TextBlock Classes="secondary" FontSize="10" LineHeight="16" Text="Saved diagnostics, monitoring samples, and alerts stay in the application-data directory. Nothing is uploaded by the desktop app." TextWrapping="Wrap" />
                  <TextBlock Classes="muted" FontSize="9" LineHeight="14" Text="Use HTML, CSV, or JSON export when you intentionally need to share data." TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>

          <StackPanel Name="DeveloperPanel" Spacing="12" IsVisible="False">
            <Grid ColumnDefinitions="1.1*,0.9*" ColumnSpacing="12">
              <Border Grid.Column="0" Classes="settingsCard">
                <StackPanel Spacing="11">
                  <TextBlock Classes="eyebrow" Text="RESULT PREVIEW" />
                  <TextBlock FontSize="16" FontWeight="SemiBold" Text="Exercise terminal presentation states" />
                  <TextBlock Classes="muted" FontSize="10" LineHeight="15" Text="Preview a result without network activity, changing measurement settings, or writing a report." TextWrapping="Wrap" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="9">
                    <ComboBox Name="FixtureComboBox">
                      <ComboBoxItem Content="Healthy connection" />
                      <ComboBoxItem Content="Investigate responsiveness" />
                      <ComboBoxItem Content="Investigate reliability" />
                      <ComboBoxItem Content="Transfer unavailable" />
                      <ComboBoxItem Content="Connection unavailable" />
                    </ComboBox>
                    <Button Grid.Column="1" Classes="primary" Content="Preview result" Click="PreviewClicked" />
                  </Grid>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="settingsCard">
                <StackPanel Spacing="10">
                  <TextBlock Classes="eyebrow" Text="VISUAL COVERAGE" />
                  <TextBlock FontSize="15" FontWeight="SemiBold" Text="States worth reviewing" />
                  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="9" RowSpacing="8">
                    <Border Width="7" Height="7" CornerRadius="4" Classes="indicatorSuccess" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" FontSize="10" Text="Healthy and completed" />
                    <Border Grid.Row="1" Width="7" Height="7" CornerRadius="4" Classes="indicatorAccent" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Grid.Column="1" FontSize="10" Text="Degraded or investigate" />
                    <Border Grid.Row="2" Width="7" Height="7" CornerRadius="4" Classes="indicatorNeutral" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" Grid.Column="1" FontSize="10" Text="Unavailable measurements" />
                    <Border Grid.Row="3" Width="7" Height="7" CornerRadius="4" Background="{DynamicResource AppDangerBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="3" Grid.Column="1" FontSize="10" Text="Failed diagnostic" />
                  </Grid>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
