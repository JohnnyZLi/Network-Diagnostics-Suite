<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NetworkDiagnostics.Desktop.Workspaces.SettingsWorkspace"
             Background="#111415"
             Foreground="#E9E6E0"
             FontFamily="Inter">
  <UserControl.Styles>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#969B9B" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="Foreground" Value="#C77E68" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1.5" />
    </Style>
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="Foreground" Value="#969B9B" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#171B1C" />
      <Setter Property="BorderBrush" Value="#303536" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="18" />
    </Style>
    <Style Selector="Button.sectionNav">
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#AEB3B3" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.sectionNav:pointerover">
      <Setter Property="Background" Value="#202526" />
      <Setter Property="Foreground" Value="#F0EDE7" />
    </Style>
    <Style Selector="Button.sectionNav.selected">
      <Setter Property="Background" Value="#29231C" />
      <Setter Property="Foreground" Value="#F4F0EA" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="Background" Value="#C96346" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="13,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#D2D6D6" />
      <Setter Property="BorderBrush" Value="#414748" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="11,8" />
      <Setter Property="Background" Value="#111415" />
      <Setter Property="Foreground" Value="#E9E6E0" />
      <Setter Property="BorderBrush" Value="#3B4142" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="11,0" />
      <Setter Property="Background" Value="#111415" />
      <Setter Property="Foreground" Value="#E9E6E0" />
      <Setter Property="BorderBrush" Value="#3B4142" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="184,*">
    <Border Grid.Column="0"
            Background="#15191A"
            BorderBrush="#303536"
            BorderThickness="0,0,1,0"
            Padding="14,22">
      <Grid RowDefinitions="Auto,Auto,*">
        <StackPanel Grid.Row="0" Spacing="5" Margin="4,0,4,18">
          <TextBlock Classes="eyebrow" Text="SETTINGS" />
          <TextBlock FontSize="18" FontWeight="SemiBold" Text="Configuration" />
          <TextBlock Classes="muted" FontSize="11" LineHeight="17" Text="Local application, measurement, privacy, and storage behavior." TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="4">
          <Button Name="GeneralButton" Classes="sectionNav selected" Tag="General" Content="General" Click="SectionClicked" />
          <Button Name="MeasurementButton" Classes="sectionNav" Tag="Measurement" Content="Measurement" Click="SectionClicked" />
          <Button Name="PrivacyButton" Classes="sectionNav" Tag="Privacy &amp; data" Content="Privacy &amp; data" Click="SectionClicked" />
          <Button Name="StorageButton" Classes="sectionNav" Tag="Storage" Content="Storage" Click="SectionClicked" />
          <Button Name="DeveloperButton" Classes="sectionNav" Tag="Developer" Content="Developer" Click="SectionClicked" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="34,28,34,40" MaxWidth="900" HorizontalAlignment="Center">
        <StackPanel Spacing="20">
          <StackPanel Spacing="6">
            <TextBlock Name="SectionEyebrowText" Classes="eyebrow" Text="GENERAL" />
            <TextBlock Name="SectionTitleText" FontSize="28" FontWeight="SemiBold" Text="Application defaults" TextWrapping="Wrap" />
            <TextBlock Name="SectionDetailText" Classes="muted" FontSize="13" LineHeight="20" TextWrapping="Wrap" />
          </StackPanel>

          <Border Name="GeneralPanel" Classes="panel">
            <StackPanel Spacing="18">
              <StackPanel Spacing="7">
                <TextBlock Classes="eyebrow" Text="DEFAULT TEST" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                  <StackPanel Grid.Column="0" Spacing="5">
                    <TextBlock Classes="fieldLabel" Text="Profile" />
                    <ComboBox Name="ProfileComboBox" SelectionChanged="ProfileSelectionChanged">
                      <ComboBoxItem Content="Connection Check" />
                      <ComboBoxItem Content="Quick" />
                      <ComboBoxItem Content="Full" />
                      <ComboBoxItem Content="Stress" />
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="5">
                    <TextBlock Classes="fieldLabel" Text="Transfer method" />
                    <ComboBox Name="MethodComboBox" SelectionChanged="MethodSelectionChanged">
                      <ComboBoxItem Content="Compare" />
                      <ComboBoxItem Content="Single" />
                      <ComboBoxItem Content="Aggregate" />
                    </ComboBox>
                  </StackPanel>
                </Grid>
                <TextBlock Classes="muted" FontSize="11" LineHeight="17" Text="These selections become the starting point for a new diagnostic. They do not alter a test already in progress." TextWrapping="Wrap" />
              </StackPanel>

              <Border BorderBrush="#303536" BorderThickness="0,1,0,0" />

              <StackPanel Spacing="7">
                <TextBlock Classes="eyebrow" Text="NETWORK INTERFACE" />
                <ComboBox Name="InterfaceComboBox" SelectionChanged="InterfaceSelectionChanged" />
                <TextBlock Classes="muted" FontSize="11" LineHeight="17" Text="Automatic follows the system route. Choose a specific adapter when reproducing Wi-Fi, Ethernet, VPN, or interface-specific behavior." TextWrapping="Wrap" />
              </StackPanel>

              <Button Classes="secondary" Content="Refresh connection preflight" Click="RefreshPreflightClicked" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>

          <Border Name="MeasurementPanel" Classes="panel" IsVisible="False">
            <StackPanel Spacing="18">
              <StackPanel Spacing="7">
                <TextBlock Classes="eyebrow" Text="ENDPOINT CANDIDATES" />
                <TextBlock Classes="muted" FontSize="12" LineHeight="18" Text="Enter up to eight compatible HTTP or HTTPS origins, one per line. The app probes every candidate and chooses the lowest-latency available endpoint." TextWrapping="Wrap" />
                <TextBox Name="OriginsTextBox" AcceptsReturn="True" MinHeight="96" PlaceholderText="https://network.johnnyli.dev/" />
              </StackPanel>

              <Border BorderBrush="#303536" BorderThickness="0,1,0,0" />

              <StackPanel Spacing="10">
                <TextBlock Classes="eyebrow" Text="LAN ISOLATION" />
                <TextBlock Classes="muted" FontSize="12" LineHeight="18" Text="Full and Stress can optionally test a trusted machine running the built-in LAN server. Leave the target blank to omit this phase." TextWrapping="Wrap" />
                <StackPanel Spacing="5">
                  <TextBlock Classes="fieldLabel" Text="LAN server target" />
                  <TextBox Name="LanTargetTextBox" PlaceholderText="Hostname or address" />
                </StackPanel>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                  <StackPanel Grid.Column="0" Spacing="5">
                    <TextBlock Classes="fieldLabel" Text="Port" />
                    <TextBox Name="LanPortTextBox" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="5">
                    <TextBlock Classes="fieldLabel" Text="Seconds" />
                    <TextBox Name="LanDurationTextBox" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="5">
                    <TextBlock Classes="fieldLabel" Text="Connections" />
                    <TextBox Name="LanConnectionsTextBox" />
                  </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                  <Button Grid.Column="0" Classes="secondary" Content="Start LAN server" Click="StartLanServerClicked" />
                  <Button Name="StopLanServerButton" Grid.Column="1" Classes="secondary" Content="Stop server" Click="StopLanServerClicked" />
                  <TextBlock Name="LanServerStatusText" Grid.Column="2" Classes="muted" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" />
                </Grid>
              </StackPanel>

              <Button Classes="primary" Content="Save measurement settings" Click="SaveMeasurementClicked" HorizontalAlignment="Left" />
              <TextBlock Name="MeasurementStatusText" Classes="muted" FontSize="11" LineHeight="17" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Name="PrivacyPanel" Classes="panel" IsVisible="False">
            <StackPanel Spacing="18">
              <StackPanel Spacing="8">
                <TextBlock Classes="eyebrow" Text="REPORT PRIVACY" />
                <CheckBox Name="IdentifiersCheckBox" Content="Include local addresses and Wi-Fi network name" Click="IdentifiersClicked" />
                <TextBlock Classes="muted" FontSize="12" LineHeight="18" Text="Off by default. Diagnostic measurements remain available while supported local identifiers are omitted from saved reports." TextWrapping="Wrap" />
              </StackPanel>

              <Border BorderBrush="#303536" BorderThickness="0,1,0,0" />

              <StackPanel Spacing="8">
                <TextBlock Classes="eyebrow" Text="DATA APPROVALS" />
                <TextBlock Name="ApprovalSummaryText" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Classes="muted" FontSize="12" LineHeight="18" Text="Full and Stress remember approval only for the current transfer ceiling. A higher ceiling automatically asks again." TextWrapping="Wrap" />
                <Button Classes="secondary" Content="Reset remembered approvals" Click="ResetApprovalsClicked" HorizontalAlignment="Left" />
              </StackPanel>
              <TextBlock Name="PrivacyStatusText" Classes="muted" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Name="StoragePanel" Classes="panel" IsVisible="False">
            <StackPanel Spacing="16">
              <StackPanel Spacing="7">
                <TextBlock Classes="eyebrow" Text="SAVED REPORTS" />
                <TextBlock FontSize="15" FontWeight="SemiBold" Text="Local report directory" />
                <Border Background="#111415" BorderBrush="#303536" BorderThickness="1" CornerRadius="8" Padding="12">
                  <TextBlock Name="ReportsDirectoryText" FontSize="11" LineHeight="17" TextWrapping="Wrap" />
                </Border>
                <TextBlock Classes="muted" FontSize="12" LineHeight="18" Text="Completed and imported reports remain local and use the shared schema 2.0 JSON format." TextWrapping="Wrap" />
              </StackPanel>
              <Button Classes="secondary" Content="Open reports folder" Click="OpenReportsFolderClicked" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>

          <Border Name="DeveloperPanel" Classes="panel" IsVisible="False">
            <StackPanel Spacing="16">
              <StackPanel Spacing="7">
                <TextBlock Classes="eyebrow" Text="RESULT PREVIEWS" />
                <TextBlock Classes="muted" FontSize="12" LineHeight="18" Text="Preview terminal result states without running the measurement engine. This is intended for UI and presentation validation." TextWrapping="Wrap" />
                <ComboBox Name="FixtureComboBox">
                  <ComboBoxItem Content="Healthy" />
                  <ComboBoxItem Content="Problematic" />
                  <ComboBoxItem Content="Inconclusive" />
                  <ComboBoxItem Content="Unavailable measurement" />
                  <ComboBoxItem Content="Failed with partial evidence" />
                </ComboBox>
              </StackPanel>
              <Button Classes="secondary" Content="Preview selected result" Click="PreviewClicked" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
