<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NetworkDiagnostics.Desktop.Workspaces.SettingsWorkspace"
             Background="{DynamicResource AppCanvasBrush}"
             Foreground="{DynamicResource AppTextBrush}"
             FontFamily="Inter">
  <UserControl.Styles>
    <Style Selector="Button.sectionNav">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="13,7" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.sectionNav:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <Style Selector="Button.sectionNav.selected">
      <Setter Property="Background" Value="{DynamicResource AppSelectedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
      <Setter Property="FontSize" Value="9.5" />
    </Style>
    <Style Selector="TextBlock.settingsCardTitle">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.settingsCardDescription">
      <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="LineHeight" Value="15" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="Border.settingsCard">
      <Setter Property="Background" Value="{DynamicResource AppRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="18" />
    </Style>
    <Style Selector="Border.settingsStatus">
      <Setter Property="Background" Value="{DynamicResource AppInsetBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Border.settingsFooter">
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Padding" Value="0,14,0,0" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="11,7" />
      <Setter Property="Background" Value="{DynamicResource AppInsetBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="11,0" />
      <Setter Property="Background" Value="{DynamicResource AppInsetBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Grid Name="SettingsRootGrid" RowDefinitions="Auto,*">
    <Border Grid.Row="0"
            Background="{DynamicResource AppSidebarBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="20,8">
      <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button Name="GeneralButton" Classes="sectionNav selected" Tag="General" Content="General" Click="SectionClicked" />
          <Button Name="MonitoringButton" Classes="sectionNav" Tag="Monitoring" Content="Monitoring" Click="SectionClicked" />
          <Button Name="MeasurementButton" Classes="sectionNav" Tag="Measurement" Content="Diagnostics" Click="SectionClicked" />
          <Button Name="PrivacyButton" Classes="sectionNav" Tag="Privacy &amp; data" Content="Privacy" Click="SectionClicked" />
          <Button Name="StorageButton" Classes="sectionNav" Tag="Storage" Content="Storage" Click="SectionClicked" />
          <Button Name="DeveloperButton" Classes="sectionNav" Tag="Developer" Content="Developer" Click="SectionClicked" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <Grid Name="SettingsContentContainer"
            Margin="28,24,28,36"
            MaxWidth="1040"
            HorizontalAlignment="Stretch">
        <StackPanel Spacing="22">
          <StackPanel Spacing="5">
            <TextBlock Name="SectionEyebrowText" Classes="eyebrow" Text="GENERAL" />
            <TextBlock Name="SectionTitleText"
                       FontSize="26"
                       FontWeight="SemiBold"
                       LineHeight="31"
                       Text="Application"
                       TextWrapping="Wrap" />
            <TextBlock Name="SectionDetailText"
                       Classes="muted"
                       FontSize="11"
                       LineHeight="17"
                       MaxWidth="760"
                       TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Name="GeneralPanel" Spacing="14">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="14" RowSpacing="14">
              <Border Grid.Column="0" Classes="settingsCard">
                <StackPanel Spacing="11">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="eyebrow" Text="APPEARANCE" />
                    <TextBlock Classes="settingsCardTitle" Text="Interface theme" />
                    <TextBlock Classes="settingsCardDescription" Text="Follow the operating system or force a consistent Light or Dark presentation." />
                  </StackPanel>
                  <StackPanel Spacing="5">
                    <TextBlock Classes="fieldLabel" Text="Theme" />
                    <ComboBox Name="AppearanceComboBox" SelectionChanged="AppearanceSelectionChanged">
                      <ComboBoxItem Content="System" />
                      <ComboBoxItem Content="Light" />
                      <ComboBoxItem Content="Dark" />
                    </ComboBox>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Classes="settingsCard">
                <StackPanel Spacing="11">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="eyebrow" Text="NETWORK PATH" />
                    <TextBlock Classes="settingsCardTitle" Text="Measurement interface" />
                    <TextBlock Classes="settingsCardDescription" Text="Automatic follows the active route. Choose an adapter only when reproducing interface-specific behavior." />
                  </StackPanel>
                  <StackPanel Spacing="5">
                    <TextBlock Classes="fieldLabel" Text="Interface" />
                    <ComboBox Name="InterfaceComboBox" SelectionChanged="InterfaceSelectionChanged" />
                  </StackPanel>
                  <Button Name="RefreshPreflightButton"
                          Classes="secondary"
                          Content="Refresh connection context"
                          Click="RefreshPreflightClicked"
                          HorizontalAlignment="Left" />
                </StackPanel>
              </Border>

              <Border Grid.Row="1" Grid.Column="0" Classes="settingsCard">
                <StackPanel Spacing="11">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="eyebrow" Text="DESKTOP BEHAVIOR" />
                    <TextBlock Classes="settingsCardTitle" Text="Startup and live status" />
                    <TextBlock Classes="settingsCardDescription" Text="Choose how the app behaves when it launches and whether network status remains available outside the main window." />
                  </StackPanel>
                  <CheckBox Name="StartInBackgroundCheckBox" Content="Open without activating the main window" />
                  <CheckBox Name="LiveTrayCheckBox" Content="Keep live status in the menu bar or system tray" />
                  <Border Classes="settingsStatus">
                    <StackPanel Spacing="4">
                      <TextBlock Name="PlatformFeatureStatusText" Classes="secondary" FontSize="10" LineHeight="15" TextWrapping="Wrap" />
                      <TextBlock Classes="muted" FontSize="9" LineHeight="14" Text="Live status can remain available after the main window closes when tray mode is enabled." TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>

              <Border Grid.Row="1" Grid.Column="1" Classes="settingsCard">
                <StackPanel Spacing="11">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="eyebrow" Text="ACCESSIBILITY" />
                    <TextBlock Classes="settingsCardTitle" Text="Interface comfort" />
                    <TextBlock Classes="settingsCardDescription" Text="Reduce decorative motion or increase visual separation without changing diagnostic behavior." />
                  </StackPanel>
                  <CheckBox Name="ReduceMotionCheckBox" Content="Reduce interface motion" />
                  <CheckBox Name="IncreaseContrastCheckBox" Content="Increase interface contrast" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Classes="settingsFooter">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                <TextBlock Classes="muted"
                           FontSize="10"
                           VerticalAlignment="Center"
                           Text="Changes apply immediately where possible. Existing diagnostic reports remain unchanged."
                           TextWrapping="Wrap" />
                <Button Grid.Column="1" Classes="primary" Content="Save changes" Click="SaveGeneralClicked" />
              </Grid>
            </Border>
          </StackPanel>

          <StackPanel Name="MonitoringPanel" Spacing="14" IsVisible="False">
            <Border Classes="settingsCard">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="22">
                <StackPanel Spacing="4">
                  <TextBlock Classes="eyebrow" Text="BACKGROUND MONITORING" />
                  <TextBlock Classes="settingsCardTitle" Text="Continuous network health" />
                  <TextBlock Classes="settingsCardDescription" Text="Lightweight checks populate the live score, response timeline, availability history, and local alerts." />
                  <TextBlock Name="MonitoringStatusText" Classes="secondary" FontSize="10" LineHeight="15" Margin="0,3,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <CheckBox Name="MonitoringEnabledCheckBox"
                          Grid.Column="1"
                          Content="Enabled"
                          VerticalAlignment="Center" />
              </Grid>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
              <Border Grid.Column="0" Classes="settingsCard">
                <StackPanel Spacing="11">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="eyebrow" Text="SCHEDULE" />
                    <TextBlock Classes="settingsCardTitle" Text="Measurement cadence" />
                    <TextBlock Classes="settingsCardDescription" Text="Control how often lightweight monitoring and scheduled content-speed checks run." />
                  </StackPanel>
                  <StackPanel Spacing="5">
                    <TextBlock Classes="fieldLabel" Text="Sampling interval" />
                    <ComboBox Name="MonitoringIntervalComboBox">
                      <ComboBoxItem Content="Every 2 seconds" />
                      <ComboBoxItem Content="Every 5 seconds" />
                      <ComboBoxItem Content="Every 10 seconds" />
                      <ComboBoxItem Content="Every 30 seconds" />
                      <ComboBoxItem Content="Every 60 seconds" />
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Spacing="5">
                    <TextBlock Classes="fieldLabel" Text="Content-speed cadence" />
                    <ComboBox Name="ContentCadenceComboBox">
                      <ComboBoxItem Content="Every hour" />
                      <ComboBoxItem Content="Every 4 hours" />
                      <ComboBoxItem Content="Every 6 hours" />
                      <ComboBoxItem Content="Every 24 hours" />
                      <ComboBoxItem Content="On demand only" />
                    </ComboBox>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Classes="settingsCard">
                <StackPanel Spacing="11">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="eyebrow" Text="SCORING" />
                    <TextBlock Classes="settingsCardTitle" Text="Expected connection capacity" />
                    <TextBlock Classes="settingsCardDescription" Text="Set the throughput expectations used by speed scoring and the score threshold used for degradation alerts." />
                  </StackPanel>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <StackPanel Grid.Column="0" Spacing="5">
                      <TextBlock Classes="fieldLabel" Text="Download (Mbps)" />
                      <TextBox Name="ExpectedDownloadTextBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="5">
                      <TextBlock Classes="fieldLabel" Text="Upload (Mbps)" />
                      <TextBox Name="ExpectedUploadTextBox" />
                    </StackPanel>
                  </Grid>
                  <StackPanel Spacing="5">
                    <TextBlock Classes="fieldLabel" Text="Alert below score" />
                    <TextBox Name="AlertThresholdTextBox" />
                  </StackPanel>
                  <TextBlock Classes="muted" FontSize="9" LineHeight="14" Text="Responsiveness and reliability remain independently measured." TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Classes="settingsFooter">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                <TextBlock Classes="muted" FontSize="10" VerticalAlignment="Center" Text="Monitoring changes take effect after they are saved." TextWrapping="Wrap" />
                <Button Grid.Column="1" Classes="primary" Content="Save changes" Click="SaveMonitoringClicked" />
              </Grid>
            </Border>
          </StackPanel>

          <StackPanel Name="MeasurementPanel" Spacing="14" IsVisible="False">
            <Grid ColumnDefinitions="0.8*,1.2*" ColumnSpacing="14">
              <Border Grid.Column="0" Classes="settingsCard">
                <StackPanel Spacing="11">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="eyebrow" Text="DEFAULT RUN" />
                    <TextBlock Classes="settingsCardTitle" Text="Diagnostic defaults" />
                    <TextBlock Classes="settingsCardDescription" Text="Choose the profile and transfer method selected when the app opens a new diagnostic." />
                  </StackPanel>
                  <StackPanel Spacing="5">
                    <TextBlock Classes="fieldLabel" Text="Profile" />
                    <ComboBox Name="ProfileComboBox" SelectionChanged="ProfileSelectionChanged">
                      <ComboBoxItem Content="Connection Check" />
                      <ComboBoxItem Content="Quick" />
                      <ComboBoxItem Content="Full" />
                      <ComboBoxItem Content="Stress" />
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Spacing="5">
                    <TextBlock Classes="fieldLabel" Text="Transfer method" />
                    <ComboBox Name="MethodComboBox" SelectionChanged="MethodSelectionChanged">
                      <ComboBoxItem Content="Compare" />
                      <ComboBoxItem Content="Single" />
                      <ComboBoxItem Content="Aggregate" />
                    </ComboBox>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Classes="settingsCard">
                <StackPanel Spacing="11">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="eyebrow" Text="MEASUREMENT ORIGINS" />
                      <TextBlock Classes="settingsCardTitle" Text="Endpoint candidates" />
                      <TextBlock Classes="settingsCardDescription" Text="Enter up to eight HTTP or HTTPS origins, one per line. The app selects the lowest-latency available candidate." />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="secondary" Content="Refresh preflight" Click="RefreshPreflightClicked" VerticalAlignment="Top" />
                  </Grid>
                  <TextBox Name="OriginsTextBox"
                           AcceptsReturn="True"
                           MinHeight="104"
                           PlaceholderText="https://network.johnnyli.dev/" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Classes="settingsCard">
              <StackPanel Spacing="11">
                <StackPanel Spacing="4">
                  <TextBlock Classes="eyebrow" Text="TRUSTED LAN" />
                  <TextBlock Classes="settingsCardTitle" Text="Separate local-network performance from Internet performance" />
                  <TextBlock Classes="settingsCardDescription" Text="Run a trusted local endpoint to distinguish LAN limitations from Internet-path limitations." />
                </StackPanel>
                <Grid ColumnDefinitions="2*,0.7*,0.7*,0.7*" ColumnSpacing="10">
                  <StackPanel Grid.Column="0" Spacing="5">
                    <TextBlock Classes="fieldLabel" Text="Hostname or address" />
                    <TextBox Name="LanTargetTextBox" PlaceholderText="Hostname or address" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="5">
                    <TextBlock Classes="fieldLabel" Text="Port" />
                    <TextBox Name="LanPortTextBox" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="5">
                    <TextBlock Classes="fieldLabel" Text="Seconds" />
                    <TextBox Name="LanDurationTextBox" />
                  </StackPanel>
                  <StackPanel Grid.Column="3" Spacing="5">
                    <TextBlock Classes="fieldLabel" Text="Connections" />
                    <TextBox Name="LanConnectionsTextBox" />
                  </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="secondary" Content="Start LAN server" Click="StartLanServerClicked" />
                    <Button Name="StopLanServerButton" Classes="ghost" Content="Stop" Click="StopLanServerClicked" />
                  </StackPanel>
                  <TextBlock Name="LanServerStatusText" Grid.Column="1" Classes="muted" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Classes="settingsFooter">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                <TextBlock Name="MeasurementStatusText" Classes="muted" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="1" Classes="primary" Content="Save changes" Click="SaveMeasurementClicked" />
              </Grid>
            </Border>
          </StackPanel>

          <StackPanel Name="PrivacyPanel" Spacing="14" IsVisible="False">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
              <Border Grid.Column="0" Classes="settingsCard">
                <StackPanel Spacing="11">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="eyebrow" Text="REPORT IDENTIFIERS" />
                    <TextBlock Classes="settingsCardTitle" Text="Local context in saved reports" />
                    <TextBlock Classes="settingsCardDescription" Text="Choose whether supported local identifiers are included when reports and monitoring exports are written." />
                  </StackPanel>
                  <CheckBox Name="IdentifiersCheckBox" Content="Include local addresses and Wi-Fi network name" Click="IdentifiersClicked" />
                  <TextBlock Classes="muted" FontSize="9" LineHeight="14" Text="Off by default. Diagnostic measurements remain available when local identifiers are omitted." TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Classes="settingsCard">
                <StackPanel Spacing="11">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="eyebrow" Text="HIGH-DATA APPROVALS" />
                    <TextBlock Classes="settingsCardTitle" Text="Remembered transfer consent" />
                    <TextBlock Classes="settingsCardDescription" Text="Full and Stress can remember approval up to the transfer ceiling you previously accepted." />
                  </StackPanel>
                  <TextBlock Name="ApprovalSummaryText" Classes="secondary" FontSize="10" FontWeight="SemiBold" LineHeight="16" TextWrapping="Wrap" />
                  <Button Classes="secondary" Content="Reset remembered approvals" Click="ResetApprovalsClicked" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Classes="settingsFooter">
              <TextBlock Name="PrivacyStatusText" Classes="muted" FontSize="10" TextWrapping="Wrap" />
            </Border>
          </StackPanel>

          <StackPanel Name="StoragePanel" Spacing="14" IsVisible="False">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
              <Border Grid.Column="0" Classes="settingsCard">
                <StackPanel Spacing="11">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="eyebrow" Text="LOCAL APPLICATION DATA" />
                    <TextBlock Classes="settingsCardTitle" Text="Reports, monitoring history, and alerts" />
                    <TextBlock Classes="settingsCardDescription" Text="The desktop app keeps its reports and monitoring history in one local application-data directory." />
                  </StackPanel>
                  <Border Classes="settingsStatus">
                    <TextBlock Name="ReportsDirectoryText" FontSize="10" LineHeight="15" TextWrapping="Wrap" />
                  </Border>
                  <Button Classes="secondary" Content="Open data folder" Click="OpenReportsFolderClicked" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Classes="settingsCard">
                <StackPanel Spacing="11">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="eyebrow" Text="DATA BOUNDARY" />
                    <TextBlock Classes="settingsCardTitle" Text="Local unless exported" />
                    <TextBlock Classes="settingsCardDescription" Text="Saved diagnostics, monitoring samples, and alerts stay on this device. The desktop app does not upload them automatically." />
                  </StackPanel>
                  <Border Classes="settingsStatus">
                    <TextBlock Classes="muted" FontSize="9" LineHeight="14" Text="HTML, CSV, and JSON exports are explicit actions for data you intentionally choose to share." TextWrapping="Wrap" />
                  </Border>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>

          <StackPanel Name="DeveloperPanel" Spacing="14" IsVisible="False">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
              <Border Grid.Column="0" Classes="settingsCard">
                <StackPanel Spacing="11">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="eyebrow" Text="RESULT PREVIEW" />
                    <TextBlock Classes="settingsCardTitle" Text="Exercise terminal presentation states" />
                    <TextBlock Classes="settingsCardDescription" Text="Preview a result without network activity, changing measurement settings, or writing a report." />
                  </StackPanel>
                  <ComboBox Name="FixtureComboBox">
                    <ComboBoxItem Content="Healthy connection" />
                    <ComboBoxItem Content="Investigate responsiveness" />
                    <ComboBoxItem Content="Investigate reliability" />
                    <ComboBoxItem Content="Transfer unavailable" />
                    <ComboBoxItem Content="Connection unavailable" />
                  </ComboBox>
                  <Button Classes="primary" Content="Preview result" Click="PreviewClicked" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Classes="settingsCard">
                <StackPanel Spacing="11">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="eyebrow" Text="VISUAL COVERAGE" />
                    <TextBlock Classes="settingsCardTitle" Text="States worth reviewing" />
                    <TextBlock Classes="settingsCardDescription" Text="Use the preview fixture to verify each outcome treatment without starting a live measurement." />
                  </StackPanel>
                  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="9" RowSpacing="8">
                    <Border Width="7" Height="7" CornerRadius="4" Classes="indicatorSuccess" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" FontSize="10" Text="Healthy and completed" />
                    <Border Grid.Row="1" Width="7" Height="7" CornerRadius="4" Classes="indicatorAccent" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Grid.Column="1" FontSize="10" Text="Degraded or investigate" />
                    <Border Grid.Row="2" Width="7" Height="7" CornerRadius="4" Classes="indicatorNeutral" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" Grid.Column="1" FontSize="10" Text="Unavailable measurements" />
                    <Border Grid.Row="3" Width="7" Height="7" CornerRadius="4" Background="{DynamicResource AppDangerBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="3" Grid.Column="1" FontSize="10" Text="Failed diagnostic" />
                  </Grid>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>