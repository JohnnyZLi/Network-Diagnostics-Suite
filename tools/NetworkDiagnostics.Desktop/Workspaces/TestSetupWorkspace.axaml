<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NetworkDiagnostics.Desktop.Workspaces.TestSetupWorkspace"
             Background="#111415"
             Foreground="#E9E6E0"
             FontFamily="Inter">
  <UserControl.Styles>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#969B9B" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="Foreground" Value="#C77E68" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1.6" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#171B1C" />
      <Setter Property="BorderBrush" Value="#303536" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="18" />
    </Style>
    <Style Selector="Button.choice">
      <Setter Property="MinHeight" Value="62" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Background" Value="#15191A" />
      <Setter Property="Foreground" Value="#B6BBBB" />
      <Setter Property="BorderBrush" Value="#303536" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.choice:pointerover">
      <Setter Property="Background" Value="#1D2223" />
      <Setter Property="Foreground" Value="#F0EDE7" />
      <Setter Property="BorderBrush" Value="#464C4D" />
    </Style>
    <Style Selector="Button.choice.selected">
      <Setter Property="Background" Value="#29231C" />
      <Setter Property="Foreground" Value="#F4F0EA" />
      <Setter Property="BorderBrush" Value="#8D5948" />
    </Style>
    <Style Selector="Button.method">
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#A9AEAE" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.method:pointerover">
      <Setter Property="Background" Value="#202526" />
      <Setter Property="Foreground" Value="#F0EDE7" />
    </Style>
    <Style Selector="Button.method.selected">
      <Setter Property="Background" Value="#29231C" />
      <Setter Property="Foreground" Value="#F4F0EA" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="18,0" />
      <Setter Property="Background" Value="#C96346" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#D16D50" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="13,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#D2D6D6" />
      <Setter Property="BorderBrush" Value="#414748" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="34,28,34,34" MaxWidth="1080" HorizontalAlignment="Center" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="18">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="24">
        <StackPanel Spacing="6">
          <TextBlock Classes="eyebrow" Text="NEW DIAGNOSTIC" />
          <TextBlock FontSize="30" FontWeight="SemiBold" Text="Choose the test that answers the question." TextWrapping="Wrap" />
          <TextBlock Classes="muted" FontSize="14" LineHeight="21" MaxWidth="760"
                     Text="Start short. Use deeper profiles only when you need more evidence about responsiveness, local network conditions, path behavior, or services."
                     TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1" Classes="secondary" Content="Test settings" Click="SettingsClicked" VerticalAlignment="Top" />
      </Grid>

      <Border Name="ActiveRunBorder" Grid.Row="1" Classes="panel" IsVisible="False" BorderBrush="#8D5948">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
          <StackPanel Spacing="5">
            <TextBlock Classes="eyebrow" Text="DIAGNOSTIC IN PROGRESS" />
            <TextBlock Name="ActiveRunTitleText" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Name="ActiveRunDetailText" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            <ProgressBar Name="ActiveRunProgress" Margin="0,5,0,0" Height="5" Minimum="0" Maximum="100" />
          </StackPanel>
          <Button Grid.Column="1" Classes="secondary" Content="Open active test" Click="ActiveRunClicked" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <Grid Grid.Row="2" ColumnDefinitions="1.2*,0.8*" ColumnSpacing="18">
        <Border Grid.Column="0" Classes="panel">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
              <Button Name="ConnectionProfileButton" Grid.Row="0" Grid.Column="0" Classes="choice selected" Tag="0" Click="ProfileClicked">
                <StackPanel Spacing="3">
                  <TextBlock FontWeight="SemiBold" Text="Connection Check" />
                  <TextBlock Classes="muted" FontSize="11" Text="Fast reachability and responsiveness check" TextWrapping="Wrap" />
                </StackPanel>
              </Button>
              <Button Name="QuickProfileButton" Grid.Row="0" Grid.Column="1" Classes="choice" Tag="1" Click="ProfileClicked">
                <StackPanel Spacing="3">
                  <TextBlock FontWeight="SemiBold" Text="Quick" />
                  <TextBlock Classes="muted" FontSize="11" Text="Headline performance with limited data use" TextWrapping="Wrap" />
                </StackPanel>
              </Button>
              <Button Name="FullProfileButton" Grid.Row="1" Grid.Column="0" Classes="choice" Tag="2" Click="ProfileClicked">
                <StackPanel Spacing="3">
                  <TextBlock FontWeight="SemiBold" Text="Full" />
                  <TextBlock Classes="muted" FontSize="11" Text="Local, path, service, and transfer evidence" TextWrapping="Wrap" />
                </StackPanel>
              </Button>
              <Button Name="StressProfileButton" Grid.Row="1" Grid.Column="1" Classes="choice" Tag="3" Click="ProfileClicked">
                <StackPanel Spacing="3">
                  <TextBlock FontWeight="SemiBold" Text="Stress" />
                  <TextBlock Classes="muted" FontSize="11" Text="Longer saturation and stability analysis" TextWrapping="Wrap" />
                </StackPanel>
              </Button>
            </Grid>

            <Border BorderBrush="#303536" BorderThickness="0,1,0,0" Padding="0,14,0,0">
              <StackPanel Spacing="7">
                <TextBlock Classes="eyebrow" Text="SELECTED QUESTION" />
                <TextBlock Name="QuestionText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Name="PurposeText" Classes="muted" FontSize="13" LineHeight="20" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="1" Spacing="18">
          <Border Classes="panel">
            <StackPanel Spacing="12">
              <TextBlock Classes="eyebrow" Text="TRANSFER METHOD" />
              <Border Background="#111415" BorderBrush="#303536" BorderThickness="1" CornerRadius="9" Padding="4">
                <Grid ColumnDefinitions="*,*,*">
                  <Button Name="CompareMethodButton" Grid.Column="0" Classes="method selected" Tag="0" Content="Compare" Click="MethodClicked" />
                  <Button Name="SingleMethodButton" Grid.Column="1" Classes="method" Tag="1" Content="Single" Click="MethodClicked" />
                  <Button Name="AggregateMethodButton" Grid.Column="2" Classes="method" Tag="2" Content="Aggregate" Click="MethodClicked" />
                </Grid>
              </Border>
              <TextBlock Name="MethodDetailText" Classes="muted" FontSize="12" LineHeight="18" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Classes="panel">
            <StackPanel Spacing="10">
              <TextBlock Classes="eyebrow" Text="RUN PLAN" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="muted" FontSize="12" Text="Estimated time" />
                <TextBlock Name="EstimatedTimeText" Grid.Column="1" FontSize="12" FontWeight="SemiBold" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="muted" FontSize="12" Text="Transfer cap" />
                <TextBlock Name="TransferCapText" Grid.Column="1" FontSize="12" FontWeight="SemiBold" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="muted" FontSize="12" Text="Confirmation" />
                <TextBlock Name="ConfirmationText" Grid.Column="1" FontSize="12" FontWeight="SemiBold" />
              </Grid>
              <Border BorderBrush="#303536" BorderThickness="0,1,0,0" Margin="0,3,0,0" Padding="0,10,0,0">
                <TextBlock Name="AvailabilityText" Classes="muted" FontSize="11" LineHeight="17" TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <Border Grid.Row="3" Classes="panel">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
          <StackPanel Spacing="7">
            <TextBlock Classes="eyebrow" Text="READY CHECK" />
            <WrapPanel ItemSpacing="18" LineSpacing="6">
              <TextBlock Name="InterfaceText" Classes="muted" FontSize="12" />
              <TextBlock Name="EndpointText" Classes="muted" FontSize="12" />
              <TextBlock Name="NetworkText" Classes="muted" FontSize="12" />
            </WrapPanel>
          </StackPanel>
          <Button Name="RunButton" Grid.Column="1" Classes="primary" Content="Run diagnostic" Click="RunClicked" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
