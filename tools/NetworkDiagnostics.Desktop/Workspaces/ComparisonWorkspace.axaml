<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NetworkDiagnostics.Desktop.Workspaces.ComparisonWorkspace"
             Background="{DynamicResource AppCanvasBrush}"
             Foreground="{DynamicResource AppTextBrush}"
             FontFamily="Inter">
  <UserControl.Styles>
    <Style Selector="TextBlock.deltaPositive">
      <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}" />
    </Style>
    <Style Selector="TextBlock.deltaNegative">
      <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
    </Style>
    <Style Selector="TextBlock.deltaNeutral">
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    </Style>
    <Style Selector="Border.conditionCard">
      <Setter Property="Background" Value="{DynamicResource AppRaisedBrush}" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="18" />
    </Style>
    <Style Selector="TextBlock.columnHeader">
      <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
      <Setter Property="FontSize" Value="9" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*"
        Margin="34,30,34,34"
        RowSpacing="18"
        MaxWidth="1480"
        HorizontalAlignment="Stretch">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="20">
      <StackPanel Spacing="5">
        <TextBlock Classes="eyebrow" Text="COMPARE" />
        <TextBlock FontSize="30" FontWeight="SemiBold" Text="Compare network conditions" />
        <TextBlock Classes="muted"
                   FontSize="12"
                   Text="Use one saved diagnostic as the reference and another as the changed condition." />
      </StackPanel>
      <Button Name="ClearButton"
              Grid.Column="1"
              Classes="ghost"
              Content="Clear selection"
              VerticalAlignment="Center"
              IsEnabled="False"
              Click="ClearClicked" />
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,220,*" ColumnSpacing="12">
      <Border Grid.Column="0" Classes="conditionCard">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="5">
            <TextBlock Classes="eyebrow" Text="BASELINE" />
            <TextBlock Name="BaselineTitleText" FontSize="18" FontWeight="SemiBold" Text="Not selected" TextWrapping="Wrap" />
            <TextBlock Name="BaselineMetaText" Classes="muted" FontSize="10" LineHeight="15" Text="Choose the report that represents the reference condition." TextWrapping="Wrap" />
          </StackPanel>
          <Button Name="OpenBaselineButton"
                  Grid.Column="1"
                  Classes="ghost"
                  Content="Open"
                  VerticalAlignment="Center"
                  IsEnabled="False"
                  Click="OpenBaselineClicked" />
        </Grid>
      </Border>

      <Border Name="CompatibilityBanner"
              Grid.Column="1"
              Background="{DynamicResource AppInsetBrush}"
              CornerRadius="14"
              Padding="15">
        <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Name="CompatibilityIndicator"
                  Classes="indicatorNeutral"
                  Width="9"
                  Height="9"
                  CornerRadius="5" />
          <TextBlock Name="CompatibilityTitleText"
                     FontSize="11"
                     FontWeight="SemiBold"
                     Text="Waiting for two reports"
                     TextAlignment="Center"
                     TextWrapping="Wrap" />
          <TextBlock Name="CompatibilityDetailText"
                     Classes="muted"
                     FontSize="9"
                     LineHeight="13"
                     Text="Compatibility checks compare profile, method, endpoint, interface, and transfer ceiling."
                     TextAlignment="Center"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Grid.Column="2" Classes="conditionCard">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="5">
            <TextBlock Classes="eyebrow" Text="CANDIDATE" />
            <TextBlock Name="CandidateTitleText" FontSize="18" FontWeight="SemiBold" Text="Not selected" TextWrapping="Wrap" />
            <TextBlock Name="CandidateMetaText" Classes="muted" FontSize="10" LineHeight="15" Text="Choose a second report to measure change." TextWrapping="Wrap" />
          </StackPanel>
          <Button Name="OpenCandidateButton"
                  Grid.Column="1"
                  Classes="ghost"
                  Content="Open"
                  VerticalAlignment="Center"
                  IsEnabled="False"
                  Click="OpenCandidateClicked" />
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="360,*" ColumnSpacing="18">
      <Border Grid.Column="0"
              Background="{DynamicResource AppRaisedBrush}"
              CornerRadius="14"
              ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Margin="17,16,17,13" Spacing="4">
            <TextBlock Classes="eyebrow" Text="SAVED DIAGNOSTICS" />
            <TextBlock Name="PickerInstructionText"
                       Classes="muted"
                       FontSize="10"
                       Text="Select a baseline first."
                       TextWrapping="Wrap" />
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Name="ReportPickerPanel" />
          </ScrollViewer>
        </Grid>
      </Border>

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16">
          <Border Background="{DynamicResource AppSelectedBrush}"
                  CornerRadius="14"
                  Padding="20">
            <StackPanel Spacing="6">
              <TextBlock Classes="eyebrow" Text="INTERPRETATION" />
              <TextBlock Name="ComparisonSummaryText"
                         FontSize="17"
                         FontWeight="SemiBold"
                         LineHeight="24"
                         Text="Select two reports to calculate changes."
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Background="{DynamicResource AppRaisedBrush}"
                  CornerRadius="14"
                  ClipToBounds="True">
            <Grid RowDefinitions="42,*">
              <Border Background="{DynamicResource AppInsetBrush}"
                      BorderBrush="{DynamicResource AppBorderBrush}"
                      BorderThickness="0,0,0,1"
                      Padding="16,0">
                <Grid ColumnDefinitions="*,130,130,190" ColumnSpacing="12">
                  <TextBlock Classes="columnHeader" VerticalAlignment="Center" Text="METRIC" />
                  <TextBlock Grid.Column="1" Classes="columnHeader" VerticalAlignment="Center" Text="BASELINE" />
                  <TextBlock Grid.Column="2" Classes="columnHeader" VerticalAlignment="Center" Text="CANDIDATE" />
                  <TextBlock Grid.Column="3" Classes="columnHeader" VerticalAlignment="Center" Text="CHANGE" />
                </Grid>
              </Border>
              <StackPanel Name="MetricRowsPanel" Grid.Row="1" />
            </Grid>
          </Border>

          <Border Background="{DynamicResource AppRaisedBrush}"
                  CornerRadius="14"
                  Padding="18">
            <StackPanel Spacing="6">
              <TextBlock Classes="eyebrow" Text="LOCAL TREND" />
              <TextBlock Name="TrendText" Classes="secondary" FontSize="11" LineHeight="17" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
