<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NetworkDiagnostics.Desktop.Workspaces.ComparisonWorkspace"
             Background="{DynamicResource AppCanvasBrush}"
             Foreground="{DynamicResource AppTextBrush}"
             FontFamily="Inter">
  <UserControl.Styles>
    <Style Selector="TextBlock.deltaPositive">
      <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}" />
    </Style>
    <Style Selector="TextBlock.deltaNegative">
      <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
    </Style>
    <Style Selector="TextBlock.deltaNeutral">
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*" Margin="30,26,30,26" RowSpacing="16">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="18">
      <StackPanel Spacing="5">
        <TextBlock Classes="eyebrow" Text="COMPARISON WORKSPACE" />
        <TextBlock FontSize="28" FontWeight="SemiBold" Text="Compare two reports" />
        <TextBlock Classes="muted"
                   FontSize="12"
                   Text="Choose an explicit baseline and candidate. Differences in test context remain visible as cautions." />
      </StackPanel>
      <Button Name="ClearButton"
              Grid.Column="1"
              Classes="ghost"
              Content="Clear comparison"
              VerticalAlignment="Center"
              IsEnabled="False"
              Click="ClearClicked" />
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="330,*" ColumnSpacing="14">
      <Border Grid.Column="0" Classes="surface" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">
          <Border Background="{DynamicResource AppInsetBrush}"
                  BorderBrush="{DynamicResource AppBorderBrush}"
                  BorderThickness="0,0,0,1"
                  Padding="14,13">
            <StackPanel Spacing="4">
              <TextBlock Classes="eyebrow" Text="SAVED REPORTS" />
              <TextBlock Name="PickerInstructionText"
                         Classes="muted"
                         FontSize="11"
                         Text="Select a baseline first."
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Name="ReportPickerPanel" />
          </ScrollViewer>
        </Grid>
      </Border>

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
            <Border Grid.Column="0" Classes="surface" Padding="17">
              <StackPanel Spacing="7">
                <TextBlock Classes="eyebrow" Text="BASELINE" />
                <TextBlock Name="BaselineTitleText" FontSize="17" FontWeight="SemiBold" Text="Not selected" TextWrapping="Wrap" />
                <TextBlock Name="BaselineMetaText" Classes="muted" FontSize="11" LineHeight="17" Text="Choose the report that represents the reference condition." TextWrapping="Wrap" />
                <Button Name="OpenBaselineButton" Classes="ghost" Content="Open baseline" HorizontalAlignment="Left" IsEnabled="False" Click="OpenBaselineClicked" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="surface" Padding="17">
              <StackPanel Spacing="7">
                <TextBlock Classes="eyebrow" Text="CANDIDATE" />
                <TextBlock Name="CandidateTitleText" FontSize="17" FontWeight="SemiBold" Text="Not selected" TextWrapping="Wrap" />
                <TextBlock Name="CandidateMetaText" Classes="muted" FontSize="11" LineHeight="17" Text="Choose a second report to measure change." TextWrapping="Wrap" />
                <Button Name="OpenCandidateButton" Classes="ghost" Content="Open candidate" HorizontalAlignment="Left" IsEnabled="False" Click="OpenCandidateClicked" />
              </StackPanel>
            </Border>
          </Grid>

          <Border Name="CompatibilityBanner" Classes="surfaceSubtle" Padding="15">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
              <Border Name="CompatibilityIndicator"
                      Classes="indicatorNeutral"
                      Width="8"
                      Height="8"
                      CornerRadius="4"
                      VerticalAlignment="Top"
                      Margin="0,4,0,0" />
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Name="CompatibilityTitleText" FontSize="13" FontWeight="SemiBold" Text="Waiting for two reports" />
                <TextBlock Name="CompatibilityDetailText" Classes="muted" FontSize="11" LineHeight="17" Text="Compatibility checks compare profile, method, endpoint, interface, and transfer ceiling." TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Classes="accentSurface" Padding="17">
            <StackPanel Spacing="8">
              <TextBlock Classes="eyebrow" Text="SUMMARY" />
              <TextBlock Name="ComparisonSummaryText"
                         FontSize="14"
                         LineHeight="21"
                         Text="Select two reports to calculate changes."
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Classes="surface" ClipToBounds="True">
            <Grid RowDefinitions="40,*">
              <Border Background="{DynamicResource AppInsetBrush}"
                      BorderBrush="{DynamicResource AppBorderBrush}"
                      BorderThickness="0,0,0,1"
                      Padding="14,0">
                <Grid ColumnDefinitions="*,130,130,190" ColumnSpacing="12">
                  <TextBlock Classes="muted" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Text="METRIC" />
                  <TextBlock Grid.Column="1" Classes="muted" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Text="BASELINE" />
                  <TextBlock Grid.Column="2" Classes="muted" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Text="CANDIDATE" />
                  <TextBlock Grid.Column="3" Classes="muted" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Text="CHANGE" />
                </Grid>
              </Border>
              <StackPanel Name="MetricRowsPanel" Grid.Row="1" />
            </Grid>
          </Border>

          <Border Classes="surfaceSubtle" Padding="17">
            <StackPanel Spacing="7">
              <TextBlock Classes="eyebrow" Text="LOCAL TREND" />
              <TextBlock Name="TrendText" Classes="secondary" FontSize="12" LineHeight="18" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
