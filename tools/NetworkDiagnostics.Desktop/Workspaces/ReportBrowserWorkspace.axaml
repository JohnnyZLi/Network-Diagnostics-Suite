<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NetworkDiagnostics.Desktop.Workspaces.ReportBrowserWorkspace"
             Background="{DynamicResource AppCanvasBrush}"
             Foreground="{DynamicResource AppTextBrush}"
             FontFamily="Inter">
  <Grid RowDefinitions="Auto,Auto,*" Margin="30,26,30,26" RowSpacing="16">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="18">
      <StackPanel Spacing="5">
        <TextBlock Classes="eyebrow" Text="REPORT LIBRARY" />
        <TextBlock FontSize="28" FontWeight="SemiBold" Text="Saved diagnostics" />
        <TextBlock Classes="muted"
                   FontSize="12"
                   Text="Search, inspect, label, export, and compare local schema 2.0 reports." />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
        <Button Classes="ghost" Content="Open folder" Click="OpenFolderClicked" />
        <Button Classes="primary" Content="Import report" Click="ImportClicked" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,170,Auto" ColumnSpacing="10">
      <TextBox Name="SearchBox"
               Classes="appInput"
               PlaceholderText="Search verdicts, labels, tags, profiles, or network context"
               TextChanged="SearchChanged" />
      <ComboBox Name="SortSelector"
                Grid.Column="1"
                Classes="appInput"
                SelectionChanged="SortChanged">
        <ComboBoxItem Content="Newest first" Tag="date-desc" />
        <ComboBoxItem Content="Oldest first" Tag="date-asc" />
        <ComboBoxItem Content="Profile" Tag="profile" />
        <ComboBoxItem Content="Verdict" Tag="verdict" />
      </ComboBox>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="5" Margin="8,0,0,0">
        <TextBlock Name="VisibleCountText" FontWeight="SemiBold" />
        <TextBlock Classes="muted" Text="visible" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="*,310" ColumnSpacing="14">
      <Border Grid.Column="0" Classes="surface" ClipToBounds="True">
        <Grid RowDefinitions="40,*">
          <Border Background="{DynamicResource AppInsetBrush}"
                  BorderBrush="{DynamicResource AppBorderBrush}"
                  BorderThickness="0,0,0,1"
                  Padding="14,0">
            <Grid ColumnDefinitions="128,112,*,210" ColumnSpacing="12">
              <TextBlock Classes="muted" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Text="DATE" />
              <TextBlock Grid.Column="1" Classes="muted" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Text="PROFILE" />
              <TextBlock Grid.Column="2" Classes="muted" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Text="RESULT" />
              <TextBlock Grid.Column="3" Classes="muted" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Text="CONTEXT" />
            </Grid>
          </Border>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Name="ReportListPanel" />
          </ScrollViewer>
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="surface" Padding="18">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Grid.Row="0" Spacing="5">
            <TextBlock Classes="eyebrow" Text="SELECTION" />
            <TextBlock Name="SelectedTitleText"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Text="Select a report"
                       TextWrapping="Wrap" />
            <TextBlock Name="SelectedMetaText"
                       Classes="muted"
                       FontSize="11"
                       LineHeight="17"
                       Text="Choose a row to inspect its context and available actions."
                       TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Grid.Row="1" Margin="0,18,0,18" Spacing="14">
            <Border Classes="divider" />
            <StackPanel Spacing="5">
              <TextBlock Classes="eyebrow" Text="TEST CONTEXT" />
              <TextBlock Name="SelectedContextText" Classes="secondary" FontSize="12" LineHeight="18" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="5">
              <TextBlock Classes="eyebrow" Text="TAGS" />
              <TextBlock Name="SelectedTagsText" Classes="secondary" FontSize="12" LineHeight="18" Text="No tags" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="5">
              <TextBlock Classes="eyebrow" Text="LIBRARY" />
              <TextBlock Name="LibrarySummaryText" Classes="secondary" FontSize="12" LineHeight="18" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Row="2" Spacing="8">
            <Button Name="OpenSelectedButton" Classes="primary" Content="Open report" IsEnabled="False" Click="OpenSelectedClicked" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
              <Button Name="CompareSelectedButton" Classes="secondary" Content="Compare" IsEnabled="False" Click="CompareSelectedClicked" />
              <Button Name="EditSelectedButton" Grid.Column="1" Classes="secondary" Content="Edit label" IsEnabled="False" Click="EditSelectedClicked" />
            </Grid>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
