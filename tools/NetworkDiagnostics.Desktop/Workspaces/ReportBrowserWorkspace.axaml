<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NetworkDiagnostics.Desktop.Workspaces.ReportBrowserWorkspace"
             Background="#111415"
             Foreground="#E9E6E0"
             FontFamily="Inter">
  <UserControl.Styles>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="Foreground" Value="#C77E68" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1.6" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#969B9C" />
    </Style>
    <Style Selector="Border.workspaceCard">
      <Setter Property="Background" Value="#171B1C" />
      <Setter Property="BorderBrush" Value="#303536" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Button.action">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="13,7" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="#C96346" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.action:pointerover">
      <Setter Property="Background" Value="#D36E50" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#D4D7D6" />
      <Setter Property="BorderBrush" Value="#3B4142" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.ghost:pointerover">
      <Setter Property="Background" Value="#222728" />
      <Setter Property="BorderBrush" Value="#565D5E" />
    </Style>
    <Style Selector="Button.reportRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#E9E6E0" />
      <Setter Property="BorderBrush" Value="#2B3031" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.reportRow:pointerover">
      <Setter Property="Background" Value="#1D2223" />
    </Style>
    <Style Selector="Button.reportRow.selected">
      <Setter Property="Background" Value="#2A241E" />
      <Setter Property="BorderBrush" Value="#7D5548" />
    </Style>
    <Style Selector="TextBox.filter">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="11,7" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="#171B1C" />
      <Setter Property="Foreground" Value="#ECE9E3" />
      <Setter Property="BorderBrush" Value="#343A3B" />
    </Style>
    <Style Selector="ComboBox.filter">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="#171B1C" />
      <Setter Property="Foreground" Value="#ECE9E3" />
      <Setter Property="BorderBrush" Value="#343A3B" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*" Margin="28,24,28,24" RowSpacing="16">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="18">
      <StackPanel Spacing="5">
        <TextBlock Classes="eyebrow" Text="REPORT LIBRARY" />
        <TextBlock FontSize="27" FontWeight="SemiBold" Text="Saved diagnostics" />
        <TextBlock Classes="muted"
                   FontSize="12"
                   Text="Search, inspect, label, export, and compare local schema 2.0 reports." />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Classes="ghost" Content="Open folder" Click="OpenFolderClicked" />
        <Button Classes="action" Content="Import report" Click="ImportClicked" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,170,140" ColumnSpacing="10">
      <TextBox Name="SearchBox"
               Classes="filter"
               Watermark="Search verdicts, labels, tags, profiles, or network context"
               TextChanged="SearchChanged" />
      <ComboBox Name="SortSelector"
                Grid.Column="1"
                Classes="filter"
                SelectionChanged="SortChanged">
        <ComboBoxItem Content="Newest first" Tag="date-desc" />
        <ComboBoxItem Content="Oldest first" Tag="date-asc" />
        <ComboBoxItem Content="Profile" Tag="profile" />
        <ComboBoxItem Content="Verdict" Tag="verdict" />
      </ComboBox>
      <Border Grid.Column="2" Classes="workspaceCard" Padding="12,8">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5">
          <TextBlock Name="VisibleCountText" FontWeight="SemiBold" />
          <TextBlock Classes="muted" Text="visible" />
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="*,300" ColumnSpacing="14">
      <Border Grid.Column="0" Classes="workspaceCard" ClipToBounds="True">
        <Grid RowDefinitions="38,*">
          <Border Background="#15191A" BorderBrush="#303536" BorderThickness="0,0,0,1" Padding="14,0">
            <Grid ColumnDefinitions="128,112,*,210" ColumnSpacing="12">
              <TextBlock Classes="muted" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Text="DATE" />
              <TextBlock Grid.Column="1" Classes="muted" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Text="PROFILE" />
              <TextBlock Grid.Column="2" Classes="muted" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Text="RESULT" />
              <TextBlock Grid.Column="3" Classes="muted" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Text="CONTEXT" />
            </Grid>
          </Border>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Name="ReportListPanel" />
          </ScrollViewer>
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="workspaceCard" Padding="18">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Grid.Row="0" Spacing="5">
            <TextBlock Classes="eyebrow" Text="SELECTION" />
            <TextBlock Name="SelectedTitleText"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Text="Select a report"
                       TextWrapping="Wrap" />
            <TextBlock Name="SelectedMetaText"
                       Classes="muted"
                       FontSize="11"
                       Text="Choose a row to inspect its context and available actions."
                       TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Grid.Row="1" Margin="0,18,0,18" Spacing="14">
            <Border BorderBrush="#303536" BorderThickness="0,1,0,0" />
            <StackPanel Spacing="5">
              <TextBlock Classes="eyebrow" Text="TEST CONTEXT" />
              <TextBlock Name="SelectedContextText" Classes="muted" FontSize="12" LineHeight="18" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="5">
              <TextBlock Classes="eyebrow" Text="TAGS" />
              <TextBlock Name="SelectedTagsText" Classes="muted" FontSize="12" LineHeight="18" Text="No tags" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="5">
              <TextBlock Classes="eyebrow" Text="LIBRARY" />
              <TextBlock Name="LibrarySummaryText" Classes="muted" FontSize="12" LineHeight="18" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Row="2" Spacing="8">
            <Button Name="OpenSelectedButton" Classes="action" Content="Open report" IsEnabled="False" Click="OpenSelectedClicked" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
              <Button Name="CompareSelectedButton" Classes="ghost" Content="Compare" IsEnabled="False" Click="CompareSelectedClicked" />
              <Button Name="EditSelectedButton" Grid.Column="1" Classes="ghost" Content="Edit label" IsEnabled="False" Click="EditSelectedClicked" />
            </Grid>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
