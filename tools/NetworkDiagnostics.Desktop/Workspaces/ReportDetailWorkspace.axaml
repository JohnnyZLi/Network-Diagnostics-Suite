<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NetworkDiagnostics.Desktop.Workspaces.ReportDetailWorkspace"
             Background="{DynamicResource AppCanvasBrush}"
             Foreground="{DynamicResource AppTextBrush}"
             FontFamily="Inter">
  <Grid RowDefinitions="52,*">
    <Border Grid.Row="0"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="18,0">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <Button Classes="ghost" Content="← Reports" VerticalAlignment="Center" Click="BackClicked" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
          <TextBlock Name="ToolbarTitleText" FontSize="12" FontWeight="SemiBold" Text="Report" />
          <TextBlock Name="ToolbarMetaText" Classes="muted" FontSize="10" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
          <Button Classes="ghost" Content="Edit label" Click="EditClicked" />
          <Button Classes="ghost" Content="Export" Click="ExportClicked" />
          <Button Classes="primary" Content="Compare" Click="CompareClicked" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="34,30,34,42" Spacing="22">
        <Grid ColumnDefinitions="Auto,*,300" ColumnSpacing="14">
          <Border Name="OutcomeIndicator"
                  Grid.Column="0"
                  Width="12"
                  Height="12"
                  CornerRadius="6"
                  Classes="indicatorNeutral"
                  Margin="0,8,0,0"
                  VerticalAlignment="Top" />

          <StackPanel Grid.Column="1" Spacing="8">
            <TextBlock Name="OutcomeLabelText" Classes="eyebrow" />
            <TextBlock Name="VerdictText"
                       FontSize="32"
                       FontWeight="SemiBold"
                       LineHeight="38"
                       TextWrapping="Wrap" />
            <TextBlock Name="SummaryText"
                       Classes="secondary"
                       FontSize="15"
                       LineHeight="23"
                       MaxWidth="780"
                       TextWrapping="Wrap" />
          </StackPanel>

          <Border Grid.Column="2" Classes="accentSurface" Padding="18">
            <StackPanel Spacing="7">
              <TextBlock Classes="eyebrow" Text="RECOMMENDED NEXT STEP" />
              <TextBlock Name="NextActionText"
                         FontSize="14"
                         FontWeight="SemiBold"
                         LineHeight="21"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Grid>

        <StackPanel Spacing="11">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
            <StackPanel Spacing="4">
              <TextBlock Classes="eyebrow" Text="NETWORK HEALTH" />
              <TextBlock FontSize="17" FontWeight="SemiBold" Text="The saved run at a glance" />
            </StackPanel>
            <TextBlock Grid.Column="1"
                       Classes="muted"
                       FontSize="10"
                       Text="Responsiveness · Reliability · Throughput"
                       VerticalAlignment="Bottom" />
          </Grid>

          <Grid Name="HealthGroupGrid"
                ColumnDefinitions="*,*,*"
                RowDefinitions="Auto"
                ColumnSpacing="12"
                RowSpacing="12">
            <ContentControl Name="ResponsivenessGroupHost" Grid.Column="0" />
            <ContentControl Name="ReliabilityGroupHost" Grid.Column="1" />
            <ContentControl Name="ThroughputGroupHost" Grid.Column="2" />
          </Grid>
        </StackPanel>

        <Grid ColumnDefinitions="1.18*,0.82*" ColumnSpacing="18">
          <StackPanel Grid.Column="0" Spacing="11">
            <StackPanel Spacing="4">
              <TextBlock Classes="eyebrow" Text="FINDINGS" />
              <TextBlock FontSize="17" FontWeight="SemiBold" Text="What materially affected the verdict" />
            </StackPanel>
            <StackPanel Name="FindingsPanel" />
          </StackPanel>

          <StackPanel Grid.Column="1" Spacing="12">
            <Border Classes="surface" Padding="18">
              <StackPanel Spacing="11">
                <TextBlock Classes="eyebrow" Text="REPORT CONTEXT" />
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="18" RowSpacing="8">
                  <TextBlock Classes="muted" FontSize="11" Text="Generated" />
                  <TextBlock Name="GeneratedText" Grid.Column="1" FontSize="11" TextAlignment="Right" />
                  <TextBlock Grid.Row="1" Classes="muted" FontSize="11" Text="Profile" />
                  <TextBlock Name="ProfileText" Grid.Row="1" Grid.Column="1" FontSize="11" TextAlignment="Right" />
                  <TextBlock Grid.Row="2" Classes="muted" FontSize="11" Text="Method" />
                  <TextBlock Name="MethodText" Grid.Row="2" Grid.Column="1" FontSize="11" TextAlignment="Right" />
                  <TextBlock Grid.Row="3" Classes="muted" FontSize="11" Text="Context" />
                  <TextBlock Name="ContextText" Grid.Row="3" Grid.Column="1" FontSize="11" TextAlignment="Right" TextWrapping="Wrap" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Classes="surface" Padding="0" ClipToBounds="True">
              <Expander IsExpanded="False">
                <Expander.Header>
                  <StackPanel Margin="14,12" Spacing="3">
                    <TextBlock Classes="eyebrow" Text="TECHNICAL EVIDENCE" />
                    <TextBlock Classes="muted" FontSize="10" Text="Expand raw run and measurement details" />
                  </StackPanel>
                </Expander.Header>
                <StackPanel Name="EvidencePanel" Margin="18,2,18,18" Spacing="8" />
              </Expander>
            </Border>
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
