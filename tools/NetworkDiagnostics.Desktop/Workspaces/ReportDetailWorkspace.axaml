<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NetworkDiagnostics.Desktop.Workspaces.ReportDetailWorkspace"
             Background="{DynamicResource AppCanvasBrush}"
             Foreground="{DynamicResource AppTextBrush}"
             FontFamily="Inter">
  <Grid RowDefinitions="44,*">
    <Border Name="ReportToolbar"
            Grid.Row="0"
            Background="{DynamicResource AppCanvasBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid Name="ReportToolbarGrid"
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="14"
            Margin="24,0"
            MaxWidth="1160"
            HorizontalAlignment="Stretch">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
          <Button Name="HomeButton" Classes="ghost" Content="Home" Click="HomeClicked" IsVisible="False" />
          <Button Classes="ghost" Content="← History" Click="BackClicked" />
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="8">
          <TextBlock Name="ToolbarTitleText"
                     FontSize="11"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center"
                     Text="Connection Check" />
          <Border Width="3"
                  Height="3"
                  CornerRadius="2"
                  Classes="indicatorNeutral"
                  VerticalAlignment="Center" />
          <TextBlock Name="ToolbarMetaText"
                     Classes="muted"
                     FontSize="9"
                     VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
          <Button Classes="ghost" Content="Edit" Click="EditClicked" />
          <Button Classes="ghost" Content="Export" Click="ExportClicked" />
          <Button Classes="primary" MinHeight="32" Padding="13,5" Content="Compare" Click="CompareClicked" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Name="ReportBody"
                  Margin="24,18,24,32"
                  Spacing="15"
                  MaxWidth="1160"
                  HorizontalAlignment="Center">
        <Grid Name="ReportHeroGrid" ColumnDefinitions="*,280" ColumnSpacing="18">
          <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Name="OutcomeIndicator"
                      Width="9"
                      Height="9"
                      CornerRadius="5"
                      Classes="indicatorNeutral"
                      VerticalAlignment="Center" />
              <TextBlock Name="OutcomeLabelText" Classes="eyebrow" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Name="VerdictText"
                       FontSize="24"
                       FontWeight="SemiBold"
                       LineHeight="29"
                       MaxWidth="760"
                       TextWrapping="Wrap" />
            <TextBlock Name="SummaryText"
                       Classes="secondary"
                       FontSize="11"
                       LineHeight="17"
                       MaxWidth="780"
                       TextWrapping="Wrap" />
          </StackPanel>

          <Border Name="ReportNextActionCard"
                  Grid.Column="1"
                  Classes="accentSurface"
                  Padding="16,14"
                  VerticalAlignment="Stretch">
            <StackPanel Spacing="6" VerticalAlignment="Center">
              <TextBlock Classes="eyebrow" Text="NEXT ACTION" />
              <TextBlock Name="NextActionText"
                         FontSize="14"
                         FontWeight="SemiBold"
                         LineHeight="20"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Grid>

        <Border Name="ReportContextCard" Classes="surfaceSubtle" Padding="16,11">
          <Grid Name="ReportContextGrid"
                ColumnDefinitions="1.05*,0.75*,0.75*,1.65*"
                ColumnSpacing="22"
                RowSpacing="10">
            <StackPanel Name="GeneratedContextItem" Spacing="2">
              <TextBlock Classes="muted" FontSize="9" Text="Generated" />
              <TextBlock Name="GeneratedText" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Name="ProfileContextItem" Grid.Column="1" Spacing="2">
              <TextBlock Classes="muted" FontSize="9" Text="Profile" />
              <TextBlock Name="ProfileText" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Name="MethodContextItem" Grid.Column="2" Spacing="2">
              <TextBlock Classes="muted" FontSize="9" Text="Method" />
              <TextBlock Name="MethodText" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Name="RouteContextItem" Grid.Column="3" Spacing="2">
              <TextBlock Classes="muted" FontSize="9" Text="Run context" />
              <TextBlock Name="ContextText"
                         FontSize="11"
                         FontWeight="SemiBold"
                         TextWrapping="Wrap"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </Border>

        <StackPanel Spacing="10">
          <StackPanel Spacing="2">
            <TextBlock Classes="eyebrow" Text="KEY RESULTS" />
            <TextBlock FontSize="17" FontWeight="SemiBold" Text="Connection health" />
          </StackPanel>

          <Grid Name="HealthGroupGrid"
                ColumnDefinitions="*,*,*"
                RowDefinitions="Auto"
                ColumnSpacing="12"
                RowSpacing="12">
            <ContentControl Name="ResponsivenessGroupHost" Grid.Column="0" />
            <ContentControl Name="ReliabilityGroupHost" Grid.Column="1" />
            <ContentControl Name="ThroughputGroupHost" Grid.Column="2" />
          </Grid>
        </StackPanel>

        <Border Name="ReportFindingsCard" Classes="surface" Padding="18,16">
          <StackPanel Spacing="10">
            <StackPanel Spacing="2">
              <TextBlock FontSize="16" FontWeight="SemiBold" Text="What shaped this result" />
              <TextBlock Classes="muted"
                         FontSize="10"
                         Text="Only findings that materially affected the interpretation appear here." />
            </StackPanel>
            <StackPanel Name="FindingsPanel" />
          </StackPanel>
        </Border>

        <Border Name="ReportEvidenceCard" Classes="surface" ClipToBounds="True">
          <StackPanel>
            <Button Name="EvidenceToggleButton"
                    Classes="ghost"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Padding="18,13"
                    Click="EvidenceToggleClicked">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="2">
                  <TextBlock FontSize="14" FontWeight="SemiBold" Text="Technical evidence" />
                  <TextBlock Name="EvidenceCountText"
                             Classes="muted"
                             FontSize="9"
                             Text="Raw measurements and run details" />
                </StackPanel>
                <TextBlock Name="EvidenceToggleLabelText"
                           Grid.Column="1"
                           Classes="secondary"
                           FontSize="10"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Text="Show details" />
              </Grid>
            </Button>

            <Border Name="EvidenceBody"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="18,14,18,18"
                    IsVisible="False">
              <StackPanel Name="EvidencePanel" Spacing="8" />
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>