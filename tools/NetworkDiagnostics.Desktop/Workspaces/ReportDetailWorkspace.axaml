<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NetworkDiagnostics.Desktop.Workspaces.ReportDetailWorkspace"
             Background="{DynamicResource AppCanvasBrush}"
             Foreground="{DynamicResource AppTextBrush}"
             FontFamily="Inter">
  <UserControl.Styles>
    <Style Selector="Border.metricCard">
      <Setter Property="Width" Value="200" />
      <Setter Property="Height" Value="104" />
      <Setter Property="Margin" Value="0,0,10,10" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="Background" Value="{DynamicResource AppRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style Selector="Border.metricCard.unmeasured">
      <Setter Property="Background" Value="{DynamicResource AppInsetBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="52,*">
    <Border Grid.Row="0"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="18,0">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <Button Classes="ghost" Content="← Reports" VerticalAlignment="Center" Click="BackClicked" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
          <TextBlock Name="ToolbarTitleText" FontSize="12" FontWeight="SemiBold" Text="Report" />
          <TextBlock Name="ToolbarMetaText" Classes="muted" FontSize="10" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
          <Button Classes="ghost" Content="Edit label" Click="EditClicked" />
          <Button Classes="ghost" Content="Export" Click="ExportClicked" />
          <Button Classes="primary" Content="Compare" Click="CompareClicked" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="34,30,34,40" Spacing="18">
        <Grid ColumnDefinitions="*,300" ColumnSpacing="22">
          <StackPanel Grid.Column="0" Spacing="8">
            <TextBlock Name="OutcomeLabelText" Classes="eyebrow" />
            <TextBlock Name="VerdictText" FontSize="30" FontWeight="SemiBold" LineHeight="36" TextWrapping="Wrap" />
            <TextBlock Name="SummaryText" Classes="secondary" FontSize="15" LineHeight="23" MaxWidth="780" TextWrapping="Wrap" />
          </StackPanel>
          <Border Grid.Column="1" Classes="accentSurface" Padding="17">
            <StackPanel Spacing="7">
              <TextBlock Classes="eyebrow" Text="NEXT ACTION" />
              <TextBlock Name="NextActionText" FontSize="13" LineHeight="20" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Grid>

        <StackPanel Spacing="9">
          <TextBlock Classes="eyebrow" Text="MEASUREMENTS" />
          <WrapPanel Name="MetricsPanel" ItemWidth="210" ItemHeight="114" />
        </StackPanel>

        <Grid ColumnDefinitions="1.15*,0.85*" ColumnSpacing="14">
          <Border Grid.Column="0" Classes="surface" Padding="18">
            <StackPanel Spacing="13">
              <TextBlock Classes="eyebrow" Text="FINDINGS" />
              <StackPanel Name="FindingsPanel" />
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Classes="surface" Padding="18">
            <StackPanel Spacing="16">
              <StackPanel Spacing="11">
                <TextBlock Classes="eyebrow" Text="REPORT CONTEXT" />
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="18" RowSpacing="8">
                  <TextBlock Classes="muted" FontSize="11" Text="Generated" />
                  <TextBlock Name="GeneratedText" Grid.Column="1" FontSize="11" TextAlignment="Right" />
                  <TextBlock Grid.Row="1" Classes="muted" FontSize="11" Text="Profile" />
                  <TextBlock Name="ProfileText" Grid.Row="1" Grid.Column="1" FontSize="11" TextAlignment="Right" />
                  <TextBlock Grid.Row="2" Classes="muted" FontSize="11" Text="Method" />
                  <TextBlock Name="MethodText" Grid.Row="2" Grid.Column="1" FontSize="11" TextAlignment="Right" />
                  <TextBlock Grid.Row="3" Classes="muted" FontSize="11" Text="Context" />
                  <TextBlock Name="ContextText" Grid.Row="3" Grid.Column="1" FontSize="11" TextAlignment="Right" TextWrapping="Wrap" />
                </Grid>
              </StackPanel>

              <Border Classes="divider" />

              <StackPanel Spacing="11">
                <TextBlock Classes="eyebrow" Text="TECHNICAL EVIDENCE" />
                <StackPanel Name="EvidencePanel" Spacing="8" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
