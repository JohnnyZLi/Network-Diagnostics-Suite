<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NetworkDiagnostics.Desktop.Workspaces.ReportDetailWorkspace"
             Background="{DynamicResource AppCanvasBrush}"
             Foreground="{DynamicResource AppTextBrush}"
             FontFamily="Inter">
  <Grid RowDefinitions="48,*">
    <Border Name="ReportToolbar"
            Grid.Row="0"
            Background="{DynamicResource AppRaisedBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid Name="ReportToolbarGrid"
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="14"
            Margin="18,0"
            MaxWidth="1320"
            HorizontalAlignment="Stretch">
        <Button Name="BackButton"
                Classes="ghost"
                Content="← History"
                Click="BackClicked"
                VerticalAlignment="Center" />

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="8">
          <TextBlock Name="ToolbarTitleText"
                     FontSize="12"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center"
                     Text="Connection Check" />
          <Border Width="3"
                  Height="3"
                  CornerRadius="2"
                  Classes="indicatorNeutral"
                  VerticalAlignment="Center" />
          <TextBlock Name="ToolbarMetaText"
                     Classes="muted"
                     FontSize="9.5"
                     VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
          <Button Classes="ghost" Content="Edit" Click="EditClicked" />
          <Button Classes="ghost" Content="Export" Click="ExportClicked" />
          <Button Name="CompareButton" Classes="primary" MinHeight="32" Padding="13,5" Content="Compare" Click="CompareClicked" />
          <Button Name="RunAgainButton"
                  Classes="primary"
                  MinHeight="32"
                  Padding="13,5"
                  Content="Run again"
                  Click="RunAgainClicked"
                  IsVisible="False" />
          <Button Name="CloseButton"
                  Classes="ghost"
                  Content="×"
                  Width="30"
                  Height="30"
                  Padding="0"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  Click="CloseClicked" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Name="ReportBody"
                  Margin="24,18,24,40"
                  Spacing="18"
                  MaxWidth="1320"
                  HorizontalAlignment="Center">
        <Grid Name="ReportHeroGrid" ColumnDefinitions="*,360" ColumnSpacing="34">
          <StackPanel Grid.Column="0" Spacing="7" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Name="OutcomeIndicator"
                      Width="9"
                      Height="9"
                      CornerRadius="5"
                      Classes="indicatorNeutral"
                      VerticalAlignment="Center" />
              <TextBlock Name="OutcomeLabelText" Classes="eyebrow" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Name="VerdictText"
                       FontSize="27"
                       FontWeight="SemiBold"
                       LineHeight="33"
                       MaxWidth="820"
                       TextWrapping="Wrap" />
            <TextBlock Name="SummaryText"
                       Classes="secondary"
                       FontSize="11.5"
                       LineHeight="18"
                       MaxWidth="860"
                       TextWrapping="Wrap" />
          </StackPanel>

          <Border Name="ReportNextActionCard"
                  Grid.Column="1"
                  Background="Transparent"
                  BorderBrush="{DynamicResource AppAccentBrush}"
                  BorderThickness="2,0,0,0"
                  Padding="18,2,0,2"
                  VerticalAlignment="Center">
            <StackPanel Spacing="6">
              <TextBlock Classes="eyebrow" Text="RECOMMENDED NEXT STEP" />
              <TextBlock Name="NextActionText"
                         FontSize="13"
                         FontWeight="SemiBold"
                         LineHeight="19"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Grid>

        <Grid Name="ReportContextGrid"
              ColumnDefinitions="1.05*,0.75*,0.75*,1.65*"
              ColumnSpacing="24"
              RowSpacing="10"
              Margin="0,1,0,0">
          <StackPanel Name="GeneratedContextItem" Spacing="2">
            <TextBlock Classes="muted" FontSize="8.5" Text="GENERATED" />
            <TextBlock Name="GeneratedText" FontSize="10.5" FontWeight="SemiBold" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Name="ProfileContextItem" Grid.Column="1" Spacing="2">
            <TextBlock Classes="muted" FontSize="8.5" Text="PROFILE" />
            <TextBlock Name="ProfileText" FontSize="10.5" FontWeight="SemiBold" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Name="MethodContextItem" Grid.Column="2" Spacing="2">
            <TextBlock Classes="muted" FontSize="8.5" Text="METHOD" />
            <TextBlock Name="MethodText" FontSize="10.5" FontWeight="SemiBold" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Name="RouteContextItem" Grid.Column="3" Spacing="2">
            <TextBlock Classes="muted" FontSize="8.5" Text="NETWORK CONTEXT" />
            <TextBlock Name="ContextText"
                       FontSize="10.5"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>

        <Border Classes="divider" />

        <StackPanel Spacing="10">
          <StackPanel Spacing="2">
            <TextBlock Classes="eyebrow" Text="AT A GLANCE" />
            <TextBlock FontSize="17" FontWeight="SemiBold" Text="What the test measured" />
          </StackPanel>

          <Border Name="ReportOverviewSurface" Classes="surface" Padding="18,16">
            <StackPanel Spacing="15">
              <Grid Name="SignalGrid" ColumnDefinitions="*,*,*" ColumnSpacing="20" RowSpacing="12">
                <Border Name="ResponsivenessSignal" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0" Padding="0,0,18,0">
                  <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <Border Name="ResponsivenessSignalIndicator" Width="7" Height="7" CornerRadius="4" Classes="indicatorNeutral" VerticalAlignment="Center" />
                      <TextBlock FontSize="10" FontWeight="SemiBold" Text="Responsiveness" />
                    </StackPanel>
                    <TextBlock Name="ResponsivenessStateText" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Name="ResponsivenessSignalText" Classes="muted" FontSize="9.5" LineHeight="14" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <Border Name="ReliabilitySignal" Grid.Column="1" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0" Padding="0,0,18,0">
                  <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <Border Name="ReliabilitySignalIndicator" Width="7" Height="7" CornerRadius="4" Classes="indicatorNeutral" VerticalAlignment="Center" />
                      <TextBlock FontSize="10" FontWeight="SemiBold" Text="Reliability" />
                    </StackPanel>
                    <TextBlock Name="ReliabilityStateText" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Name="ReliabilitySignalText" Classes="muted" FontSize="9.5" LineHeight="14" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <Border Name="ThroughputSignal" Grid.Column="2" Padding="0">
                  <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <Border Name="ThroughputSignalIndicator" Width="7" Height="7" CornerRadius="4" Classes="indicatorNeutral" VerticalAlignment="Center" />
                      <TextBlock FontSize="10" FontWeight="SemiBold" Text="Throughput" />
                    </StackPanel>
                    <TextBlock Name="ThroughputStateText" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Name="ThroughputSignalText" Classes="muted" FontSize="9.5" LineHeight="14" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </Grid>

              <Border Classes="divider" />

              <Grid Name="MetricGrid" ColumnSpacing="22" RowSpacing="14" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Name="FindingsSection" Spacing="8">
          <StackPanel Spacing="2">
            <TextBlock Classes="eyebrow" Text="FINDINGS" />
            <TextBlock Name="FindingsTitleText" FontSize="17" FontWeight="SemiBold" Text="What needs attention" />
            <TextBlock Name="FindingsDetailText"
                       Classes="muted"
                       FontSize="10"
                       Text="Only findings that changed the interpretation are shown." />
          </StackPanel>
          <StackPanel Name="FindingsPanel" />
        </StackPanel>

        <Border Name="ReportEvidenceCard" Classes="surfaceSubtle" ClipToBounds="True">
          <StackPanel>
            <Button Name="EvidenceToggleButton"
                    Classes="ghost"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Padding="16,12"
                    Click="EvidenceToggleClicked">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="2">
                  <TextBlock FontSize="13" FontWeight="SemiBold" Text="Technical evidence" />
                  <TextBlock Name="EvidenceCountText"
                             Classes="muted"
                             FontSize="9"
                             Text="Raw measurements and run details" />
                </StackPanel>
                <TextBlock Name="EvidenceToggleLabelText"
                           Grid.Column="1"
                           Classes="secondary"
                           FontSize="10"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Text="Show details" />
              </Grid>
            </Button>

            <Border Name="EvidenceBody"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,4,16,8"
                    IsVisible="False">
              <StackPanel Name="EvidencePanel" />
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
