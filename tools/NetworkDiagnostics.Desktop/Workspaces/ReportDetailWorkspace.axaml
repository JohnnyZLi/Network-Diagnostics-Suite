<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NetworkDiagnostics.Desktop.Workspaces.ReportDetailWorkspace"
             Background="{DynamicResource AppCanvasBrush}"
             Foreground="{DynamicResource AppTextBrush}"
             FontFamily="Inter">
  <Grid RowDefinitions="48,*">
    <Border Name="ReportToolbar"
            Grid.Row="0"
            Background="{DynamicResource AppCanvasBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="18,0">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
          <Button Name="HomeButton" Classes="ghost" Content="Home" Click="HomeClicked" IsVisible="False" />
          <Button Classes="ghost" Content="← History" Click="BackClicked" />
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
          <TextBlock Name="ToolbarTitleText" FontSize="10" FontWeight="SemiBold" Text="Saved diagnostic" />
          <TextBlock Name="ToolbarMetaText" Classes="muted" FontSize="8" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
          <Button Classes="ghost" Content="Edit" Click="EditClicked" />
          <Button Classes="ghost" Content="Export" Click="ExportClicked" />
          <Button Classes="primary" MinHeight="34" Padding="13,6" Content="Compare" Click="CompareClicked" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Name="ReportBody"
                  Margin="28,22,28,36"
                  Spacing="18"
                  MaxWidth="1320"
                  HorizontalAlignment="Stretch">
        <Grid Name="ReportHeroGrid" ColumnDefinitions="*,300" ColumnSpacing="24">
          <StackPanel Grid.Column="0" Spacing="7" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <Border Name="OutcomeIndicator"
                      Width="10"
                      Height="10"
                      CornerRadius="5"
                      Classes="indicatorNeutral"
                      VerticalAlignment="Center" />
              <TextBlock Name="OutcomeLabelText" Classes="eyebrow" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Name="VerdictText"
                       FontSize="30"
                       FontWeight="SemiBold"
                       LineHeight="36"
                       TextWrapping="Wrap" />
            <TextBlock Name="SummaryText"
                       Classes="secondary"
                       FontSize="12"
                       LineHeight="18"
                       MaxWidth="800"
                       TextWrapping="Wrap" />
          </StackPanel>

          <Border Name="ReportNextActionCard"
                  Grid.Column="1"
                  Classes="accentSurface"
                  Padding="18"
                  VerticalAlignment="Stretch">
            <StackPanel Spacing="7" VerticalAlignment="Center">
              <TextBlock Classes="eyebrow" Text="NEXT ACTION" />
              <TextBlock Name="NextActionText"
                         FontSize="16"
                         FontWeight="SemiBold"
                         LineHeight="22"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Grid>

        <StackPanel Spacing="11">
          <StackPanel Spacing="3">
            <TextBlock Classes="eyebrow" Text="NETWORK HEALTH" />
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="The saved run at a glance" />
          </StackPanel>

          <Grid Name="HealthGroupGrid"
                ColumnDefinitions="*,*,*"
                RowDefinitions="Auto"
                ColumnSpacing="12"
                RowSpacing="12">
            <ContentControl Name="ResponsivenessGroupHost" Grid.Column="0" />
            <ContentControl Name="ReliabilityGroupHost" Grid.Column="1" />
            <ContentControl Name="ThroughputGroupHost" Grid.Column="2" />
          </Grid>
        </StackPanel>

        <Grid Name="ReportLowerGrid" ColumnDefinitions="1.12*,0.88*" ColumnSpacing="14" RowSpacing="14">
          <Border Name="ReportFindingsCard"
                  Grid.Column="0"
                  Classes="surface"
                  Padding="20">
            <StackPanel Spacing="12">
              <StackPanel Spacing="3">
                <TextBlock Classes="eyebrow" Text="FINDINGS" />
                <TextBlock FontSize="17" FontWeight="SemiBold" Text="What materially affected the verdict" />
              </StackPanel>
              <StackPanel Name="FindingsPanel" />
            </StackPanel>
          </Border>

          <StackPanel Name="ReportSideStack" Grid.Column="1" Spacing="14">
            <Border Classes="surface" Padding="18">
              <StackPanel Spacing="10">
                <TextBlock Classes="eyebrow" Text="REPORT CONTEXT" />
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="18" RowSpacing="7">
                  <TextBlock Classes="muted" FontSize="10" Text="Generated" />
                  <TextBlock Name="GeneratedText" Grid.Column="1" FontSize="10" TextAlignment="Right" />
                  <TextBlock Grid.Row="1" Classes="muted" FontSize="10" Text="Profile" />
                  <TextBlock Name="ProfileText" Grid.Row="1" Grid.Column="1" FontSize="10" TextAlignment="Right" />
                  <TextBlock Grid.Row="2" Classes="muted" FontSize="10" Text="Method" />
                  <TextBlock Name="MethodText" Grid.Row="2" Grid.Column="1" FontSize="10" TextAlignment="Right" />
                  <TextBlock Grid.Row="3" Classes="muted" FontSize="10" Text="Context" />
                  <TextBlock Name="ContextText" Grid.Row="3" Grid.Column="1" FontSize="10" TextAlignment="Right" TextWrapping="Wrap" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Classes="surface" ClipToBounds="True">
              <Expander IsExpanded="False">
                <Expander.Header>
                  <StackPanel Margin="17,13" Spacing="2">
                    <TextBlock Classes="eyebrow" Text="TECHNICAL EVIDENCE" />
                    <TextBlock Classes="muted" FontSize="9" Text="Raw measurements and run details" />
                  </StackPanel>
                </Expander.Header>
                <StackPanel Name="EvidencePanel" Margin="18,0,18,18" Spacing="8" />
              </Expander>
            </Border>
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>