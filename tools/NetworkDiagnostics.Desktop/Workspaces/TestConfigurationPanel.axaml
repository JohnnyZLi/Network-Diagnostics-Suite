<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NetworkDiagnostics.Desktop.Workspaces.TestConfigurationPanel"
             Foreground="{DynamicResource AppTextBrush}"
             FontFamily="Inter">
  <UserControl.Styles>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="FontSize" Value="9" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1.4" />
    </Style>
    <Style Selector="Border.inspectorGroup">
      <Setter Property="Background" Value="{DynamicResource AppRaisedBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="11,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.secondary:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Background" Value="{DynamicResource AppInsetBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="11" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="10">
    <Border Classes="inspectorGroup">
      <StackPanel Spacing="7">
        <TextBlock Classes="eyebrow" Text="INTERFACE" />
        <ComboBox Name="InterfaceComboBox" SelectionChanged="InterfaceSelectionChanged" />
        <TextBlock Classes="muted" FontSize="10" LineHeight="15" Text="Automatic follows the system route. Choose an interface only when reproducing adapter-specific behavior." TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Classes="inspectorGroup">
      <StackPanel Spacing="7">
        <TextBlock Classes="eyebrow" Text="REPORT PRIVACY" />
        <CheckBox Name="IdentifiersCheckBox" Content="Include local identifiers" Click="IdentifiersClicked" />
        <TextBlock Classes="muted" FontSize="10" LineHeight="15" Text="Keep this off for privacy-safe reports. Measurements remain available without supported local names and addresses." TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Classes="inspectorGroup">
      <StackPanel Spacing="9">
        <TextBlock Classes="eyebrow" Text="PREFLIGHT" />
        <StackPanel Spacing="2">
          <TextBlock Classes="muted" FontSize="9" Text="Endpoint" />
          <TextBlock Name="EndpointText" FontSize="10" LineHeight="15" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Spacing="2">
          <TextBlock Classes="muted" FontSize="9" Text="Network" />
          <TextBlock Name="NetworkText" FontSize="10" LineHeight="15" TextWrapping="Wrap" />
        </StackPanel>
        <Button Classes="secondary" Content="Refresh preflight" Click="RefreshClicked" HorizontalAlignment="Stretch" />
      </StackPanel>
    </Border>

    <StackPanel Spacing="7" Margin="0,4,0,0">
      <TextBlock Classes="muted" FontSize="10" LineHeight="15" Text="Endpoint candidates, LAN isolation, approvals, and storage are managed in Settings." TextWrapping="Wrap" />
      <Button Classes="secondary" Content="Open advanced settings" Click="SettingsClicked" HorizontalAlignment="Stretch" />
    </StackPanel>
  </StackPanel>
</UserControl>
