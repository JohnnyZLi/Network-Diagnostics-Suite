<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NetworkDiagnostics.Desktop.Workspaces.TestResultWorkspace"
             Background="{DynamicResource AppCanvasBrush}"
             Foreground="{DynamicResource AppTextBrush}"
             FontFamily="Inter">
  <Grid RowDefinitions="Auto,Auto,*"
        Margin="34,30,34,34"
        MaxWidth="1380"
        HorizontalAlignment="Stretch">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="15">
      <Border Name="OutcomeIndicator"
              Grid.Column="0"
              Width="11"
              Height="11"
              CornerRadius="6"
              Classes="indicatorNeutral"
              Margin="0,8,0,0"
              VerticalAlignment="Top" />

      <StackPanel Grid.Column="1" Spacing="6">
        <TextBlock Name="LabelText" Classes="eyebrow" />
        <TextBlock Name="VerdictText"
                   FontSize="34"
                   FontWeight="SemiBold"
                   LineHeight="40"
                   TextWrapping="Wrap" />
        <TextBlock Name="SummaryText"
                   Classes="secondary"
                   FontSize="13"
                   LineHeight="20"
                   MaxWidth="860"
                   TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
        <Button Name="ReportsButton" Classes="ghost" Content="History" Click="ReportsClicked" />
        <Button Name="CompareButton" Classes="ghost" Content="Compare" Click="CompareClicked" />
        <Button Name="ExportButton" Classes="ghost" Content="Export" Click="ExportClicked" />
        <Button Classes="primary" Content="Run again" Click="RunAgainClicked" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="26,18,0,0" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="4">
      <Button Name="OverviewButton" Grid.Column="0" Classes="tab selected" Content="Overview" Tag="Overview" Click="SectionClicked" />
      <Button Name="EvidenceButton" Grid.Column="1" Classes="tab" Content="Evidence" Tag="Evidence" Click="SectionClicked" />
      <Button Name="QuickButton" Grid.Column="3" Classes="secondary" Content="Run Quick next" Click="QuickClicked" IsVisible="False" />
    </Grid>

    <Grid Grid.Row="2" Margin="0,16,0,0">
      <ScrollViewer Name="OverviewView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20">
          <Grid ColumnDefinitions="1.28*,0.72*" ColumnSpacing="14">
            <Border Grid.Column="0"
                    Background="{DynamicResource AppSelectedBrush}"
                    BorderBrush="{DynamicResource AppAccentBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="15"
                    Padding="22">
              <StackPanel Spacing="7">
                <TextBlock Classes="eyebrow" Text="NEXT ACTION" />
                <TextBlock Name="NextActionText"
                           FontSize="20"
                           FontWeight="SemiBold"
                           LineHeight="26"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="{DynamicResource AppRaisedBrush}"
                    CornerRadius="15"
                    Padding="19">
              <StackPanel Spacing="7">
                <TextBlock Classes="eyebrow" Text="RUN CONTEXT" />
                <TextBlock Name="ContextText"
                           Classes="secondary"
                           FontSize="10"
                           LineHeight="16"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Grid>

          <StackPanel Spacing="12">
            <StackPanel Spacing="4">
              <TextBlock Classes="eyebrow" Text="NETWORK HEALTH" />
              <TextBlock FontSize="18" FontWeight="SemiBold" Text="What this run says about the connection" />
            </StackPanel>

            <Grid Name="HealthGroupGrid"
                  ColumnDefinitions="*,*,*"
                  RowDefinitions="Auto"
                  ColumnSpacing="12"
                  RowSpacing="12">
              <ContentControl Name="ResponsivenessGroupHost" Grid.Column="0" />
              <ContentControl Name="ReliabilityGroupHost" Grid.Column="1" />
              <ContentControl Name="ThroughputGroupHost" Grid.Column="2" />
            </Grid>
          </StackPanel>

          <Border Background="{DynamicResource AppRaisedBrush}"
                  CornerRadius="15"
                  Padding="20">
            <StackPanel Spacing="12">
              <StackPanel Spacing="4">
                <TextBlock Classes="eyebrow" Text="FINDINGS" />
                <TextBlock Classes="muted"
                           FontSize="10"
                           Text="Only classifier findings that materially affect the interpretation appear here." />
              </StackPanel>
              <StackPanel Name="FindingsPanel" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer Name="EvidenceView"
                    IsVisible="False"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16">
          <StackPanel Spacing="4">
            <TextBlock Classes="eyebrow" Text="TECHNICAL EVIDENCE" />
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Verify the result" />
            <TextBlock Classes="muted"
                       FontSize="10"
                       Text="Inspect retained measurements, run metadata, and unavailable sections without changing the overview verdict." />
          </StackPanel>

          <Grid ColumnDefinitions="1.15*,0.85*" ColumnSpacing="16">
            <Border Grid.Column="0"
                    Background="{DynamicResource AppRaisedBrush}"
                    CornerRadius="15"
                    Padding="20">
              <StackPanel Spacing="13">
                <TextBlock Classes="eyebrow" Text="MEASUREMENTS" />
                <StackPanel Name="EvidencePanel" Spacing="10" />
              </StackPanel>
            </Border>

            <StackPanel Grid.Column="1" Spacing="16">
              <Border Background="{DynamicResource AppRaisedBrush}"
                      CornerRadius="15"
                      Padding="20">
                <StackPanel Spacing="11">
                  <TextBlock Classes="eyebrow" Text="RUN DETAILS" />
                  <StackPanel Name="RunDetailPanel" Spacing="8" />
                </StackPanel>
              </Border>

              <Border Background="{DynamicResource AppSelectedBrush}"
                      CornerRadius="15"
                      Padding="20">
                <StackPanel Spacing="7">
                  <TextBlock Classes="eyebrow" Text="INTERPRETATION" />
                  <TextBlock Name="InterpretationText"
                             Classes="secondary"
                             FontSize="11"
                             LineHeight="17"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
