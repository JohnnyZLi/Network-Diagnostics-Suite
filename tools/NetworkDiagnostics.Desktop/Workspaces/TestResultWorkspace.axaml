<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NetworkDiagnostics.Desktop.Workspaces.TestResultWorkspace"
             Background="{DynamicResource AppCanvasBrush}"
             Foreground="{DynamicResource AppTextBrush}"
             FontFamily="Inter">
  <UserControl.Styles>
    <Style Selector="Border.metricCell">
      <Setter Property="Padding" Value="16" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>
    <Style Selector="Border.metricCell.last">
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*" Margin="30,26,30,30">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="20">
      <StackPanel Spacing="6">
        <TextBlock Name="LabelText" Classes="eyebrow" />
        <TextBlock Name="VerdictText" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Name="SummaryText"
                   Classes="secondary"
                   FontSize="14"
                   LineHeight="21"
                   MaxWidth="820"
                   TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Top">
        <Button Name="ReportsButton" Classes="ghost" Content="Reports" Click="ReportsClicked" />
        <Button Name="CompareButton" Classes="ghost" Content="Compare" Click="CompareClicked" />
        <Button Name="ExportButton" Classes="ghost" Content="Export" Click="ExportClicked" />
        <Button Classes="primary" Content="Run again" Click="RunAgainClicked" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="0,18,0,0" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="4">
      <Button Name="OverviewButton" Grid.Column="0" Classes="tab selected" Content="Overview" Tag="Overview" Click="SectionClicked" />
      <Button Name="EvidenceButton" Grid.Column="1" Classes="tab" Content="Evidence" Tag="Evidence" Click="SectionClicked" />
      <Button Name="QuickButton" Grid.Column="3" Classes="secondary" Content="Run Quick next" Click="QuickClicked" IsVisible="False" />
    </Grid>

    <Grid Grid.Row="2" Margin="0,14,0,0">
      <ScrollViewer Name="OverviewView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14">
          <Border Classes="accentSurface" Padding="18">
            <Grid ColumnDefinitions="1.25*,0.75*" ColumnSpacing="24">
              <StackPanel Spacing="6">
                <TextBlock Classes="eyebrow" Text="NEXT ACTION" />
                <TextBlock Name="NextActionText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Classes="eyebrow" Text="REPORT CONTEXT" />
                <TextBlock Name="ContextText" Classes="secondary" FontSize="11" LineHeight="17" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Classes="surface" Padding="0" ClipToBounds="True">
            <Grid Name="MetricGrid" ColumnDefinitions="*,*,*,*" />
          </Border>

          <Border Classes="surface" Padding="18">
            <StackPanel Spacing="12">
              <TextBlock Classes="eyebrow" Text="FINDINGS" />
              <StackPanel Name="FindingsPanel" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer Name="EvidenceView" IsVisible="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid ColumnDefinitions="1.15*,0.85*" ColumnSpacing="14">
          <Border Grid.Column="0" Classes="surface" Padding="18">
            <StackPanel Spacing="12">
              <TextBlock Classes="eyebrow" Text="TECHNICAL EVIDENCE" />
              <StackPanel Name="EvidencePanel" Spacing="10" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="surface" Padding="18">
            <StackPanel Spacing="16">
              <StackPanel Spacing="10">
                <TextBlock Classes="eyebrow" Text="RUN DETAILS" />
                <StackPanel Name="RunDetailPanel" Spacing="8" />
              </StackPanel>
              <Border Classes="divider" />
              <StackPanel Spacing="7">
                <TextBlock Classes="eyebrow" Text="INTERPRETATION" />
                <TextBlock Name="InterpretationText" Classes="secondary" FontSize="12" LineHeight="18" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
