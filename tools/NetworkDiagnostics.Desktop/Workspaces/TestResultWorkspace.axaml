<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NetworkDiagnostics.Desktop.Workspaces.TestResultWorkspace"
             Background="{DynamicResource AppCanvasBrush}"
             Foreground="{DynamicResource AppTextBrush}"
             FontFamily="Inter">
  <Grid Name="ResultRoot"
        RowDefinitions="Auto,Auto,*"
        Margin="28,22,28,28"
        MaxWidth="1320"
        HorizontalAlignment="Stretch">
    <Grid Name="ResultHeaderGrid" Grid.Row="0" ColumnDefinitions="*,220" ColumnSpacing="28">
      <StackPanel Grid.Column="0" Spacing="7">
        <StackPanel Orientation="Horizontal" Spacing="9">
          <Border Name="OutcomeIndicator"
                  Width="10"
                  Height="10"
                  CornerRadius="5"
                  Classes="indicatorNeutral"
                  VerticalAlignment="Center" />
          <TextBlock Name="LabelText" Classes="eyebrow" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Name="VerdictText"
                   FontSize="30"
                   FontWeight="SemiBold"
                   LineHeight="36"
                   TextWrapping="Wrap" />
        <TextBlock Name="SummaryText"
                   Classes="secondary"
                   FontSize="12"
                   LineHeight="18"
                   MaxWidth="820"
                   TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Name="ResultActionsPanel" Grid.Column="1" Spacing="6" VerticalAlignment="Top">
        <Button Name="RunAgainButton"
                Classes="primary"
                Content="Run again"
                Click="RunAgainClicked"
                HorizontalAlignment="Stretch" />
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="3">
          <Button Name="ReportsButton" Grid.Column="0" Classes="ghost" Content="History" Click="ReportsClicked" />
          <Button Name="CompareButton" Grid.Column="1" Classes="ghost" Content="Compare" Click="CompareClicked" />
          <Button Name="ExportButton" Grid.Column="2" Classes="ghost" Content="Export" Click="ExportClicked" />
        </Grid>
      </StackPanel>
    </Grid>

    <Border Name="ResultTabsSurface"
            Grid.Row="1"
            Classes="surfaceSubtle"
            Margin="0,18,0,0"
            Padding="3"
            HorizontalAlignment="Left">
      <StackPanel Orientation="Horizontal" Spacing="1">
        <Button Name="OverviewButton" Classes="tab selected" Content="Overview" Tag="Overview" Click="SectionClicked" />
        <Button Name="EvidenceButton" Classes="tab" Content="Evidence" Tag="Evidence" Click="SectionClicked" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="2" Margin="0,16,0,0">
      <ScrollViewer Name="OverviewView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="18" Margin="0,0,4,0">
          <Grid Name="ResultSummaryGrid" ColumnDefinitions="1.22*,0.78*" ColumnSpacing="12" RowSpacing="12">
            <Border Name="NextActionCard"
                    Grid.Column="0"
                    Classes="accentSurface"
                    Padding="20">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                <StackPanel Grid.Column="0" Spacing="6">
                  <TextBlock Classes="eyebrow" Text="NEXT ACTION" />
                  <TextBlock Name="NextActionText"
                             FontSize="19"
                             FontWeight="SemiBold"
                             LineHeight="25"
                             TextWrapping="Wrap" />
                </StackPanel>
                <Button Name="QuickButton"
                        Grid.Column="1"
                        Classes="secondary"
                        Content="Run Quick"
                        Click="QuickClicked"
                        IsVisible="False"
                        VerticalAlignment="Center" />
              </Grid>
            </Border>

            <Border Name="RunContextCard"
                    Grid.Column="1"
                    Classes="surface"
                    Padding="18">
              <StackPanel Spacing="6">
                <TextBlock Classes="eyebrow" Text="RUN CONTEXT" />
                <TextBlock Name="ContextText"
                           Classes="secondary"
                           FontSize="10"
                           LineHeight="16"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Grid>

          <StackPanel Spacing="11">
            <StackPanel Spacing="3">
              <TextBlock Classes="eyebrow" Text="NETWORK HEALTH" />
              <TextBlock FontSize="18" FontWeight="SemiBold" Text="What this run says about the connection" />
            </StackPanel>

            <Grid Name="HealthGroupGrid"
                  ColumnDefinitions="*,*,*"
                  RowDefinitions="Auto"
                  ColumnSpacing="12"
                  RowSpacing="12">
              <ContentControl Name="ResponsivenessGroupHost" Grid.Column="0" />
              <ContentControl Name="ReliabilityGroupHost" Grid.Column="1" />
              <ContentControl Name="ThroughputGroupHost" Grid.Column="2" />
            </Grid>
          </StackPanel>

          <Border Classes="surface" Padding="20">
            <StackPanel Spacing="11">
              <StackPanel Spacing="3">
                <TextBlock Classes="eyebrow" Text="FINDINGS" />
                <TextBlock Classes="muted"
                           FontSize="10"
                           Text="Only classifier findings that materially affect the interpretation appear here." />
              </StackPanel>
              <StackPanel Name="FindingsPanel" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer Name="EvidenceView"
                    IsVisible="False"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Margin="0,0,4,0">
          <StackPanel Spacing="3">
            <TextBlock Classes="eyebrow" Text="TECHNICAL EVIDENCE" />
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Verify the result" />
            <TextBlock Classes="muted"
                       FontSize="10"
                       Text="Inspect retained measurements and run metadata without changing the overview verdict." />
          </StackPanel>

          <Grid Name="EvidenceLayoutGrid" ColumnDefinitions="1.12*,0.88*" ColumnSpacing="14" RowSpacing="14">
            <Border Name="MeasurementsCard" Grid.Column="0" Classes="surface" Padding="20">
              <StackPanel Spacing="13">
                <TextBlock Classes="eyebrow" Text="MEASUREMENTS" />
                <StackPanel Name="EvidencePanel" Spacing="10" />
              </StackPanel>
            </Border>

            <StackPanel Name="EvidenceSideStack" Grid.Column="1" Spacing="14">
              <Border Classes="surface" Padding="18">
                <StackPanel Spacing="10">
                  <TextBlock Classes="eyebrow" Text="RUN DETAILS" />
                  <StackPanel Name="RunDetailPanel" Spacing="8" />
                </StackPanel>
              </Border>

              <Border Classes="accentSurface" Padding="18">
                <StackPanel Spacing="6">
                  <TextBlock Classes="eyebrow" Text="INTERPRETATION" />
                  <TextBlock Name="InterpretationText"
                             Classes="secondary"
                             FontSize="11"
                             LineHeight="17"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>