<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NetworkDiagnostics.Desktop.Workspaces.TestResultWorkspace"
             Background="#111415"
             Foreground="#E9E6E0"
             FontFamily="Inter">
  <UserControl.Styles>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#969C9D" /></Style>
    <Style Selector="TextBlock.eyebrow"><Setter Property="Foreground" Value="#C77E68" /><Setter Property="FontSize" Value="10" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="LetterSpacing" Value="1.5" /></Style>
    <Style Selector="Border.panel"><Setter Property="Background" Value="#171B1C" /><Setter Property="BorderBrush" Value="#303536" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="18" /></Style>
    <Style Selector="Button.action"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#D9D6D0" /><Setter Property="BorderBrush" Value="#414748" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="13,8" /></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#C96346" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="14,9" /></Style>
    <Style Selector="Button.tab"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#969C9D" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="10,7" /><Setter Property="CornerRadius" Value="7" /></Style>
    <Style Selector="Button.tab.selected"><Setter Property="Background" Value="#29231C" /><Setter Property="Foreground" Value="#F2EFE9" /></Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*" Margin="28,24,28,28">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="20">
      <StackPanel Spacing="6">
        <TextBlock Name="LabelText" Classes="eyebrow" />
        <TextBlock Name="VerdictText" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Name="SummaryText" Classes="muted" FontSize="14" LineHeight="21" MaxWidth="820" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
        <Button Name="ReportsButton" Classes="action" Content="Reports" Click="ReportsClicked" />
        <Button Name="CompareButton" Classes="action" Content="Compare" Click="CompareClicked" />
        <Button Name="ExportButton" Classes="action" Content="Export" Click="ExportClicked" />
        <Button Classes="primary" Content="Run again" Click="RunAgainClicked" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="0,18,0,0" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="4">
      <Button Name="OverviewButton" Grid.Column="0" Classes="tab selected" Content="Overview" Tag="Overview" Click="SectionClicked" />
      <Button Name="EvidenceButton" Grid.Column="1" Classes="tab" Content="Evidence" Tag="Evidence" Click="SectionClicked" />
      <Button Name="QuickButton" Grid.Column="3" Classes="action" Content="Run Quick next" Click="QuickClicked" IsVisible="False" />
    </Grid>

    <Grid Grid.Row="2" Margin="0,14,0,0">
      <ScrollViewer Name="OverviewView" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">
          <Border Classes="panel">
            <Grid ColumnDefinitions="1.25*,0.75*" ColumnSpacing="24">
              <StackPanel Spacing="7">
                <TextBlock Classes="eyebrow" Text="NEXT ACTION" />
                <TextBlock Name="NextActionText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="7">
                <TextBlock Classes="eyebrow" Text="REPORT CONTEXT" />
                <TextBlock Name="ContextText" Classes="muted" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>

          <Grid Name="MetricGrid" ColumnDefinitions="*,*,*,*" ColumnSpacing="10" />

          <Border Classes="panel">
            <StackPanel Spacing="12">
              <TextBlock Classes="eyebrow" Text="FINDINGS" />
              <StackPanel Name="FindingsPanel" Spacing="12" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer Name="EvidenceView" IsVisible="False" VerticalScrollBarVisibility="Auto">
        <Grid ColumnDefinitions="1.15*,0.85*" ColumnSpacing="16">
          <Border Grid.Column="0" Classes="panel">
            <StackPanel Spacing="12">
              <TextBlock Classes="eyebrow" Text="TECHNICAL EVIDENCE" />
              <StackPanel Name="EvidencePanel" Spacing="9" />
            </StackPanel>
          </Border>
          <StackPanel Grid.Column="1" Spacing="16">
            <Border Classes="panel">
              <StackPanel Spacing="10">
                <TextBlock Classes="eyebrow" Text="RUN DETAILS" />
                <StackPanel Name="RunDetailPanel" Spacing="8" />
              </StackPanel>
            </Border>
            <Border Classes="panel">
              <StackPanel Spacing="7">
                <TextBlock Classes="eyebrow" Text="INTERPRETATION" />
                <TextBlock Name="InterpretationText" Classes="muted" FontSize="12" LineHeight="18" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>