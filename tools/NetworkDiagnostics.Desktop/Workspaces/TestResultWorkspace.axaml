<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NetworkDiagnostics.Desktop.Workspaces.TestResultWorkspace"
             Background="{DynamicResource AppCanvasBrush}"
             Foreground="{DynamicResource AppTextBrush}"
             FontFamily="Inter">
  <Grid RowDefinitions="Auto,Auto,*" Margin="30,26,30,30">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
      <Border Name="OutcomeIndicator"
              Grid.Column="0"
              Width="12"
              Height="12"
              CornerRadius="6"
              Classes="indicatorNeutral"
              Margin="0,8,0,0"
              VerticalAlignment="Top" />

      <StackPanel Grid.Column="1" Spacing="6">
        <TextBlock Name="LabelText" Classes="eyebrow" />
        <TextBlock Name="VerdictText"
                   FontSize="32"
                   FontWeight="SemiBold"
                   LineHeight="38"
                   TextWrapping="Wrap" />
        <TextBlock Name="SummaryText"
                   Classes="secondary"
                   FontSize="14"
                   LineHeight="21"
                   MaxWidth="820"
                   TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Top">
        <Button Name="ReportsButton" Classes="ghost" Content="Reports" Click="ReportsClicked" />
        <Button Name="CompareButton" Classes="ghost" Content="Compare" Click="CompareClicked" />
        <Button Name="ExportButton" Classes="ghost" Content="Export" Click="ExportClicked" />
        <Button Classes="primary" Content="Run again" Click="RunAgainClicked" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="26,18,0,0" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="4">
      <Button Name="OverviewButton" Grid.Column="0" Classes="tab selected" Content="Overview" Tag="Overview" Click="SectionClicked" />
      <Button Name="EvidenceButton" Grid.Column="1" Classes="tab" Content="Technical details" Tag="Evidence" Click="SectionClicked" />
      <Button Name="QuickButton" Grid.Column="3" Classes="secondary" Content="Run Quick next" Click="QuickClicked" IsVisible="False" />
    </Grid>

    <Grid Grid.Row="2" Margin="0,14,0,0">
      <ScrollViewer Name="OverviewView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20">
          <Grid ColumnDefinitions="1.3*,0.7*" ColumnSpacing="14">
            <Border Grid.Column="0" Classes="accentSurface" Padding="19">
              <StackPanel Spacing="7">
                <TextBlock Classes="eyebrow" Text="RECOMMENDED NEXT STEP" />
                <TextBlock Name="NextActionText"
                           FontSize="19"
                           FontWeight="SemiBold"
                           LineHeight="24"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Grid.Column="1" Classes="surfaceSubtle" Padding="17">
              <StackPanel Spacing="7">
                <TextBlock Classes="eyebrow" Text="RUN CONTEXT" />
                <TextBlock Name="ContextText"
                           Classes="secondary"
                           FontSize="11"
                           LineHeight="17"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Grid>

          <StackPanel Spacing="11">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
              <StackPanel Spacing="4">
                <TextBlock Classes="eyebrow" Text="NETWORK HEALTH" />
                <TextBlock FontSize="17" FontWeight="SemiBold" Text="What this run says about the connection" />
              </StackPanel>
              <TextBlock Grid.Column="1"
                         Classes="muted"
                         FontSize="10"
                         Text="Responsiveness · Reliability · Throughput"
                         VerticalAlignment="Bottom" />
            </Grid>

            <Grid Name="HealthGroupGrid"
                  ColumnDefinitions="*,*,*"
                  RowDefinitions="Auto"
                  ColumnSpacing="12"
                  RowSpacing="12">
              <ContentControl Name="ResponsivenessGroupHost" Grid.Column="0" />
              <ContentControl Name="ReliabilityGroupHost" Grid.Column="1" />
              <ContentControl Name="ThroughputGroupHost" Grid.Column="2" />
            </Grid>
          </StackPanel>

          <StackPanel Spacing="11" Margin="0,2,0,0">
            <StackPanel Spacing="4">
              <TextBlock Classes="eyebrow" Text="FINDINGS" />
              <TextBlock Classes="muted"
                         FontSize="11"
                         Text="Only classifier findings that materially affect the interpretation are surfaced here." />
            </StackPanel>
            <StackPanel Name="FindingsPanel" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer Name="EvidenceView"
                    IsVisible="False"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12">
          <StackPanel Spacing="4">
            <TextBlock Classes="eyebrow" Text="TECHNICAL DETAILS" />
            <TextBlock FontSize="17" FontWeight="SemiBold" Text="Evidence retained by the diagnostic" />
            <TextBlock Classes="muted"
                       FontSize="11"
                       Text="Use this view to verify the overview, inspect run metadata, or investigate an unavailable measurement." />
          </StackPanel>

          <Grid ColumnDefinitions="1.15*,0.85*" ColumnSpacing="14">
            <Border Grid.Column="0" Classes="surface" Padding="18">
              <StackPanel Spacing="12">
                <TextBlock Classes="eyebrow" Text="MEASUREMENT EVIDENCE" />
                <StackPanel Name="EvidencePanel" Spacing="10" />
              </StackPanel>
            </Border>

            <Border Grid.Column="1" Classes="surface" Padding="18">
              <StackPanel Spacing="16">
                <StackPanel Spacing="10">
                  <TextBlock Classes="eyebrow" Text="RUN DETAILS" />
                  <StackPanel Name="RunDetailPanel" Spacing="8" />
                </StackPanel>
                <Border Classes="divider" />
                <StackPanel Spacing="7">
                  <TextBlock Classes="eyebrow" Text="INTERPRETATION" />
                  <TextBlock Name="InterpretationText"
                             Classes="secondary"
                             FontSize="12"
                             LineHeight="18"
                             TextWrapping="Wrap" />
                </StackPanel>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
