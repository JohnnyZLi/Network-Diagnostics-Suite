<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NetworkDiagnostics.Desktop.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppCanvasBrush">#F6F3F8</SolidColorBrush>
          <SolidColorBrush x:Key="AppSidebarBrush">#EEE8F2</SolidColorBrush>
          <SolidColorBrush x:Key="AppRaisedBrush">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="AppHoverBrush">#E9E1EE</SolidColorBrush>
          <SolidColorBrush x:Key="AppInsetBrush">#F1ECF4</SolidColorBrush>
          <SolidColorBrush x:Key="AppSelectedBrush">#F5E1D9</SolidColorBrush>
          <SolidColorBrush x:Key="AppBorderBrush">#DDD4E2</SolidColorBrush>
          <SolidColorBrush x:Key="AppBorderStrongBrush">#B8A9C1</SolidColorBrush>
          <SolidColorBrush x:Key="AppTextBrush">#211B26</SolidColorBrush>
          <SolidColorBrush x:Key="AppTextSecondaryBrush">#625B68</SolidColorBrush>
          <SolidColorBrush x:Key="AppTextMutedBrush">#8A8290</SolidColorBrush>
          <SolidColorBrush x:Key="AppAccentBrush">#B95F43</SolidColorBrush>
          <SolidColorBrush x:Key="AppAccentHoverBrush">#A85239</SolidColorBrush>
          <SolidColorBrush x:Key="AppAccentSoftBrush">#F5E1D9</SolidColorBrush>
          <SolidColorBrush x:Key="AppAccentBorderBrush">#C98C78</SolidColorBrush>
          <SolidColorBrush x:Key="AppFocusBrush">#A94F35</SolidColorBrush>
          <SolidColorBrush x:Key="AppDangerBrush">#A44332</SolidColorBrush>
          <SolidColorBrush x:Key="AppDangerSoftBrush">#F7E3DF</SolidColorBrush>
          <SolidColorBrush x:Key="AppDangerBorderBrush">#D29A8F</SolidColorBrush>
          <SolidColorBrush x:Key="AppSuccessBrush">#3F8655</SolidColorBrush>
          <SolidColorBrush x:Key="AppSuccessSoftBrush">#E0F1E5</SolidColorBrush>
          <SolidColorBrush x:Key="AppNeutralIndicatorBrush">#929096</SolidColorBrush>
          <SolidColorBrush x:Key="AppOnAccentBrush">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="AppScoreExcellentBrush">#3F9B5C</SolidColorBrush>
          <SolidColorBrush x:Key="AppScoreExcellentSoftBrush">#DDF3E4</SolidColorBrush>
          <SolidColorBrush x:Key="AppScoreGoodBrush">#70A84F</SolidColorBrush>
          <SolidColorBrush x:Key="AppScoreGoodSoftBrush">#E7F2DD</SolidColorBrush>
          <SolidColorBrush x:Key="AppScoreFairBrush">#BE9430</SolidColorBrush>
          <SolidColorBrush x:Key="AppScoreFairSoftBrush">#F5EBCF</SolidColorBrush>
          <SolidColorBrush x:Key="AppScoreDegradedBrush">#C56E3F</SolidColorBrush>
          <SolidColorBrush x:Key="AppScoreDegradedSoftBrush">#F6E2D6</SolidColorBrush>
          <SolidColorBrush x:Key="AppScorePoorBrush">#B8483F</SolidColorBrush>
          <SolidColorBrush x:Key="AppScorePoorSoftBrush">#F6DFDC</SolidColorBrush>
          <SolidColorBrush x:Key="AppTimelineInactiveBrush">#D8D0DD</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppCanvasBrush">#0F0B16</SolidColorBrush>
          <SolidColorBrush x:Key="AppSidebarBrush">#140E1C</SolidColorBrush>
          <SolidColorBrush x:Key="AppRaisedBrush">#1D1427</SolidColorBrush>
          <SolidColorBrush x:Key="AppHoverBrush">#2A1D37</SolidColorBrush>
          <SolidColorBrush x:Key="AppInsetBrush">#0A0710</SolidColorBrush>
          <SolidColorBrush x:Key="AppSelectedBrush">#302038</SolidColorBrush>
          <SolidColorBrush x:Key="AppBorderBrush">#382943</SolidColorBrush>
          <SolidColorBrush x:Key="AppBorderStrongBrush">#594565</SolidColorBrush>
          <SolidColorBrush x:Key="AppTextBrush">#F4EFF7</SolidColorBrush>
          <SolidColorBrush x:Key="AppTextSecondaryBrush">#C0B7C7</SolidColorBrush>
          <SolidColorBrush x:Key="AppTextMutedBrush">#8E8397</SolidColorBrush>
          <SolidColorBrush x:Key="AppAccentBrush">#D87657</SolidColorBrush>
          <SolidColorBrush x:Key="AppAccentHoverBrush">#E28567</SolidColorBrush>
          <SolidColorBrush x:Key="AppAccentSoftBrush">#342018</SolidColorBrush>
          <SolidColorBrush x:Key="AppAccentBorderBrush">#955A46</SolidColorBrush>
          <SolidColorBrush x:Key="AppFocusBrush">#E08B70</SolidColorBrush>
          <SolidColorBrush x:Key="AppDangerBrush">#F07C70</SolidColorBrush>
          <SolidColorBrush x:Key="AppDangerSoftBrush">#321B21</SolidColorBrush>
          <SolidColorBrush x:Key="AppDangerBorderBrush">#74434A</SolidColorBrush>
          <SolidColorBrush x:Key="AppSuccessBrush">#64D586</SolidColorBrush>
          <SolidColorBrush x:Key="AppSuccessSoftBrush">#16331F</SolidColorBrush>
          <SolidColorBrush x:Key="AppNeutralIndicatorBrush">#766C7D</SolidColorBrush>
          <SolidColorBrush x:Key="AppOnAccentBrush">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="AppScoreExcellentBrush">#55D47E</SolidColorBrush>
          <SolidColorBrush x:Key="AppScoreExcellentSoftBrush">#163B25</SolidColorBrush>
          <SolidColorBrush x:Key="AppScoreGoodBrush">#91D66E</SolidColorBrush>
          <SolidColorBrush x:Key="AppScoreGoodSoftBrush">#26391D</SolidColorBrush>
          <SolidColorBrush x:Key="AppScoreFairBrush">#F0C65E</SolidColorBrush>
          <SolidColorBrush x:Key="AppScoreFairSoftBrush">#3A311A</SolidColorBrush>
          <SolidColorBrush x:Key="AppScoreDegradedBrush">#F19758</SolidColorBrush>
          <SolidColorBrush x:Key="AppScoreDegradedSoftBrush">#3B271A</SolidColorBrush>
          <SolidColorBrush x:Key="AppScorePoorBrush">#F06E64</SolidColorBrush>
          <SolidColorBrush x:Key="AppScorePoorSoftBrush">#3A1D25</SolidColorBrush>
          <SolidColorBrush x:Key="AppTimelineInactiveBrush">#392D42</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource AppCanvasBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
      <Setter Property="FontFamily" Value="Inter" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.secondary">
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1.45" />
    </Style>

    <Style Selector="Border.surface">
      <Setter Property="Background" Value="{DynamicResource AppRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Border.monitorPanel">
      <Setter Property="Background" Value="{DynamicResource AppRaisedBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Border.surfaceSubtle">
      <Setter Property="Background" Value="{DynamicResource AppInsetBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style Selector="Border.accentSurface">
      <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Border.divider">
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.indicatorNeutral">
      <Setter Property="Background" Value="{DynamicResource AppNeutralIndicatorBrush}" />
    </Style>
    <Style Selector="Border.indicatorAccent">
      <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
    </Style>
    <Style Selector="Border.indicatorSuccess">
      <Setter Property="Background" Value="{DynamicResource AppSuccessBrush}" />
    </Style>

    <Style Selector="Border.scoreExcellent">
      <Setter Property="Background" Value="{DynamicResource AppScoreExcellentBrush}" />
    </Style>
    <Style Selector="Border.scoreGood">
      <Setter Property="Background" Value="{DynamicResource AppScoreGoodBrush}" />
    </Style>
    <Style Selector="Border.scoreFair">
      <Setter Property="Background" Value="{DynamicResource AppScoreFairBrush}" />
    </Style>
    <Style Selector="Border.scoreDegraded">
      <Setter Property="Background" Value="{DynamicResource AppScoreDegradedBrush}" />
    </Style>
    <Style Selector="Border.scorePoor">
      <Setter Property="Background" Value="{DynamicResource AppScorePoorBrush}" />
    </Style>
    <Style Selector="Border.scoreUnavailable">
      <Setter Property="Background" Value="{DynamicResource AppNeutralIndicatorBrush}" />
    </Style>
    <Style Selector="Border.scoreSoftExcellent">
      <Setter Property="Background" Value="{DynamicResource AppScoreExcellentSoftBrush}" />
    </Style>
    <Style Selector="Border.scoreSoftGood">
      <Setter Property="Background" Value="{DynamicResource AppScoreGoodSoftBrush}" />
    </Style>
    <Style Selector="Border.scoreSoftFair">
      <Setter Property="Background" Value="{DynamicResource AppScoreFairSoftBrush}" />
    </Style>
    <Style Selector="Border.scoreSoftDegraded">
      <Setter Property="Background" Value="{DynamicResource AppScoreDegradedSoftBrush}" />
    </Style>
    <Style Selector="Border.scoreSoftPoor">
      <Setter Property="Background" Value="{DynamicResource AppScorePoorSoftBrush}" />
    </Style>
    <Style Selector="Border.timelineInactive">
      <Setter Property="Background" Value="{DynamicResource AppTimelineInactiveBrush}" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="15,8" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppAccentHoverBrush}" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="13,7" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource AppRaisedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.secondary:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="11,7" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.ghost:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="13,7" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource AppDangerSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppDangerBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.tab, Button.range">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="11,7" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.tab:pointerover, Button.range:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <Style Selector="Button.tab.selected, Button.range.selected">
      <Setter Property="Background" Value="{DynamicResource AppSelectedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <Style Selector="Button.dataRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="14,11" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.dataRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
    </Style>
    <Style Selector="Button.dataRow.selected">
      <Setter Property="Background" Value="{DynamicResource AppSelectedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBorderBrush}" />
    </Style>

    <Style Selector="TextBox.appInput">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="11,7" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="{DynamicResource AppRaisedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
    </Style>
    <Style Selector="ComboBox.appInput">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="{DynamicResource AppRaisedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="ProgressBar">
      <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="Background" Value="{DynamicResource AppInsetBrush}" />
    </Style>
  </Application.Styles>
</Application>
