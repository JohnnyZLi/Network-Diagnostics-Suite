<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NetworkDiagnostics.Desktop.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppCanvasBrush">#F5F2ED</SolidColorBrush>
          <SolidColorBrush x:Key="AppSidebarBrush">#ECE6DF</SolidColorBrush>
          <SolidColorBrush x:Key="AppRaisedBrush">#FFFCF8</SolidColorBrush>
          <SolidColorBrush x:Key="AppHoverBrush">#ECE5DE</SolidColorBrush>
          <SolidColorBrush x:Key="AppInsetBrush">#F1ECE6</SolidColorBrush>
          <SolidColorBrush x:Key="AppSelectedBrush">#F2DED6</SolidColorBrush>
          <SolidColorBrush x:Key="AppBorderBrush">#DDD3CA</SolidColorBrush>
          <SolidColorBrush x:Key="AppBorderStrongBrush">#BDAEA2</SolidColorBrush>
          <SolidColorBrush x:Key="AppTextBrush">#241F1C</SolidColorBrush>
          <SolidColorBrush x:Key="AppTextSecondaryBrush">#665E58</SolidColorBrush>
          <SolidColorBrush x:Key="AppTextMutedBrush">#8D837B</SolidColorBrush>
          <SolidColorBrush x:Key="AppAccentBrush">#B95F43</SolidColorBrush>
          <SolidColorBrush x:Key="AppAccentHoverBrush">#A85239</SolidColorBrush>
          <SolidColorBrush x:Key="AppAccentSoftBrush">#F2DED6</SolidColorBrush>
          <SolidColorBrush x:Key="AppAccentBorderBrush">#CA8C77</SolidColorBrush>
          <SolidColorBrush x:Key="AppFocusBrush">#A94F35</SolidColorBrush>
          <SolidColorBrush x:Key="AppDangerBrush">#A44332</SolidColorBrush>
          <SolidColorBrush x:Key="AppDangerSoftBrush">#F7E3DF</SolidColorBrush>
          <SolidColorBrush x:Key="AppDangerBorderBrush">#D29A8F</SolidColorBrush>
          <SolidColorBrush x:Key="AppSuccessBrush">#358552</SolidColorBrush>
          <SolidColorBrush x:Key="AppSuccessSoftBrush">#DDF0E3</SolidColorBrush>
          <SolidColorBrush x:Key="AppNeutralIndicatorBrush">#8D8783</SolidColorBrush>
          <SolidColorBrush x:Key="AppOnAccentBrush">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="AppScoreExcellentBrush">#30965A</SolidColorBrush>
          <SolidColorBrush x:Key="AppScoreExcellentSoftBrush">#D9F0E1</SolidColorBrush>
          <SolidColorBrush x:Key="AppScoreGoodBrush">#68A448</SolidColorBrush>
          <SolidColorBrush x:Key="AppScoreGoodSoftBrush">#E4F0DA</SolidColorBrush>
          <SolidColorBrush x:Key="AppScoreFairBrush">#B88A22</SolidColorBrush>
          <SolidColorBrush x:Key="AppScoreFairSoftBrush">#F3E8C7</SolidColorBrush>
          <SolidColorBrush x:Key="AppScoreDegradedBrush">#C76637</SolidColorBrush>
          <SolidColorBrush x:Key="AppScoreDegradedSoftBrush">#F5DED1</SolidColorBrush>
          <SolidColorBrush x:Key="AppScorePoorBrush">#B83F38</SolidColorBrush>
          <SolidColorBrush x:Key="AppScorePoorSoftBrush">#F4DCD9</SolidColorBrush>
          <SolidColorBrush x:Key="AppTimelineInactiveBrush">#D6CEC7</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppCanvasBrush">#08040E</SolidColorBrush>
          <SolidColorBrush x:Key="AppSidebarBrush">#0D0715</SolidColorBrush>
          <SolidColorBrush x:Key="AppRaisedBrush">#180E24</SolidColorBrush>
          <SolidColorBrush x:Key="AppHoverBrush">#251534</SolidColorBrush>
          <SolidColorBrush x:Key="AppInsetBrush">#07030C</SolidColorBrush>
          <SolidColorBrush x:Key="AppSelectedBrush">#2E1742</SolidColorBrush>
          <SolidColorBrush x:Key="AppBorderBrush">#332044</SolidColorBrush>
          <SolidColorBrush x:Key="AppBorderStrongBrush">#56366E</SolidColorBrush>
          <SolidColorBrush x:Key="AppTextBrush">#F8F2FF</SolidColorBrush>
          <SolidColorBrush x:Key="AppTextSecondaryBrush">#C8B9D4</SolidColorBrush>
          <SolidColorBrush x:Key="AppTextMutedBrush">#9182A0</SolidColorBrush>
          <SolidColorBrush x:Key="AppAccentBrush">#E27656</SolidColorBrush>
          <SolidColorBrush x:Key="AppAccentHoverBrush">#EE8868</SolidColorBrush>
          <SolidColorBrush x:Key="AppAccentSoftBrush">#351C17</SolidColorBrush>
          <SolidColorBrush x:Key="AppAccentBorderBrush">#9A5B45</SolidColorBrush>
          <SolidColorBrush x:Key="AppFocusBrush">#EC967B</SolidColorBrush>
          <SolidColorBrush x:Key="AppDangerBrush">#F37A72</SolidColorBrush>
          <SolidColorBrush x:Key="AppDangerSoftBrush">#35191F</SolidColorBrush>
          <SolidColorBrush x:Key="AppDangerBorderBrush">#7A3D48</SolidColorBrush>
          <SolidColorBrush x:Key="AppSuccessBrush">#5FDC87</SolidColorBrush>
          <SolidColorBrush x:Key="AppSuccessSoftBrush">#12351F</SolidColorBrush>
          <SolidColorBrush x:Key="AppNeutralIndicatorBrush">#766A80</SolidColorBrush>
          <SolidColorBrush x:Key="AppOnAccentBrush">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="AppScoreExcellentBrush">#55E184</SolidColorBrush>
          <SolidColorBrush x:Key="AppScoreExcellentSoftBrush">#123B24</SolidColorBrush>
          <SolidColorBrush x:Key="AppScoreGoodBrush">#93DF6D</SolidColorBrush>
          <SolidColorBrush x:Key="AppScoreGoodSoftBrush">#243A1B</SolidColorBrush>
          <SolidColorBrush x:Key="AppScoreFairBrush">#F2CC58</SolidColorBrush>
          <SolidColorBrush x:Key="AppScoreFairSoftBrush">#3D3216</SolidColorBrush>
          <SolidColorBrush x:Key="AppScoreDegradedBrush">#F49A55</SolidColorBrush>
          <SolidColorBrush x:Key="AppScoreDegradedSoftBrush">#402516</SolidColorBrush>
          <SolidColorBrush x:Key="AppScorePoorBrush">#F36A63</SolidColorBrush>
          <SolidColorBrush x:Key="AppScorePoorSoftBrush">#3D1822</SolidColorBrush>
          <SolidColorBrush x:Key="AppTimelineInactiveBrush">#34263F</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource AppCanvasBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
      <Setter Property="FontFamily" Value="Inter" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.secondary">
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1.45" />
    </Style>

    <Style Selector="Border.surface">
      <Setter Property="Background" Value="{DynamicResource AppRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="11" />
    </Style>
    <Style Selector="Border.monitorPanel">
      <Setter Property="Background" Value="{DynamicResource AppRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style Selector="Border.surfaceSubtle">
      <Setter Property="Background" Value="{DynamicResource AppInsetBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Border.accentSurface">
      <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="11" />
    </Style>
    <Style Selector="Border.divider">
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.indicatorNeutral">
      <Setter Property="Background" Value="{DynamicResource AppNeutralIndicatorBrush}" />
    </Style>
    <Style Selector="Border.indicatorAccent">
      <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
    </Style>
    <Style Selector="Border.indicatorSuccess">
      <Setter Property="Background" Value="{DynamicResource AppSuccessBrush}" />
    </Style>

    <Style Selector="Border.scoreExcellent">
      <Setter Property="Background" Value="{DynamicResource AppScoreExcellentBrush}" />
    </Style>
    <Style Selector="Border.scoreGood">
      <Setter Property="Background" Value="{DynamicResource AppScoreGoodBrush}" />
    </Style>
    <Style Selector="Border.scoreFair">
      <Setter Property="Background" Value="{DynamicResource AppScoreFairBrush}" />
    </Style>
    <Style Selector="Border.scoreDegraded">
      <Setter Property="Background" Value="{DynamicResource AppScoreDegradedBrush}" />
    </Style>
    <Style Selector="Border.scorePoor">
      <Setter Property="Background" Value="{DynamicResource AppScorePoorBrush}" />
    </Style>
    <Style Selector="Border.scoreUnavailable">
      <Setter Property="Background" Value="{DynamicResource AppNeutralIndicatorBrush}" />
    </Style>
    <Style Selector="Border.scoreSoftExcellent">
      <Setter Property="Background" Value="{DynamicResource AppScoreExcellentSoftBrush}" />
    </Style>
    <Style Selector="Border.scoreSoftGood">
      <Setter Property="Background" Value="{DynamicResource AppScoreGoodSoftBrush}" />
    </Style>
    <Style Selector="Border.scoreSoftFair">
      <Setter Property="Background" Value="{DynamicResource AppScoreFairSoftBrush}" />
    </Style>
    <Style Selector="Border.scoreSoftDegraded">
      <Setter Property="Background" Value="{DynamicResource AppScoreDegradedSoftBrush}" />
    </Style>
    <Style Selector="Border.scoreSoftPoor">
      <Setter Property="Background" Value="{DynamicResource AppScorePoorSoftBrush}" />
    </Style>
    <Style Selector="Border.timelineInactive">
      <Setter Property="Background" Value="{DynamicResource AppTimelineInactiveBrush}" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="15,8" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppAccentHoverBrush}" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="13,7" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="{DynamicResource AppRaisedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.secondary:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="11,7" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.ghost:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="13,7" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="{DynamicResource AppDangerSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppDangerBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.tab, Button.range">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="11,7" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.tab:pointerover, Button.range:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <Style Selector="Button.tab.selected, Button.range.selected">
      <Setter Property="Background" Value="{DynamicResource AppSelectedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.dataRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="14,11" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.dataRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
    </Style>
    <Style Selector="Button.dataRow.selected">
      <Setter Property="Background" Value="{DynamicResource AppSelectedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBorderBrush}" />
    </Style>

    <Style Selector="TextBox.appInput">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="11,7" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource AppRaisedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
    </Style>
    <Style Selector="ComboBox.appInput">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource AppRaisedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="ProgressBar">
      <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="Background" Value="{DynamicResource AppInsetBrush}" />
    </Style>
  </Application.Styles>
</Application>