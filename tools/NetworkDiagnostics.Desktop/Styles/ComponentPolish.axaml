<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:workspaces="using:NetworkDiagnostics.Desktop.Workspaces">
  <Style Selector="Button.primary, Button.secondary, Button.danger">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="13,6" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.46" />
  </Style>

  <Style Selector="Button.linkAction">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.linkAction:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>

  <Style Selector="workspaces|TestSetupWorkspace Button.speedAction">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="13,6" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="workspaces|SettingsWorkspace Button.sectionNav">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="workspaces|SettingsWorkspace Button.sectionNav:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
  </Style>
  <Style Selector="workspaces|SettingsWorkspace Button.sectionNav.selected, workspaces|SettingsWorkspace Button.sectionNav.selected:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppSelectedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="workspaces|SettingsWorkspace TextBox">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="workspaces|SettingsWorkspace ComboBox">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="workspaces|SettingsWorkspace Border.settingsCard">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style Selector="workspaces|SettingsWorkspace TextBlock.fieldLabel">
    <Setter Property="FontSize" Value="9.5" />
  </Style>

  <Style Selector="workspaces|ComparisonWorkspace Border.conditionCard">
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style Selector="workspaces|ComparisonWorkspace Button.dataRow">
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="workspaces|ComparisonWorkspace Button.pickerAction">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="FontSize" Value="10" />
  </Style>
</Styles>
