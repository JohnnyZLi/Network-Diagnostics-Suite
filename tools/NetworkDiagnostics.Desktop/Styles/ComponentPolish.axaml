<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:workspaces="using:NetworkDiagnostics.Desktop.Workspaces">
  <Style Selector="Button.primary, Button.secondary, Button.danger">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="13,6" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.46" />
  </Style>

  <Style Selector="Button.linkAction">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.linkAction:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>

  <Style Selector="Border.modalBackdrop">
    <Setter Property="Background" Value="#88000000" />
  </Style>
  <Style Selector="Border.modalSheet">
    <Setter Property="Background" Value="{DynamicResource AppCanvasBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="BoxShadow" Value="0 18 58 0 #88000000" />
  </Style>
  <Style Selector="Border.modalHeader">
    <Setter Property="Background" Value="{DynamicResource AppRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="18,12" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="MaxDropDownHeight" Value="300" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
  </Style>
  <Style Selector="ComboBox /template/ ContentControl#ContentPresenter">
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ComboBox /template/ PathIcon#DropDownGlyph">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="Margin" Value="0,0,12,0" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
  </Style>
  <Style Selector="ComboBox:dropdownopen /template/ Border#PopupBorder">
    <Setter Property="Background" Value="{DynamicResource AppRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="5" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="BoxShadow" Value="0 14 38 0 #78000000" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ComboBoxItem /template/ ContentPresenter">
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>
  <Style Selector="ComboBoxItem:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>
  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppSelectedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>
  <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppSelectedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>
  <Style Selector="ComboBoxItem:disabled">
    <Setter Property="Opacity" Value="0.42" />
  </Style>

  <Style Selector="workspaces|TestSetupWorkspace Button.speedAction">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="13,6" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="workspaces|SettingsWorkspace Button.sectionNav">
    <Setter Property="Height" Value="34" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="13,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="workspaces|SettingsWorkspace Button.sectionNav:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
  </Style>
  <Style Selector="workspaces|SettingsWorkspace Button.sectionNav.selected, workspaces|SettingsWorkspace Button.sectionNav.selected:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppSelectedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="workspaces|SettingsWorkspace TextBox">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="workspaces|SettingsWorkspace ComboBox">
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="workspaces|SettingsWorkspace Border.settingsCard">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style Selector="workspaces|SettingsWorkspace TextBlock.fieldLabel">
    <Setter Property="FontSize" Value="9.5" />
  </Style>

  <Style Selector="workspaces|ComparisonWorkspace Border.conditionCard">
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style Selector="workspaces|ComparisonWorkspace Button.dataRow">
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="workspaces|ComparisonWorkspace Button.pickerAction">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="FontSize" Value="10" />
  </Style>
</Styles>
