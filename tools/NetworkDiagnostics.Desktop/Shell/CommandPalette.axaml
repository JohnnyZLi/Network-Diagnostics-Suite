<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NetworkDiagnostics.Desktop.Shell.CommandPalette"
             IsVisible="False"
             Background="Transparent"
             Foreground="{DynamicResource AppTextBrush}"
             FontFamily="Inter">
  <UserControl.Styles>
    <Style Selector="TextBox.commandSearch">
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Background" Value="{DynamicResource AppInsetBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="CaretBrush" Value="{DynamicResource AppTextBrush}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource AppAccentBorderBrush}" />
      <Setter Property="SelectionForegroundBrush" Value="{DynamicResource AppOnAccentBrush}" />
    </Style>
    <Style Selector="TextBox.commandSearch:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppInsetBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppTextMutedBrush}" />
    </Style>
    <Style Selector="TextBox.commandSearch:focus">
      <Setter Property="Background" Value="{DynamicResource AppInsetBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppFocusBrush}" />
    </Style>
    <Style Selector="Button.command">
      <Setter Property="MinHeight" Value="52" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.command:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
    </Style>
    <Style Selector="Button.command.selected">
      <Setter Property="Background" Value="{DynamicResource AppSelectedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBorderBrush}" />
    </Style>
    <Style Selector="Button.command:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <Border Background="#99000000"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            PointerPressed="BackdropPressed" />

    <Border Width="620"
            Margin="0,72,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="{DynamicResource AppRaisedBrush}"
            BorderBrush="{DynamicResource AppBorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="12"
            PointerPressed="PaletteSurfacePressed">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Grid.Row="0" Margin="16,14,16,10" Spacing="4">
          <TextBlock Classes="eyebrow" Text="COMMAND PALETTE" />
          <TextBlock Classes="muted" FontSize="10" Text="Navigate, inspect, or run an application action" />
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,1" Padding="14,12">
          <TextBox Name="SearchBox"
                   Classes="commandSearch"
                   PlaceholderText="Search commands and workspaces…"
                   TextChanged="SearchChanged"
                   KeyDown="SearchKeyDown">
            <TextBox.Resources>
              <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                  <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TextControlBackground">#F0EDE7</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver">#F0EDE7</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlBackgroundFocused">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlForeground">#211F1C</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlForegroundPointerOver">#211F1C</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlForegroundFocused">#211F1C</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlPlaceholderForeground">#858985</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver">#6F746F</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused">#6F746F</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlBorderBrush">#B8B0A5</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver">#9C9387</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused">#A94F35</SolidColorBrush>
                  </ResourceDictionary>
                  <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="TextControlBackground">#0D1011</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver">#0D1011</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlBackgroundFocused">#0D1011</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlForeground">#F1EEE8</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlForegroundPointerOver">#F1EEE8</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlForegroundFocused">#F1EEE8</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlPlaceholderForeground">#7F898A</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver">#8E9798</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused">#8E9798</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlBorderBrush">#41494A</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver">#5A6364</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused">#D58A72</SolidColorBrush>
                  </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
              </ResourceDictionary>
            </TextBox.Resources>
          </TextBox>
        </Border>

        <ScrollViewer Grid.Row="2" MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Name="ResultsPanel" Margin="8" Spacing="2" />
        </ScrollViewer>

        <Border Grid.Row="3" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="14,10">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <TextBlock Name="ResultCountText" Classes="muted" FontSize="9" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="muted" FontSize="9" Text="↑↓ Select   Enter Run   Esc Close" VerticalAlignment="Center" />
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>