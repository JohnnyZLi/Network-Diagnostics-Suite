<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NetworkDiagnostics.Desktop.Shell"
             x:Class="NetworkDiagnostics.Desktop.Shell.WorkbenchShell"
             Background="{DynamicResource AppCanvasBrush}"
             Foreground="{DynamicResource AppTextBrush}"
             FontFamily="Inter">
  <UserControl.Styles>
    <Style Selector="TextBlock.shellMuted">
      <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.shellEyebrow">
      <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="FontSize" Value="9" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1.35" />
    </Style>
    <Style Selector="Button.shellIcon">
      <Setter Property="Width" Value="27" />
      <Setter Property="Height" Value="27" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.shellIcon:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <Style Selector="Button.shellIcon:disabled">
      <Setter Property="Opacity" Value="0.25" />
    </Style>
    <Style Selector="Button.shellNav">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Button.shellNav:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <Style Selector="Button.shellNav.selected">
      <Setter Property="Background" Value="{DynamicResource AppSelectedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.activeRun">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Background" Value="{DynamicResource AppRaisedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.activeRun:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
    </Style>
    <Style Selector="Button.breadcrumb">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="14" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="9" />
    </Style>
    <Style Selector="Button.utilityKey">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="FontSize" Value="9" />
    </Style>
    <Style Selector="Button.utilityKey:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrongBrush}" />
    </Style>
    <Style Selector="Button.utilityKey:disabled">
      <Setter Property="Opacity" Value="0.48" />
    </Style>
    <Style Selector="Button.utilityIcon">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.utilityIcon:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <Style Selector="Button.utilityIcon:disabled">
      <Setter Property="Opacity" Value="0.42" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="54,*">
    <Border Grid.Row="0"
            Background="{DynamicResource AppCanvasBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0" ColumnSpacing="14">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="0">
            <Button Name="BackButton" Classes="shellIcon" Content="‹" ToolTip.Tip="Back" Click="BackClicked" />
            <Button Name="ForwardButton" Classes="shellIcon" Content="›" ToolTip.Tip="Forward" Click="ForwardClicked" />
          </StackPanel>
          <Button Name="HomeButton"
                  Classes="utilityKey"
                  Content="Home"
                  MinWidth="52"
                  ToolTip.Tip="Return to Home"
                  Click="HomeClicked" />
          <Grid Width="24" Height="24">
            <Border Width="24"
                    Height="24"
                    CornerRadius="12"
                    Background="{DynamicResource AppAccentSoftBrush}"
                    BorderBrush="{DynamicResource AppAccentBorderBrush}"
                    BorderThickness="1" />
            <Border Width="14"
                    Height="14"
                    CornerRadius="7"
                    Background="{DynamicResource AppAccentBrush}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
              <Border Width="5"
                      Height="5"
                      CornerRadius="3"
                      Background="{DynamicResource AppCanvasBrush}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
            </Border>
          </Grid>
          <StackPanel Name="ProductStack" Spacing="0" Width="148">
            <TextBlock FontSize="11" FontWeight="SemiBold" Text="Network Diagnostics" />
            <StackPanel Name="BreadcrumbPanel" Orientation="Horizontal" Spacing="4">
              <TextBlock Classes="shellMuted" FontSize="8" Text="Local diagnostics" />
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <Border Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource AppInsetBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="3">
          <StackPanel Orientation="Horizontal" Spacing="1">
            <Button Name="TestWorkspaceButton" Classes="shellNav selected" Tag="Test" Click="WorkspaceClicked">
              <TextBlock Name="TestWorkspaceLabel" Text="Overview" />
            </Button>
            <Button Name="ReportsWorkspaceButton" Classes="shellNav" Tag="Reports" Click="WorkspaceClicked">
              <TextBlock Name="ReportsWorkspaceLabel" Text="History" />
            </Button>
            <Button Name="ComparisonsWorkspaceButton" Classes="shellNav" Tag="Comparisons" Click="WorkspaceClicked">
              <TextBlock Name="ComparisonsWorkspaceLabel" Text="Compare" />
            </Button>
            <Button Name="SettingsWorkspaceButton" Classes="shellNav" Tag="Settings" Click="WorkspaceClicked">
              <TextBlock Name="SettingsWorkspaceLabel" Text="Settings" />
            </Button>
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Name="SettingsToolbarButton"
                  Classes="utilityKey"
                  Content="Settings"
                  MinWidth="58"
                  ToolTip.Tip="Open Settings"
                  Click="SettingsClicked" />
          <Button Name="ActiveRunPanel" Classes="activeRun" IsVisible="False" ToolTip.Tip="Return to active diagnostic" Click="ActiveRunClicked">
            <Grid RowDefinitions="Auto,Auto">
              <StackPanel Spacing="0" VerticalAlignment="Center">
                <TextBlock Name="ActiveRunTitleText" FontSize="9" FontWeight="SemiBold" />
                <TextBlock Name="ActiveRunDetailText" Classes="shellMuted" FontSize="8" />
              </StackPanel>
              <ProgressBar Name="ActiveRunProgress" Grid.Row="1" Minimum="0" Maximum="100" Height="2" Margin="0,3,0,0" />
            </Grid>
          </Button>
          <Button Name="CommandToolbarButton" Classes="utilityKey" Content="⌘ K" ToolTip.Tip="Open commands" Click="CommandsClicked" />
          <Button Name="InspectorToggleButton" Classes="utilityIcon" Content="i" ToolTip.Tip="Show contextual information" Click="InspectorClicked" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Name="ShellGrid" Grid.Row="1">
      <Border Background="{DynamicResource AppCanvasBrush}">
        <ContentControl Name="WorkspaceHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
      </Border>

      <Border Name="InspectorBorder"
              Width="360"
              HorizontalAlignment="Right"
              VerticalAlignment="Stretch"
              Margin="0,12,12,12"
              Background="{DynamicResource AppRaisedBrush}"
              BorderBrush="{DynamicResource AppBorderStrongBrush}"
              BorderThickness="1"
              CornerRadius="14"
              BoxShadow="0 12 36 0 #66000000"
              IsVisible="False"
              ZIndex="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="20" Spacing="18">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="5">
                <TextBlock Classes="shellEyebrow" Text="CONTEXT" />
                <TextBlock Name="InspectorTitleText" FontSize="16" FontWeight="SemiBold" Text="Details" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Classes="shellIcon" Content="×" Click="InspectorClicked" />
            </Grid>
            <TextBlock Name="InspectorDetailText" Classes="shellMuted" FontSize="11" LineHeight="17" TextWrapping="Wrap" />
            <Border Background="{DynamicResource AppInsetBrush}" CornerRadius="9" Padding="12,10">
              <StackPanel Spacing="7">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                  <TextBlock Classes="shellMuted" FontSize="9" Text="Workspace" />
                  <TextBlock Name="InspectorWorkspaceText" Grid.Column="1" FontSize="9" TextAlignment="Right" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                  <TextBlock Classes="shellMuted" FontSize="9" Text="Selection" />
                  <TextBlock Name="InspectorSelectionText" Grid.Column="1" FontSize="9" TextAlignment="Right" TextWrapping="Wrap" />
                </Grid>
              </StackPanel>
            </Border>
            <ContentControl Name="InspectorBodyHost" HorizontalContentAlignment="Stretch" />
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Grid IsVisible="False">
        <TextBlock Name="StatusInterfaceText" />
        <TextBlock Name="StatusEndpointText" />
        <TextBlock Name="StatusNetworkText" />
        <TextBlock Name="StatusActivityText" />
      </Grid>
    </Grid>

    <local:CommandPalette Name="CommandPaletteControl" Grid.RowSpan="2" />
  </Grid>
</UserControl>