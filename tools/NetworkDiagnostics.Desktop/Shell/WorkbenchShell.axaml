<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NetworkDiagnostics.Desktop.Shell"
             x:Class="NetworkDiagnostics.Desktop.Shell.WorkbenchShell"
             Background="{DynamicResource AppCanvasBrush}"
             Foreground="{DynamicResource AppTextBrush}"
             FontFamily="Inter">
  <UserControl.Styles>
    <Style Selector="TextBlock.shellMuted">
      <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.shellEyebrow">
      <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="FontSize" Value="9" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1.4" />
    </Style>
    <Style Selector="Button.shellIcon">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.shellIcon:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <Style Selector="Button.shellIcon:disabled">
      <Setter Property="Opacity" Value="0.28" />
    </Style>
    <Style Selector="Button.shellNav">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="15,7" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Button.shellNav:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <Style Selector="Button.shellNav.selected">
      <Setter Property="Background" Value="{DynamicResource AppSelectedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.activeRun">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="11,6" />
      <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.breadcrumb">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="16" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="9" />
    </Style>
    <Style Selector="Button.breadcrumb:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <Style Selector="Button.breadcrumb:disabled">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.toolbarPill">
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="11,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="FontSize" Value="9" />
    </Style>
    <Style Selector="Button.toolbarPill:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="64,*">
    <Border Grid.Row="0"
            Background="{DynamicResource AppSidebarBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,0" ColumnSpacing="18">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button Name="BackButton" Classes="shellIcon" Content="‹" ToolTip.Tip="Back" Click="BackClicked" />
            <Button Name="ForwardButton" Classes="shellIcon" Content="›" ToolTip.Tip="Forward" Click="ForwardClicked" />
          </StackPanel>
          <Border Width="30"
                  Height="30"
                  CornerRadius="15"
                  Background="{DynamicResource AppAccentBrush}">
            <Border Width="12"
                    Height="12"
                    CornerRadius="6"
                    Background="{DynamicResource AppCanvasBrush}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
          </Border>
          <StackPanel Name="ProductStack" Spacing="0" MinWidth="152">
            <TextBlock FontSize="12" FontWeight="SemiBold" Text="Network Diagnostics" />
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
              <StackPanel Name="BreadcrumbPanel" Orientation="Horizontal" Spacing="4" />
            </ScrollViewer>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="2">
          <Button Name="TestWorkspaceButton" Classes="shellNav selected" Tag="Test" Click="WorkspaceClicked">
            <TextBlock Name="TestWorkspaceLabel" Text="Overview" />
          </Button>
          <Button Name="ReportsWorkspaceButton" Classes="shellNav" Tag="Reports" Click="WorkspaceClicked">
            <TextBlock Name="ReportsWorkspaceLabel" Text="History" />
          </Button>
          <Button Name="ComparisonsWorkspaceButton" Classes="shellNav" Tag="Comparisons" Click="WorkspaceClicked">
            <TextBlock Name="ComparisonsWorkspaceLabel" Text="Compare" />
          </Button>
          <Button Name="SettingsWorkspaceButton" Classes="shellNav" Tag="Settings" Click="WorkspaceClicked">
            <TextBlock Name="SettingsWorkspaceLabel" Text="Settings" />
          </Button>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
          <Button Name="ActiveRunPanel" Classes="activeRun" IsVisible="False" ToolTip.Tip="Return to active diagnostic" Click="ActiveRunClicked">
            <Grid ColumnDefinitions="Auto,72" ColumnSpacing="9">
              <StackPanel Spacing="1" VerticalAlignment="Center">
                <TextBlock Name="ActiveRunTitleText" FontSize="9" FontWeight="SemiBold" />
                <TextBlock Name="ActiveRunDetailText" Classes="shellMuted" FontSize="8" />
              </StackPanel>
              <ProgressBar Name="ActiveRunProgress" Grid.Column="1" Minimum="0" Maximum="100" Height="4" VerticalAlignment="Center" />
            </Grid>
          </Button>
          <Button Name="CommandToolbarButton" Classes="toolbarPill" Content="⌘K" ToolTip.Tip="Open commands" Click="CommandsClicked" />
          <Button Name="InspectorToggleButton" Classes="toolbarPill" Content="Info" ToolTip.Tip="Show contextual information" Click="InspectorClicked" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Name="ShellGrid" Grid.Row="1">
      <Border Background="{DynamicResource AppCanvasBrush}">
        <ContentControl Name="WorkspaceHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
      </Border>

      <Border Name="InspectorBorder"
              Width="360"
              HorizontalAlignment="Right"
              VerticalAlignment="Stretch"
              Margin="0,12,12,12"
              Background="{DynamicResource AppRaisedBrush}"
              BorderBrush="{DynamicResource AppBorderStrongBrush}"
              BorderThickness="1"
              CornerRadius="14"
              BoxShadow="0 12 36 0 #66000000"
              IsVisible="False"
              ZIndex="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="20" Spacing="18">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="5">
                <TextBlock Classes="shellEyebrow" Text="CONTEXT" />
                <TextBlock Name="InspectorTitleText" FontSize="16" FontWeight="SemiBold" Text="Details" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Classes="shellIcon" Content="×" Click="InspectorClicked" />
            </Grid>
            <TextBlock Name="InspectorDetailText" Classes="shellMuted" FontSize="11" LineHeight="17" TextWrapping="Wrap" />
            <Border Background="{DynamicResource AppInsetBrush}" CornerRadius="9" Padding="12,10">
              <StackPanel Spacing="7">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                  <TextBlock Classes="shellMuted" FontSize="9" Text="Workspace" />
                  <TextBlock Name="InspectorWorkspaceText" Grid.Column="1" FontSize="9" TextAlignment="Right" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                  <TextBlock Classes="shellMuted" FontSize="9" Text="Selection" />
                  <TextBlock Name="InspectorSelectionText" Grid.Column="1" FontSize="9" TextAlignment="Right" TextWrapping="Wrap" />
                </Grid>
              </StackPanel>
            </Border>
            <ContentControl Name="InspectorBodyHost" HorizontalContentAlignment="Stretch" />
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Grid IsVisible="False">
        <TextBlock Name="StatusInterfaceText" />
        <TextBlock Name="StatusEndpointText" />
        <TextBlock Name="StatusNetworkText" />
        <TextBlock Name="StatusActivityText" />
      </Grid>
    </Grid>

    <local:CommandPalette Name="CommandPaletteControl" Grid.RowSpan="2" />
  </Grid>
</UserControl>
