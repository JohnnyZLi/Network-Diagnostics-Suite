<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NetworkDiagnostics.Desktop.MainWindow"
        Title="Network Diagnostics Suite"
        Width="1280"
        Height="820"
        MinWidth="720"
        MinHeight="560"
        Background="#111415"
        Foreground="#E9E6E0"
        FontFamily="Inter">
  <Grid Name="WorkspaceRoot">
    <Grid Name="TestArea">
      <ContentControl Name="SetupView" />
    </Grid>
  </Grid>
</Window>
