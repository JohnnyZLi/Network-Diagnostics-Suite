<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NetworkDiagnostics.Desktop.MainWindow"
        Title="Network Diagnostics Suite"
        Width="1280"
        Height="820"
        MinWidth="720"
        MinHeight="560"
        Background="#111415"
        Foreground="#E9E6E0"
        FontFamily="Inter">
  <!--
    The visible application is composed by WorkbenchShell and the dedicated workspace
    controls. This zero-height bridge retains transitional control-backed state while
    that state is moved into plain models in subsequent cleanup work.
  -->
  <Grid RowDefinitions="0,*">
    <Grid Grid.Row="0"
          IsVisible="False"
          IsHitTestVisible="False">
      <Button Name="TestNavButton" />
      <Button Name="HistoryNavButton" />
      <Button Name="SettingsNavButton" />

      <Button Name="ConnectionProfileButton" />
      <Button Name="QuickProfileButton" />
      <Button Name="FullProfileButton" />
      <Button Name="StressProfileButton" />
      <ComboBox Name="ProfileSelector"
                SelectionChanged="ProfileSelectionChanged">
        <ComboBoxItem Content="Connection Check" />
        <ComboBoxItem Content="Quick" />
        <ComboBoxItem Content="Full" />
        <ComboBoxItem Content="Stress" />
      </ComboBox>

      <Button Name="CompareMethodButton" />
      <Button Name="SingleMethodButton" />
      <Button Name="AggregateMethodButton" />
      <ComboBox Name="MethodSelector"
                SelectionChanged="MethodSelectionChanged">
        <ComboBoxItem Content="Compare" />
        <ComboBoxItem Content="Single" />
        <ComboBoxItem Content="Aggregate" />
      </ComboBox>

      <TextBlock Name="ProfileQuestionText" />
      <TextBlock Name="ProfilePurposeText" />
      <TextBlock Name="MethodExplanationText" />
      <TextBlock Name="EstimatedTimeText" />
      <TextBlock Name="TransferCapText" />
      <TextBlock Name="ConfirmationText" />
      <TextBlock Name="ProfileAvailabilityText" />
      <Button Name="RunButton" />

      <TextBlock Name="PreflightStatusText" Text="Checking the path…" />
      <TextBlock Name="PreflightNetworkText" />
      <TextBlock Name="PreflightEndpointText" />
      <TextBlock Name="PreflightInterfaceText" />
      <TextBlock Name="PreflightHttp3Text" />

      <TextBlock Name="RunningProfileText" />
      <TextBlock Name="CurrentPhaseText" />
      <TextBlock Name="LiveMeasurementText" />
      <ProgressBar Name="RunProgress" Minimum="0" Maximum="100" />
      <TextBlock Name="NetworkPhaseStatus" Text="Waiting" />
      <TextBlock Name="LatencyPhaseStatus" Text="Waiting" />
      <TextBlock Name="DownloadPhaseStatus" Text="Waiting" />
      <TextBlock Name="UploadPhaseStatus" Text="Waiting" />
      <TextBlock Name="DeepPhaseStatus" Text="Not included" />

      <TextBlock Name="ResultProfileText" />
      <Button Name="ExportReportButton" />
      <TextBlock Name="VerdictLabelText" />
      <TextBlock Name="VerdictText" />
      <TextBlock Name="VerdictSummaryText" />
      <TextBlock Name="Metric1Label" />
      <TextBlock Name="Metric1Value" />
      <TextBlock Name="Metric1Detail" />
      <TextBlock Name="Metric2Label" />
      <TextBlock Name="Metric2Value" />
      <TextBlock Name="Metric2Detail" />
      <TextBlock Name="Metric3Label" />
      <TextBlock Name="Metric3Value" />
      <TextBlock Name="Metric3Detail" />
      <TextBlock Name="Metric4Label" />
      <TextBlock Name="Metric4Value" />
      <TextBlock Name="Metric4Detail" />
      <StackPanel Name="FindingsPanel" />
      <TextBlock Name="NextActionText" />
      <Button Name="ChooseQuickButton" />
      <StackPanel Name="TechnicalEvidencePanel" />

      <TextBlock Name="HistoryCountText" Text="0 saved reports" />
      <StackPanel Name="HistoryListPanel" />
      <TextBlock Name="HistoryFixtureTitle" Text="No saved report" />
      <TextBlock Name="HistoryFixtureDetail" />
      <TextBlock Name="ReportsFolderText" />

      <CheckBox Name="IncludeIdentifiersCheckBox" />
      <TextBox Name="TestOriginTextBox" AcceptsReturn="True" />
      <ComboBox Name="InterfaceSelector"
                SelectionChanged="InterfaceSelectionChanged" />
      <TextBox Name="LanTargetTextBox" />
      <TextBox Name="LanPortTextBox" />
      <TextBox Name="LanDurationTextBox" />
      <TextBox Name="LanConnectionsTextBox" />
      <Button Name="StartLanServerButton" />
      <Button Name="StopLanServerButton" IsEnabled="False" />
      <TextBlock Name="LanServerStatusText" Text="Server stopped." />
      <TextBlock Name="SettingsStatusText" />
      <ComboBox Name="FixtureSelector">
        <ComboBoxItem Content="Healthy" />
        <ComboBoxItem Content="Problematic" />
        <ComboBoxItem Content="Inconclusive" />
        <ComboBoxItem Content="Unavailable measurement" />
        <ComboBoxItem Content="Failed with partial evidence" />
      </ComboBox>
    </Grid>

    <Grid Grid.Row="1">
      <Grid Name="TestArea">
        <ContentControl Name="SetupView" />
        <ContentControl Name="RunningView" IsVisible="False" />
        <ContentControl Name="ResultsView" IsVisible="False" />
      </Grid>
      <Grid Name="HistoryArea" IsVisible="False" />
      <Grid Name="SettingsArea" IsVisible="False" />
    </Grid>
  </Grid>
</Window>
