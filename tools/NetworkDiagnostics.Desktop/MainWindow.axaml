<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NetworkDiagnostics.Desktop.MainWindow"
        Title="Network Diagnostics Suite"
        Width="1180"
        Height="800"
        MinWidth="900"
        MinHeight="640"
        Background="#F5F2EC"
        Foreground="#171714">
  <Window.Styles>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="Foreground" Value="#A4553B" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="1.1" />
    </Style>
    <Style Selector="TextBlock.display">
      <Setter Property="FontSize" Value="34" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LineHeight" Value="40" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="21" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.metricValue">
      <Setter Property="FontSize" Value="25" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#68645E" />
    </Style>
    <Style Selector="Border.surface">
      <Setter Property="Background" Value="#FCFBF8" />
      <Setter Property="BorderBrush" Value="#D8D1C6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="22" />
    </Style>
    <Style Selector="Border.subtle">
      <Setter Property="Background" Value="#F1ECE4" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="Border.metric">
      <Setter Property="Background" Value="#FCFBF8" />
      <Setter Property="BorderBrush" Value="#DED8CE" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="Border.finding">
      <Setter Property="Background" Value="#F8F5F0" />
      <Setter Property="BorderBrush" Value="#DED8CE" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#A4553B" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="18,11" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#FCFBF8" />
      <Setter Property="BorderBrush" Value="#BFB7AA" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,9" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#68645E" />
      <Setter Property="Padding" Value="15,9" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="#F1ECE4" />
      <Setter Property="Foreground" Value="#171714" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="42" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0"
            Background="#FCFBF8"
            BorderBrush="#D8D1C6"
            BorderThickness="0,0,0,1"
            Padding="24,16">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2" VerticalAlignment="Center">
          <TextBlock Classes="eyebrow" Text="JOHNNY LI / NETWORK DIAGNOSTICS" />
          <TextBlock FontSize="17" FontWeight="SemiBold" Text="Desktop app" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
          <Button Name="TestNavButton" Classes="nav active" Content="Test" Click="TestNavClicked" />
          <Button Name="HistoryNavButton" Classes="nav" Content="History" Click="HistoryNavClicked" />
          <Button Name="SettingsNavButton" Classes="nav" Content="Settings" Click="SettingsNavClicked" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid Name="TestArea">
        <ScrollViewer Name="SetupView" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="32,28" MaxWidth="760" HorizontalAlignment="Center" Spacing="22">
            <StackPanel Spacing="8">
              <TextBlock Classes="eyebrow" Text="NEW TEST" />
              <TextBlock Classes="display" Text="What do you need to know?" />
              <TextBlock Classes="muted"
                         FontSize="15"
                         LineHeight="22"
                         Text="Choose the shortest test that answers your question. Advanced diagnostics stay out of the way until they are useful."
                         TextWrapping="Wrap" />
            </StackPanel>

            <Border Classes="surface">
              <StackPanel Spacing="18">
                <StackPanel Spacing="6">
                  <TextBlock Classes="eyebrow" Text="TEST PROFILE" />
                  <ComboBox Name="ProfileSelector" SelectionChanged="ProfileSelectionChanged">
                    <ComboBoxItem Content="Connection Check" />
                    <ComboBoxItem Content="Quick" />
                    <ComboBoxItem Content="Full" />
                    <ComboBoxItem Content="Stress" />
                  </ComboBox>
                </StackPanel>

                <StackPanel Spacing="5">
                  <TextBlock Name="ProfileQuestionText" FontSize="22" FontWeight="SemiBold" />
                  <TextBlock Name="ProfilePurposeText" Classes="muted" FontSize="14" LineHeight="21" TextWrapping="Wrap" />
                </StackPanel>

                <Border Height="1" Background="#DED8CE" />

                <Grid ColumnDefinitions="*,*,*">
                  <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Classes="eyebrow" Text="ESTIMATED TIME" />
                    <TextBlock Name="EstimatedTimeText" FontSize="18" FontWeight="SemiBold" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Classes="eyebrow" Text="MAXIMUM DATA" />
                    <TextBlock Name="TransferCapText" FontSize="18" FontWeight="SemiBold" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Classes="eyebrow" Text="CONFIRMATION" />
                    <TextBlock Name="ConfirmationText" FontSize="18" FontWeight="SemiBold" />
                  </StackPanel>
                </Grid>

                <Border Classes="subtle">
                  <TextBlock Name="ProfileAvailabilityText" Classes="muted" TextWrapping="Wrap" />
                </Border>

                <Button Name="RunButton"
                        Classes="primary"
                        Content="Run Connection Check"
                        Click="RunClicked" />
              </StackPanel>
            </Border>

            <TextBlock Classes="muted"
                       FontSize="13"
                       Text="Reports stay on this computer. Local addresses and Wi-Fi names remain excluded unless enabled in Settings."
                       TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer Name="RunningView" IsVisible="False" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="32,44" MaxWidth="720" HorizontalAlignment="Center" Spacing="24">
            <StackPanel Spacing="8">
              <TextBlock Classes="eyebrow" Text="CONNECTION CHECK" />
              <TextBlock Classes="display" Text="Checking your connection" />
              <TextBlock Name="CurrentPhaseText" Classes="muted" FontSize="15" Text="Preparing the test…" />
            </StackPanel>

            <Border Classes="surface">
              <StackPanel Spacing="18">
                <ProgressBar Name="RunProgress" Minimum="0" Maximum="100" Height="8" />
                <TextBlock Name="LiveMeasurementText" FontSize="17" FontWeight="SemiBold" Text="Starting…" />
                <StackPanel Spacing="11">
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Network access" /><TextBlock Name="NetworkPhaseStatus" Classes="muted" Grid.Column="1" Text="Waiting" /></Grid>
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Latency and packet loss" /><TextBlock Name="LatencyPhaseStatus" Classes="muted" Grid.Column="1" Text="Waiting" /></Grid>
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Download sample" /><TextBlock Name="DownloadPhaseStatus" Classes="muted" Grid.Column="1" Text="Waiting" /></Grid>
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Upload sample" /><TextBlock Name="UploadPhaseStatus" Classes="muted" Grid.Column="1" Text="Waiting" /></Grid>
                </StackPanel>
              </StackPanel>
            </Border>

            <Button Classes="secondary" HorizontalAlignment="Left" Content="Stop test" Click="StopClicked" />
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer Name="ResultsView" IsVisible="False" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="32,28" MaxWidth="900" HorizontalAlignment="Center" Spacing="18">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="5">
                <TextBlock Classes="eyebrow" Text="CONNECTION CHECK" />
                <TextBlock FontSize="14" Classes="muted" Text="Completed prototype result" />
              </StackPanel>
              <Button Grid.Column="1" Classes="secondary" Content="New test" Click="RunAgainClicked" />
            </Grid>

            <Border Classes="surface">
              <StackPanel Spacing="10">
                <TextBlock Name="VerdictLabelText" Classes="eyebrow" />
                <TextBlock Name="VerdictText" FontSize="30" FontWeight="SemiBold" LineHeight="36" TextWrapping="Wrap" />
                <TextBlock Name="VerdictSummaryText" Classes="muted" FontSize="15" LineHeight="22" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,*,*,*">
              <Border Grid.Column="0" Classes="metric" Margin="0,0,6,0">
                <StackPanel Spacing="5"><TextBlock Name="Metric1Label" Classes="eyebrow" /><TextBlock Name="Metric1Value" Classes="metricValue" /><TextBlock Name="Metric1Detail" Classes="muted" TextWrapping="Wrap" /></StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="metric" Margin="6,0">
                <StackPanel Spacing="5"><TextBlock Name="Metric2Label" Classes="eyebrow" /><TextBlock Name="Metric2Value" Classes="metricValue" /><TextBlock Name="Metric2Detail" Classes="muted" TextWrapping="Wrap" /></StackPanel>
              </Border>
              <Border Grid.Column="2" Classes="metric" Margin="6,0">
                <StackPanel Spacing="5"><TextBlock Name="Metric3Label" Classes="eyebrow" /><TextBlock Name="Metric3Value" Classes="metricValue" /><TextBlock Name="Metric3Detail" Classes="muted" TextWrapping="Wrap" /></StackPanel>
              </Border>
              <Border Grid.Column="3" Classes="metric" Margin="6,0,0,0">
                <StackPanel Spacing="5"><TextBlock Name="Metric4Label" Classes="eyebrow" /><TextBlock Name="Metric4Value" Classes="metricValue" /><TextBlock Name="Metric4Detail" Classes="muted" TextWrapping="Wrap" /></StackPanel>
              </Border>
            </Grid>

            <Border Classes="surface">
              <StackPanel Spacing="13">
                <TextBlock Classes="sectionTitle" Text="What this means" />
                <StackPanel Name="FindingsPanel" Spacing="10" />
              </StackPanel>
            </Border>

            <Border Classes="subtle">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="5">
                  <TextBlock Classes="eyebrow" Text="RECOMMENDED NEXT STEP" />
                  <TextBlock Name="NextActionText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
                <Button Name="ChooseQuickButton" Grid.Column="1" Classes="secondary" Margin="18,0,0,0" VerticalAlignment="Center" Content="Choose Quick" Click="ChooseQuickClicked" />
              </Grid>
            </Border>

            <Expander Header="Technical evidence">
              <Border Classes="surface" Margin="0,8,0,0">
                <StackPanel Name="TechnicalEvidencePanel" Spacing="8" />
              </Border>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <ScrollViewer Name="HistoryArea" IsVisible="False" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28" MaxWidth="860" HorizontalAlignment="Center" Spacing="20">
          <StackPanel Spacing="7">
            <TextBlock Classes="eyebrow" Text="HISTORY" />
            <TextBlock Classes="display" Text="Saved reports" />
            <TextBlock Classes="muted" FontSize="15" Text="Completed diagnostics will appear here without competing with the active test." />
          </StackPanel>
          <Border Classes="surface">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="5">
                <TextBlock Name="HistoryFixtureTitle" FontSize="18" FontWeight="SemiBold" Text="Prototype result" />
                <TextBlock Name="HistoryFixtureDetail" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
              <TextBlock Grid.Column="1" Classes="muted" VerticalAlignment="Center" Text="Preview only" />
            </Grid>
          </Border>
          <Border Classes="subtle">
            <TextBlock Classes="muted" Text="Prototype previews do not write report files. Real history and report details will be connected after the screen states are approved." TextWrapping="Wrap" />
          </Border>
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer Name="SettingsArea" IsVisible="False" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28" MaxWidth="760" HorizontalAlignment="Center" Spacing="20">
          <StackPanel Spacing="7">
            <TextBlock Classes="eyebrow" Text="SETTINGS" />
            <TextBlock Classes="display" Text="Defaults and privacy" />
          </StackPanel>

          <Border Classes="surface">
            <StackPanel Spacing="16">
              <TextBlock Classes="sectionTitle" Text="Report privacy" />
              <CheckBox Content="Include local addresses and Wi-Fi network name in saved reports" />
              <TextBlock Classes="muted" Text="Off by default. Public reports should normally leave local identifiers excluded." TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Classes="surface">
            <StackPanel Spacing="16">
              <StackPanel Spacing="4">
                <TextBlock Classes="sectionTitle" Text="Prototype result states" />
                <TextBlock Classes="muted" Text="Temporary controls for reviewing every Connection Check outcome before the real engine is connected." TextWrapping="Wrap" />
              </StackPanel>
              <ComboBox Name="FixtureSelector">
                <ComboBoxItem Content="Healthy" />
                <ComboBoxItem Content="Problematic" />
                <ComboBoxItem Content="Inconclusive" />
                <ComboBoxItem Content="Unavailable measurement" />
                <ComboBoxItem Content="Failed with partial evidence" />
              </ComboBox>
              <Button Classes="primary" Content="Preview selected result" Click="PreviewFixtureClicked" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
