{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://network.johnnyli.dev/contracts/report-v2.schema.json",
  "title": "Network Diagnostics Suite report",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "run"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "run": {
      "type": "object",
      "required": ["id", "platform", "profile", "transferMethod", "startedAt", "completedAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "architecture": { "type": ["string", "null"] },
        "profile": { "enum": ["quick", "standard", "extended"] },
        "transferMethod": { "enum": ["compare", "single", "aggregate"] },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "includesLocalAddresses": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "transferPlan": {
      "type": "object",
      "properties": {
        "estimatedSeconds": { "type": "integer", "minimum": 0 },
        "transferCapBytes": { "type": "integer", "minimum": 0 },
        "downloadStages": { "$ref": "#/$defs/stages" },
        "uploadStages": { "$ref": "#/$defs/stages" }
      },
      "additionalProperties": true
    },
    "internetTransfer": { "type": ["object", "null"], "additionalProperties": true },
    "deepDiagnostics": { "type": ["object", "null"], "additionalProperties": true },
    "localLink": { "type": ["object", "null"], "additionalProperties": true },
    "measurement": {
      "type": ["object", "null"],
      "required": ["contractVersion", "engine", "engineVersion", "capabilities", "selectedEndpoint", "endpointCandidates"],
      "properties": {
        "contractVersion": { "type": "string", "minLength": 1 },
        "engine": { "type": "string", "minLength": 1 },
        "engineVersion": { "type": "string", "minLength": 1 },
        "capabilities": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "selectedEndpoint": { "$ref": "#/$defs/selectedEndpoint" },
        "endpointCandidates": { "type": "array", "items": { "$ref": "#/$defs/endpointProbe" }, "minItems": 1 }
      },
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    }
  },
  "$defs": {
    "selectedEndpoint": {
      "type": "object",
      "required": ["id", "name", "provider", "origin", "selectionReason"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "origin": { "type": "string", "format": "uri" },
        "selectionReason": { "type": "string", "minLength": 1 },
        "preflightLatencyMs": { "type": ["number", "null"], "minimum": 0 }
      },
      "additionalProperties": true
    },
    "endpointProbe": {
      "type": "object",
      "required": ["id", "name", "provider", "origin", "available"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "origin": { "type": "string", "format": "uri" },
        "available": { "type": "boolean" },
        "medianLatencyMs": { "type": ["number", "null"], "minimum": 0 },
        "error": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": ["metric", "label", "value"],
      "properties": {
        "metric": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "detail": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "finding": {
      "type": "object",
      "required": ["id", "category", "severity", "confidence", "title", "summary", "evidence", "recommendations"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["info", "warning", "critical"] },
        "confidence": { "enum": ["low", "medium", "high"] },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "recommendations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "nextTest": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "stage": {
      "type": "object",
      "required": ["id", "strategy", "direction", "connections", "durationMs", "capBytes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "strategy": { "enum": ["single", "aggregate"] },
        "direction": { "enum": ["download", "upload"] },
        "connections": { "type": "integer", "minimum": 1 },
        "durationMs": { "type": "integer", "minimum": 0 },
        "capBytes": { "type": "integer", "minimum": 0 },
        "samples": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "stages": {
      "type": "array",
      "items": { "$ref": "#/$defs/stage" }
    }
  },
  "additionalProperties": true
}
